  {%- when 'antiquegold' -%}#c7a94b
  {%- when 'goldenyellow' -%}#ffdf00
  {%- when 'canaryyellow' -%}#ffef00
  {%- when 'oxblood' -%}#4a0404
  {%- when 'terracotta' -%}#e2725b
  {%- else -%}{{ _key }}
{%- endcase -%}
{%- else -%}
  {%- comment -%} Tier 3: family-word fallback so an unrecognized compound name (e.g. "Deep Wine Red", "Light Steel Blue") still gets a representative swatch instead of being hidden {%- endcomment -%}
  {%- assign _family = '' -%}
  {%- if _key contains 'pista' -%}{%- assign _family = '#93c572' -%}
  {%- elsif _key contains 'skin' -%}{%- assign _family = '#e8beac' -%}
  {%- elsif _key contains 'wood' -%}{%- assign _family = '#855e42' -%}
  {%- elsif _key contains 'liril' -%}{%- assign _family = '#8fbc8f' -%}
  {%- elsif _key contains 'brinjal' -%}{%- assign _family = '#5b2333' -%}
  {%- elsif _key contains 'aubergine' -%}{%- assign _family = '#5b2333' -%}
