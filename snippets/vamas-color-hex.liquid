  {%- elsif _key contains 'onion' -%}{%- assign _family = '#f7c8c8' -%}
  {%- elsif _key contains 'dusty' -%}{%- assign _family = '#c08081' -%}
  {%- elsif _key contains 'baby' -%}{%- assign _family = '#f4c2c2' -%}
  {%- elsif _key contains 'hot' -%}{%- assign _family = '#ff69b4' -%}
  {%- elsif _key contains 'blush' -%}{%- assign _family = '#de5d83' -%}
  {%- elsif _key contains 'champagne' -%}{%- assign _family = '#f7e7ce' -%}
  {%- elsif _key contains 'copper' -%}{%- assign _family = '#b87333' -%}
  {%- elsif _key contains 'bronze' -%}{%- assign _family = '#cd7f32' -%}
  {%- elsif _key contains 'charcoal' -%}{%- assign _family = '#36454f' -%}
  {%- elsif _key contains 'mint' -%}{%- assign _family = '#98ff98' -%}
