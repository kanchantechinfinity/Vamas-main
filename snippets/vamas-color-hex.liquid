  {%- elsif _key contains 'steel' -%}{%- assign _family = '#71797e' -%}
  {%- elsif _key contains 'rust' -%}{%- assign _family = '#b7410e' -%}
  {%- elsif _key contains 'gold' -%}{%- assign _family = '#d4af37' -%}
  {%- elsif _key contains 'silver' -%}{%- assign _family = '#c0c0c0' -%}
  {%- elsif _key contains 'pink' -%}{%- assign _family = '#ffc0cb' -%}
  {%- elsif _key contains 'blue' -%}{%- assign _family = '#4169e1' -%}
  {%- elsif _key contains 'green' -%}{%- assign _family = '#2e8b57' -%}
  {%- elsif _key contains 'red' -%}{%- assign _family = '#c41e3a' -%}
