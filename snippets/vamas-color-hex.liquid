  {%- when 'dustyrose' -%}#c08081
  {%- when 'tealblue' -%}#367588
  {%- when 'brinjal', 'aubergine', 'eggplant' -%}#5b2333
  {%- when 'cobalt', 'cobaltblue' -%}#0047ab
  {%- when 'burgundy' -%}#800020
  {%- when 'lilac' -%}#c8a2c8
  {%- when 'mauve' -%}#b784a7
  {%- when 'tangerine' -%}#f28500
  {%- when 'apricot' -%}#fbceb1
  {%- when 'turmeric' -%}#e3a018
  {%- when 'saffron' -%}#f4c430
  {%- when 'jade' -%}#00a86b
  {%- when 'emeraldgreen' -%}#50c878
  {%- when 'pistagreen', 'pistachio', 'pistachiogreen', 'pista' -%}#93c572
  {%- when 'skin' -%}#e8beac
  {%- when 'wood' -%}#855e42
  {%- when 'liril' -%}#8fbc8f
  {%- when 'seafoam', 'seafoamgreen' -%}#93e9be
