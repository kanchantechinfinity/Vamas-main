{% comment %}
  Fixed bottom navigation bar, mobile only.
  Five slots with the search action raised in the middle.
{% endcomment %}
{% assign new_arrivals_url = '/collections/all' %}
{% if collections['jackets'] != blank and collections['jackets'].products_count > 0 %}
  {% assign new_arrivals_url = collections['jackets'].url %}
{% endif %}

<nav class="vamas-botnav" aria-label="Primary mobile navigation">
  <a class="vamas-botnav__item" href="{{ routes.account_url | default: '/account/login' }}">
    <span class="vamas-botnav__icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
    </span>
    <span class="vamas-botnav__label">{% if customer %}Account{% else %}Login{% endif %}</span>
  </a>

  <a class="vamas-botnav__item" href="{{ routes.collections_url | default: '/collections' }}">
    <span class="vamas-botnav__icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
    </span>
    <span class="vamas-botnav__label">Categories</span>
  </a>

  <button class="vamas-botnav__item vamas-botnav__item--center" type="button" id="vamas-botnav-search" aria-label="Search">
    <span class="vamas-botnav__fab">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><line x1="16.5" y1="16.5" x2="21" y2="21"/></svg>
    </span>
    <span class="vamas-botnav__label">Search</span>
  </button>

  <a class="vamas-botnav__item" href="{{ new_arrivals_url }}">
    <span class="vamas-botnav__icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 2l2.4 6.4H21l-5.2 4 1.9 6.6L12 15.4 6.3 19l1.9-6.6L3 8.4h6.6z"/></svg>
      <span class="vamas-botnav__tag">NEW</span>
    </span>
    <span class="vamas-botnav__label">New Arrivals</span>
  </a>

  <a class="vamas-botnav__item" href="{{ routes.cart_url | default: '/cart' }}">
    <span class="vamas-botnav__icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="9" cy="20" r="1.6"/><circle cx="18" cy="20" r="1.6"/><path d="M2 3h3l2.6 12.2h11.2L21 7H6"/></svg>
      <span class="vamas-botnav__count" data-botnav-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
    </span>
    <span class="vamas-botnav__label">Cart</span>
  </a>
</nav>

<script>
  (function () {
    var btn = document.getElementById('vamas-botnav-search');
    if (!btn) return;
    btn.addEventListener('click', function () {
      /* Reuse the header's existing search overlay rather than adding a second one */
      var overlay = document.getElementById('vamas-search-overlay');
      if (overlay) {
        overlay.classList.add('open');
        var input = overlay.querySelector('input[type="search"], input[name="q"]');
        if (input) setTimeout(function () { input.focus(); }, 60);
      } else {
        window.location.href = '{{ routes.search_url | default: "/search" }}';
      }
    });
  })();
</script>
