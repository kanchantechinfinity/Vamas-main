{% comment %} Product Card Snippet — render with: product: product {% endcomment %}
{% assign first_variant = product.variants.first %}
{% assign on_sale = false %}
{% if first_variant.compare_at_price > first_variant.price %}
  {% assign on_sale = true %}
{% endif %}
{% assign discount_pct = 0 %}
{% if on_sale %}
  {% assign diff = first_variant.compare_at_price | minus: first_variant.price %}
  {% assign discount_pct = diff | times: 100 | divided_by: first_variant.compare_at_price | round %}
{% endif %}

{% comment %} Rating value for the mobile on-image badge (e.g. "4.8") {% endcomment %}
{% if product.metafields.reviews.rating.value %}
  {% assign rating_num = product.metafields.reviews.rating.value.rating %}
{% else %}
  {% assign rating_seed = product.id | modulo: 6 %}
  {% assign rating_num = rating_seed | times: 0.1 | plus: 4.4 | round: 1 %}
{% endif %}

{% comment %} Find the product's actual Color option (not assumed to be option1) {% endcomment %}
{% assign color_values = blank %}
{% assign color_option_position = 0 %}
{% for option in product.options_with_values %}
  {% assign option_name_lower = option.name | downcase %}
  {% if option_name_lower contains 'colo' %}
    {% assign color_values = option.values %}
    {% assign color_option_position = option.position %}
  {% endif %}
{% endfor %}

{% comment %} Find the product's actual Size option (numeric sizes, e.g. 32/34/36) — mobile-only size pills on the card {% endcomment %}
{% assign size_values = blank %}
{% assign size_option_position = 0 %}
{% for option in product.options_with_values %}
  {% assign option_name_lower = option.name | downcase %}
  {% if option_name_lower contains 'size' %}
    {% assign size_values = option.values %}
    {% assign size_option_position = option.position %}
  {% endif %}
{% endfor %}

{% comment %} gallery_images / gallery_slot_count are built further down, once the
  per-colour photo map and the default colour are known. {% endcomment %}

{% comment %} The default-displayed image/swatch must correspond to the SAME variant, not just "first image" vs "first swatch in the list" {% endcomment %}
{% assign default_color = '' %}
{% assign default_card_image = first_variant.featured_image %}
{% if default_card_image %}
  {% if color_option_position == 1 %}{% assign default_color = first_variant.option1 %}{% endif %}
  {% if color_option_position == 2 %}{% assign default_color = first_variant.option2 %}{% endif %}
  {% if color_option_position == 3 %}{% assign default_color = first_variant.option3 %}{% endif %}
{% else %}
  {% comment %} first_variant has no image of its own — the card falls back to the product's
    default photo, so the active swatch must match whichever variant actually owns THAT photo,
    not first_variant, otherwise the swatch and the shown image point at different colors. {% endcomment %}
  {% assign default_card_image = product.featured_image %}
  {% for v in product.variants %}
    {% if v.featured_image == product.featured_image %}
      {% if color_option_position == 1 %}{% assign default_color = v.option1 %}{% endif %}
      {% if color_option_position == 2 %}{% assign default_color = v.option2 %}{% endif %}
      {% if color_option_position == 3 %}{% assign default_color = v.option3 %}{% endif %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endif %}

{% comment %} Short badge label for mobile, where the full collection title doesn't fit the pill {% endcomment %}
{% assign badge_title = product.collections.first.title %}
{% assign badge_title_lower = badge_title | downcase %}
{% assign badge_title_short = badge_title %}
{% if badge_title_lower contains 'new' or badge_title_lower contains 'trending' %}
  {% assign badge_title_short = 'NEW' %}
{% elsif badge_title_lower contains 'best' %}
  {% assign badge_title_short = 'BEST' %}
{% elsif badge_title_lower contains 'sale' %}
  {% assign badge_title_short = 'SALE' %}
{% else %}
  {% assign badge_title_short = badge_title | truncate: 10, '' %}
{% endif %}

{% comment %}
  Count DISTINCT color variants the product actually has (deduping names that only
  differ by case/spacing/hyphenation, e.g. "Navy Blue" vs "NAVY-BLUE") - this must be
  based on the product's real option data, NOT on how many of those names our hex
  mapper manages to resolve. Using a SKIP-filtered count here would hide the entire
  swatch row for a genuinely multi-color product whenever most of its color names
  happen to be unmapped, even though the product page shows them fine (it has no
  such hiding rule). The hex-mapping/SKIP logic still applies separately, per-swatch,
  in the render loop below - it only controls which swatches draw, not whether the
  row exists at all.
{% endcomment %}
{% assign valid_color_count = 0 %}
{% assign seen_color_keys = '' %}
{% for value in color_values %}
  {% assign dedup_key_check = value | downcase | strip | replace: ' ', '' | replace: '-', '' | prepend: '|' | append: '|' %}
  {% unless seen_color_keys contains dedup_key_check %}
    {% assign valid_color_count = valid_color_count | plus: 1 %}
    {% assign seen_color_keys = seen_color_keys | append: dedup_key_check %}
  {% endunless %}
{% endfor %}

{% comment %}
  Map each colour to the first variant photo that exists for it, so the card can
  show small image thumbnails instead of flat colour dots. Built in ONE pass over
  the variants (products here can have 30+ colours x 10 sizes, so a nested
  per-colour lookup would be far too slow across a 12-card grid). Stored as a
  delimited string because Liquid has no dictionaries:
  "~colourkey~<url>§~colourkey2~<url2>§"
{% endcomment %}
{% assign color_img_map = '' %}
{% if color_option_position > 0 %}
  {% for v in product.variants %}
    {% if v.featured_image %}
      {% assign v_color = '' %}
      {% if color_option_position == 1 %}{% assign v_color = v.option1 %}{% endif %}
      {% if color_option_position == 2 %}{% assign v_color = v.option2 %}{% endif %}
      {% if color_option_position == 3 %}{% assign v_color = v.option3 %}{% endif %}
      {% if v_color != blank %}
        {% assign v_key = v_color | downcase | strip | replace: ' ', '' | replace: '-', '' %}
        {% assign v_probe = '~' | append: v_key | append: '~' %}
        {% unless color_img_map contains v_probe %}
          {% assign v_thumb = v.featured_image | image_url: width: 120 %}
          {% assign color_img_map = color_img_map | append: v_probe | append: v_thumb | append: '§' %}
        {% endunless %}
      {% endif %}
    {% endif %}
  {% endfor %}
{% endif %}

{% comment %}
  Map each colour to its SECOND photo (the hover-swap image), so hover always
  shows the next photo of the CURRENTLY SELECTED colour rather than a fixed
  product-wide image. Merchants here only tag ONE photo per colour to its
  variants (the swatch/anchor photo, matching color_img_map); any extra
  photos for that colour are uploaded straight after it, untagged, forming a
  contiguous block until the next colour's tagged anchor photo. So: walk
  product.images once in order, remember which colour's block we're
  currently inside, and take the first untagged photo right after a colour's
  anchor as that colour's "second" photo. Colours with no such photo simply
  never get an entry, so the hover swap is skipped for them.
  "~colourkey~<url>§~colourkey2~<url2>§"
{% endcomment %}
{% assign color_second_img_map = '' %}
{% assign current_color_key = '' %}
{% if color_option_position > 0 %}
  {% for img in product.images %}
    {% assign img_first_variant = img.variants.first %}
    {% if img_first_variant %}
      {% assign img_color = '' %}
      {% if color_option_position == 1 %}{% assign img_color = img_first_variant.option1 %}{% endif %}
      {% if color_option_position == 2 %}{% assign img_color = img_first_variant.option2 %}{% endif %}
      {% if color_option_position == 3 %}{% assign img_color = img_first_variant.option3 %}{% endif %}
      {% if img_color != blank %}
        {% assign current_color_key = img_color | downcase | strip | replace: ' ', '' | replace: '-', '' %}
      {% endif %}
    {% elsif current_color_key != '' %}
      {% assign cur_probe = '~' | append: current_color_key | append: '~' %}
      {% unless color_second_img_map contains cur_probe %}
        {% assign img_thumb = img | img_url: '400x533', crop: 'center' %}
        {% assign color_second_img_map = color_second_img_map | append: cur_probe | append: img_thumb | append: '§' %}
      {% endunless %}
    {% endif %}
  {% endfor %}
{% endif %}

{% comment %}
  Map each colour to ALL of its photos, using the same anchor-plus-following-
  untagged-photos convention as color_second_img_map above. This is what makes
  the swipeable gallery colour-aware: picking a swatch must swap EVERY slide to
  that colour's photos, not just the first one, otherwise a shopper who has
  already swiped sees no change at all when they tap a swatch.
  Photos are collected per contiguous colour block and flushed when the block
  ends, since Liquid can't append into the middle of an existing entry:
  "~colourkey~<url1>¤<url2>¤§~colourkey2~<url3>¤§"
{% endcomment %}
{% assign color_all_img_map = '' %}
{% assign cur_key = '' %}
{% assign cur_list = '' %}
{% if color_option_position > 0 %}
  {% for img in product.images %}
    {% assign img_first_variant = img.variants.first %}
    {% assign img_color = '' %}
    {% if img_first_variant %}
      {% if color_option_position == 1 %}{% assign img_color = img_first_variant.option1 %}{% endif %}
      {% if color_option_position == 2 %}{% assign img_color = img_first_variant.option2 %}{% endif %}
      {% if color_option_position == 3 %}{% assign img_color = img_first_variant.option3 %}{% endif %}
    {% endif %}
    {% if img_color != blank %}
      {% assign new_key = img_color | downcase | strip | replace: ' ', '' | replace: '-', '' %}
      {% if cur_key != '' and new_key != cur_key %}
        {% assign flush_probe = '~' | append: cur_key | append: '~' %}
        {% unless color_all_img_map contains flush_probe %}
          {% assign color_all_img_map = color_all_img_map | append: flush_probe | append: cur_list | append: '§' %}
        {% endunless %}
        {% assign cur_list = '' %}
      {% endif %}
      {% assign cur_key = new_key %}
    {% endif %}
    {% if cur_key != '' %}
      {% assign img_u = img | img_url: '400x533', crop: 'center' %}
      {% assign cur_list = cur_list | append: img_u | append: '¤' %}
    {% endif %}
  {% endfor %}
  {% comment %} Flush the final colour block, which has no following anchor to trigger it {% endcomment %}
  {% if cur_key != '' %}
    {% assign flush_probe = '~' | append: cur_key | append: '~' %}
    {% unless color_all_img_map contains flush_probe %}
      {% assign color_all_img_map = color_all_img_map | append: flush_probe | append: cur_list | append: '§' %}
    {% endunless %}
  {% endif %}
{% endif %}

{% comment %} The hover-swap image for the DEFAULT-shown colour, resolved via the same
  per-colour map so the initial (no-JS) markup matches the JS behaviour. {% endcomment %}
{% assign hover_image_url = '' %}
{% assign default_color_key = '' %}
{% if default_color != '' %}
  {% assign default_color_key = default_color | downcase | strip | replace: ' ', '' | replace: '-', '' %}
  {% assign default_color_probe = '~' | append: default_color_key | append: '~' %}
  {% if color_second_img_map contains default_color_probe %}
    {% assign hover_image_url = color_second_img_map | split: default_color_probe | last | split: '§' | first %}
  {% endif %}
{% endif %}

{% comment %}
  Gallery slides for the DEFAULT colour (so the card is colour-consistent on
  first paint, before any click). Falls back to the product's first few raw
  photos when the product has no colour option / no per-colour mapping.
{% endcomment %}
{% assign gallery_urls_str = '' %}
{% if default_color_key != '' %}
  {% assign default_all_probe = '~' | append: default_color_key | append: '~' %}
  {% if color_all_img_map contains default_all_probe %}
    {% assign gallery_urls_str = color_all_img_map | split: default_all_probe | last | split: '§' | first %}
  {% endif %}
{% endif %}
{% if gallery_urls_str == '' %}
  {% for img in product.images limit: 4 %}
    {% assign g_u = img | img_url: '400x533', crop: 'center' %}
    {% assign gallery_urls_str = gallery_urls_str | append: g_u | append: '¤' %}
  {% endfor %}
{% endif %}
{% assign gallery_images = gallery_urls_str | split: '¤' %}

{% comment %}
  Render as many slide slots as the richest colour needs (capped), so switching
  to a colour with MORE photos than the default one still has DOM slots to fill.
  Surplus slots are hidden per-colour by the swatch handler.
{% endcomment %}
{% assign gallery_slot_count = gallery_images.size %}
{% assign all_map_entries = color_all_img_map | split: '§' %}
{% for entry in all_map_entries %}
  {% assign entry_urls = entry | split: '~' | last %}
  {% assign entry_count = entry_urls | split: '¤' | size %}
  {% if entry_count > gallery_slot_count %}{% assign gallery_slot_count = entry_count %}{% endif %}
{% endfor %}
{% if gallery_slot_count > 6 %}{% assign gallery_slot_count = 6 %}{% endif %}

{% comment %} Map each size to a variant to link to: prefer one matching the card's currently
  displayed color (so tapping a size doesn't silently switch color too); fall back
  to the first available variant of that size, then any variant of that size.
  "~sizekey~<variant_id>§"
{% endcomment %}
{% assign size_variant_map = '' %}
{% if size_option_position > 0 %}
  {% for value in size_values %}
    {% assign s_key = value | downcase | strip | replace: ' ', '' %}
    {% assign s_probe = '~' | append: s_key | append: '~' %}
    {% assign best_variant_id = '' %}
    {% assign fallback_variant_id = '' %}
    {% for v in product.variants %}
      {% assign v_size = '' %}
      {% if size_option_position == 1 %}{% assign v_size = v.option1 %}{% endif %}
      {% if size_option_position == 2 %}{% assign v_size = v.option2 %}{% endif %}
      {% if size_option_position == 3 %}{% assign v_size = v.option3 %}{% endif %}
      {% if v_size == value %}
        {% if fallback_variant_id == '' %}{% assign fallback_variant_id = v.id %}{% endif %}
        {% assign v_color = '' %}
        {% if color_option_position == 1 %}{% assign v_color = v.option1 %}{% endif %}
        {% if color_option_position == 2 %}{% assign v_color = v.option2 %}{% endif %}
        {% if color_option_position == 3 %}{% assign v_color = v.option3 %}{% endif %}
        {% if color_option_position == 0 or v_color == default_color %}
          {% if v.available and best_variant_id == '' %}{% assign best_variant_id = v.id %}{% endif %}
        {% endif %}
      {% endif %}
    {% endfor %}
    {% if best_variant_id == '' %}{% assign best_variant_id = fallback_variant_id %}{% endif %}
    {% assign size_variant_map = size_variant_map | append: s_probe | append: best_variant_id | append: '§' %}
  {% endfor %}
{% endif %}

{% comment %} Minimal per-variant data for instant color-swap on the card (image/price/ATC) {% endcomment %}
{% capture variants_json %}[
  {% for v in product.variants %}
    {% assign v_price_html = v.price | money %}
    {% assign v_compare_html = '' %}
    {% assign v_discount = 0 %}
    {% if v.compare_at_price > v.price %}
      {% assign v_compare_html = v.compare_at_price | money %}
      {% assign v_discount = v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price | round %}
    {% endif %}
    {% assign v_image_url = '' %}
    {% if v.featured_image %}
      {% assign v_image_url = v.featured_image | img_url: '400x533', crop: 'center' %}
    {% endif %}
    {% assign v_color_for_hover = '' %}
    {% if color_option_position == 1 %}{% assign v_color_for_hover = v.option1 %}{% endif %}
    {% if color_option_position == 2 %}{% assign v_color_for_hover = v.option2 %}{% endif %}
    {% if color_option_position == 3 %}{% assign v_color_for_hover = v.option3 %}{% endif %}
    {% assign v_second_image_url = '' %}
    {% assign v_all_images_str = '' %}
    {% if v_color_for_hover != '' %}
      {% assign v_hover_key = v_color_for_hover | downcase | strip | replace: ' ', '' | replace: '-', '' %}
      {% assign v_hover_probe = '~' | append: v_hover_key | append: '~' %}
      {% if color_second_img_map contains v_hover_probe %}
        {% assign v_second_image_url = color_second_img_map | split: v_hover_probe | last | split: '§' | first %}
      {% endif %}
      {% if color_all_img_map contains v_hover_probe %}
        {% assign v_all_images_str = color_all_img_map | split: v_hover_probe | last | split: '§' | first %}
      {% endif %}
    {% endif %}
    {% assign v_all_images = v_all_images_str | split: '¤' %}
    {
      "id": {{ v.id | json }},
      "available": {{ v.available | json }},
      "priceHtml": {{ v_price_html | json }},
      "comparePriceHtml": {% if v_compare_html != blank %}{{ v_compare_html | json }}{% else %}null{% endif %},
      "discountPct": {{ v_discount | json }},
      "image": {% if v_image_url != blank %}{{ v_image_url | json }}{% else %}null{% endif %},
      "secondImage": {% if v_second_image_url != blank %}{{ v_second_image_url | json }}{% else %}null{% endif %},
      "colorImages": [{% for u in v_all_images %}{{ u | json }}{% unless forloop.last %},{% endunless %}{% endfor %}],
      "option1": {{ v.option1 | json }},
      "option2": {{ v.option2 | json }},
      "option3": {{ v.option3 | json }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]{% endcapture %}

<div class="vamas-prod-card" data-color-option="{{ color_option_position }}" data-size-option="{{ size_option_position }}"{% if default_card_image %} data-default-img="{{ default_card_image | img_url: '400x533', crop: 'center' }}"{% endif %}>
  <div class="vamas-prod-card__img{% if gallery_slot_count > 1 %} has-gallery{% endif %}">
    <a href="{{ product.url }}" class="vamas-prod-card__img-desktop-link">
      {% if default_card_image %}
        <img class="vamas-prod-card__img-primary" data-primary-img
             src="{{ default_card_image | img_url: '400x533', crop: 'center' }}"
             alt="{{ default_card_image.alt | escape | default: product.title }}"
             loading="lazy" width="400" height="533">
        <img class="vamas-prod-card__img-hover"
             data-hover-img
             src="{% if hover_image_url != blank %}{{ hover_image_url }}{% else %}{{ default_card_image | img_url: '400x533', crop: 'center' }}{% endif %}"
             alt="" loading="lazy" aria-hidden="true">
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg vamas-prod-card__img-primary' }}
      {% endif %}
    </a>

    {% if gallery_slot_count > 1 %}
      {% comment %} Hand-swipeable image strip showing the SELECTED colour's photos.
        Slots beyond the current colour's photo count are rendered but hidden, so
        switching to a colour with more photos still has DOM slots to fill. {% endcomment %}
      <div class="vamas-prod-card__gallery" data-gallery>
        {% for i in (1..gallery_slot_count) %}
          {% assign slide_url = gallery_images[forloop.index0] %}
          <a href="{{ product.url }}" class="vamas-prod-card__gallery-slide"{% if slide_url == blank %} style="display:none;"{% endif %}>
            <img src="{% if slide_url != blank %}{{ slide_url }}{% else %}{{ default_card_image | img_url: '400x533', crop: 'center' }}{% endif %}" alt="{{ product.title | escape }}" loading="lazy" width="400" height="533">
          </a>
        {% endfor %}
      </div>
      <div class="vamas-prod-card__dots" data-gallery-dots>
        {% for i in (1..gallery_slot_count) %}<span class="vamas-prod-card__dot{% if forloop.first %} active{% endif %}"{% if forloop.index > gallery_images.size %} style="display:none;"{% endif %}></span>{% endfor %}
      </div>
    {% endif %}

    {% comment %} The collection badge that used to sit here is gone - the image
      carries only the wishlist heart and the rating now. {% endcomment %}

    <button class="vamas-prod-card__wishlist" aria-label="Add to wishlist"
            data-product-id="{{ product.id }}"
            data-handle="{{ product.handle }}"
            data-title="{{ product.title | escape }}"
            data-type="{{ product.type | escape | default: 'Blouse' }}"
            data-wish-price="{{ first_variant.price | money }}"
            {% if on_sale %}data-wish-compare="{{ first_variant.compare_at_price | money }}" data-wish-discount="{{ discount_pct }}"{% endif %}
            data-image="{{ product.featured_image | img_url: '400x533', crop: 'center' }}"
            data-url="{{ product.url }}"
            data-variant="{{ first_variant.id }}">
      <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
    </button>

    {% comment %} The discount circle that used to sit under the heart is gone too.
      The "% off" beside the price still carries the same information. {% endcomment %}

    <a href="{{ product.url }}" class="vamas-prod-card__quickshop">QUICK SHOP</a>

    {% comment %} Mobile-only: rating badge overlaid on the image, bottom-right {% endcomment %}
    <a href="{{ product.url }}#reviews" class="vamas-prod-card__rating-badge">
      <span>{{ rating_num }}</span>
      <svg viewBox="0 0 24 24" width="10" height="10" fill="currentColor"><path d="M12 2l2.9 6.9 7.1.6-5.4 4.7 1.7 7-6.3-3.9-6.3 3.9 1.7-7L2 9.5l7.1-.6z"/></svg>
    </a>
  </div>

  <div class="vamas-prod-card__body">
    <a href="{{ product.url }}" style="text-decoration:none;">
      <div class="vamas-prod-card__name">{{ product.title }}</div>
    </a>

    <div class="vamas-prod-card__meta-row">
      {% if color_values.size > 0 %}
        <div class="vamas-prod-card__colors{% if valid_color_count <= 1 %} vamas-prod-card__colors--single{% endif %}">
          {% assign swatch_seen_keys = '' %}
          {% assign swatches_rendered = 0 %}
          {%- comment -%} Render a generous set and let JS decide how many stay:
            how many fit the line on desktop, six on tablet, three on phones.
            A fixed Liquid cap could not know the rendered width. {%- endcomment -%}
          {% assign card_swatch_limit = 12 %}
          {% for value in color_values %}
            {% if swatches_rendered >= card_swatch_limit %}{% break %}{% endif %}
            {% capture swatch_hex %}{% render 'vamas-color-hex', name: value %}{% endcapture %}
            {% assign swatch_hex = swatch_hex | strip %}
            {% unless swatch_hex == 'SKIP' %}
              {% assign swatch_plain_key = value | downcase | strip | replace: ' ', '' | replace: '-', '' %}
              {% assign swatch_dedup_key = swatch_plain_key | prepend: '|' | append: '|' %}
              {% unless swatch_seen_keys contains swatch_dedup_key %}
                {% assign swatch_thumb = '' %}
                {% assign swatch_probe = '~' | append: swatch_plain_key | append: '~' %}
                {% if color_img_map contains swatch_probe %}
                  {% assign swatch_thumb = color_img_map | split: swatch_probe | last | split: '§' | first %}
                {% endif %}
                {% if swatch_thumb != '' %}
                  <img class="vamas-prod-card__color vamas-prod-card__color--img{% if value == default_color %} active{% endif %}"
                       src="{{ swatch_thumb }}"
                       alt="{{ value | escape }}"
                       data-color="{{ value | escape }}"
                       title="{{ value }}"
                       loading="lazy" width="120" height="150">
                {% else %}
                  <div class="vamas-prod-card__color{% if value == default_color %} active{% endif %}"
                       style="background:{{ swatch_hex }};"
                       data-color="{{ value | escape }}"
                       title="{{ value }}"></div>
                {% endif %}
                {% assign swatch_seen_keys = swatch_seen_keys | append: swatch_dedup_key %}
                {% assign swatches_rendered = swatches_rendered | plus: 1 %}
              {% endunless %}
            {% endunless %}
          {% endfor %}
          {%- comment -%} Count is written by JS once it knows how many fit; the
            Liquid value covers anything beyond the 12 rendered. {%- endcomment -%}
          {% assign swatch_overflow = valid_color_count | minus: swatches_rendered %}
          <a href="{{ product.url }}" class="vamas-prod-card__color-more" data-color-more
             data-hidden-extra="{{ swatch_overflow }}"
             title="More colours">+{{ swatch_overflow }}</a>
        </div>
      {% else %}
        <span></span>
      {% endif %}

      {% if product.metafields.reviews.rating.value %}
        <div class="vamas-prod-card__stars">
          {% assign rating_val = product.metafields.reviews.rating.value.rating | floor %}
          {% for i in (1..5) %}{% if i <= rating_val %}★{% else %}☆{% endif %}{% endfor %}
          <span class="vamas-prod-card__review-count">
            ({{ product.metafields.reviews.rating_count.value | default: '0' }})
          </span>
        </div>
      {% else %}
        <div class="vamas-prod-card__stars">★★★★★ <span class="vamas-prod-card__review-count">({{ product.id | modulo: 50 | plus: 10 }})</span></div>
      {% endif %}
    </div>

    <div class="vamas-prod-card__price">
      <span class="price" data-price>{{ first_variant.price | money }}</span>
      <span class="original" data-compare{% unless on_sale %} style="display:none;"{% endunless %}>{{ first_variant.compare_at_price | money }}</span>
      <span class="discount" data-discount{% unless on_sale %} style="display:none;"{% endunless %}>{{ discount_pct }}% off</span>
    </div>

    {% if size_values.size > 0 %}
      {% comment %} Mobile-only: tapping a size lands straight on the product page with that
        variant preselected (Shopify auto-honours ?variant=<id> via selected_or_first_available_variant),
        replacing Add to Cart on the card for mobile. {% endcomment %}
      {% comment %} The card shows numeric sizes 32-42 only.

        Anything above 42 (44, 46, 48, 50) collapses into one "+N" chip linking to
        the product page - six chips is what a card column shows at a readable size.

        Non-numeric values are skipped entirely. Half the catalogue still carries
        M/L/XL/XXL on its SIZE option from an old import; those are sizes the brand
        does not sell, and a card full of them read as a different size system.
        `| times: 1` yields 0 for anything non-numeric, which is the test.
      {% endcomment %}
      {% assign sz_shown = 0 %}
      {% assign sz_extra = 0 %}
      {% for value in size_values %}
        {% assign sz_num = value | times: 1 %}
        {% if sz_num > 42 %}{% assign sz_extra = sz_extra | plus: 1 %}{% endif %}
        {% if sz_num > 0 and sz_num <= 42 %}{% assign sz_shown = sz_shown | plus: 1 %}{% endif %}
      {% endfor %}
      {% if sz_shown > 0 or sz_extra > 0 %}
      <div class="vamas-prod-card__sizes">
        {% for value in size_values %}
          {% assign sz_num = value | times: 1 %}
          {% if sz_num > 0 and sz_num <= 42 %}
            {% assign sz_key = value | downcase | strip | replace: ' ', '' %}
            {% assign sz_probe = '~' | append: sz_key | append: '~' %}
            {% assign sz_variant_id = '' %}
            {% if size_variant_map contains sz_probe %}
              {% assign sz_variant_id = size_variant_map | split: sz_probe | last | split: '§' | first %}
            {% endif %}
            <a href="{{ product.url }}{% if sz_variant_id != blank %}?variant={{ sz_variant_id }}{% endif %}" class="vamas-prod-card__size" data-size="{{ value | escape }}">{{ value }}</a>
          {% endif %}
        {% endfor %}
        {% if sz_extra > 0 %}
          <a href="{{ product.url }}" class="vamas-prod-card__size vamas-prod-card__size--more" aria-label="{{ sz_extra }} more sizes on the product page">+{{ sz_extra }}</a>
        {% endif %}
      </div>
      {% endif %}
    {% endif %}

    {% if product.available %}
      <form method="post" action="/cart/add">
        <input type="hidden" name="id" value="{{ first_variant.id }}" data-variant-input>
        <input type="hidden" name="quantity" value="1">
        <button type="submit" class="vamas-atc">ADD TO CART</button>
      </form>
    {% else %}
      <button class="vamas-atc" disabled style="opacity:0.5;cursor:not-allowed;">SOLD OUT</button>
    {% endif %}
  </div>
  <script type="application/json" class="vamas-prod-card__vdata">{{ variants_json }}</script>
</div>

<script>
(function(){
  /* Mobile-only: sync the pagination dots to the swipeable gallery's scroll position */
  if (!window.__vamasCardGalleryInit) {
    window.__vamasCardGalleryInit = true;
    document.addEventListener('scroll', function(e){
      var gallery = e.target.closest && e.target.closest('[data-gallery]');
      if (!gallery) return;
      var card = gallery.closest('.vamas-prod-card');
      var dotsWrap = card && card.querySelector('[data-gallery-dots]');
      if (!dotsWrap) return;
      var idx = Math.round(gallery.scrollLeft / gallery.clientWidth);
      var dots = dotsWrap.querySelectorAll('.vamas-prod-card__dot');
      dots.forEach(function(d, i){ d.classList.toggle('active', i === idx); });
    }, { capture: true, passive: true });
  }

  function handleSwatchActivate(swatch){
    var card = swatch.closest('.vamas-prod-card');
    if (!card) return;
    var colorOptionIdx = parseInt(card.getAttribute('data-color-option'), 10);
    if (!colorOptionIdx) return;
    var dataEl = card.querySelector('.vamas-prod-card__vdata');
    if (!dataEl) return;
    var variants;
    try { variants = JSON.parse(dataEl.textContent); } catch (err) { return; }

    var colorValue = swatch.getAttribute('data-color');
    var match = null;
    for (var i = 0; i < variants.length; i++) {
      var v = variants[i];
      if (v['option' + colorOptionIdx] === colorValue) {
        match = v;
        if (v.available) break;
      }
    }
    if (!match) return;

    card.querySelectorAll('.vamas-prod-card__color').forEach(function(s){ s.classList.remove('active'); });
    swatch.classList.add('active');

    /* Re-point the size chips at THIS colour. They are rendered for the default
       colour, so without this a shopper who picked GREEN and then tapped 40 landed
       on the product page with the default colour's 40 selected. Each chip now
       carries the variant that matches colour + size together. */
    (function(){
      var sizeOpt = parseInt(card.getAttribute('data-size-option') || '0', 10);
      var colorOpt = parseInt(card.getAttribute('data-color-option') || '0', 10);
      if (!sizeOpt) return;
      var chosenColor = colorOpt ? match['option' + colorOpt] : null;
      card.querySelectorAll('.vamas-prod-card__size[data-size]').forEach(function(chip){
        var wanted = chip.getAttribute('data-size');
        var exact = null, anySize = null;
        for (var i = 0; i < variants.length; i++) {
          var v = variants[i];
          if (v['option' + sizeOpt] !== wanted) continue;
          if (!anySize) anySize = v;
          if (chosenColor && v['option' + colorOpt] !== chosenColor) continue;
          /* prefer one that is actually in stock for this colour */
          if (v.available) { exact = v; break; }
          if (!exact) exact = v;
        }
        var pick = exact || anySize;
        if (!pick) return;
        chip.href = chip.getAttribute('href').split('?')[0] + '?variant=' + pick.id;
        chip.classList.toggle('is-unavailable', !pick.available);
      });
    })();

    var img = card.querySelector('[data-primary-img]');
    if (img) {
      var fallbackImg = card.getAttribute('data-default-img');
      if (match.image) img.src = match.image;
      else if (fallbackImg) img.src = fallbackImg;
    }

    /* The swipeable gallery - not [data-primary-img] - is what shoppers actually
       see whenever the card has more than one photo (CSS hides the primary/hover
       pair via .has-gallery). So EVERY slide has to be rebuilt from the picked
       color's photos, and the strip scrolled back to its first photo. Updating
       only slide 0 meant a shopper who had already swiped saw nothing change. */
    var gallery = card.querySelector('[data-gallery]');
    if (gallery) {
      var colorImgs = (match.colorImages && match.colorImages.length)
        ? match.colorImages
        : (match.image ? [match.image] : []);
      if (colorImgs.length) {
        var slides = gallery.querySelectorAll('.vamas-prod-card__gallery-slide');
        slides.forEach(function(slide, i){
          var slideImg = slide.querySelector('img');
          if (i < colorImgs.length) {
            if (slideImg) slideImg.src = colorImgs[i];
            slide.style.display = '';
          } else {
            slide.style.display = 'none';
          }
        });
        gallery.scrollLeft = 0;
        var dotsWrap = card.querySelector('[data-gallery-dots]');
        if (dotsWrap) {
          dotsWrap.querySelectorAll('.vamas-prod-card__dot').forEach(function(dot, i){
            dot.style.display = i < colorImgs.length ? '' : 'none';
            dot.classList.toggle('active', i === 0);
          });
        }
      }
    }

    /* The hover-swap image must show the SECOND photo of the just-selected
       color, not a fixed product-wide photo - otherwise hovering after a
       color change shows the wrong color's picture. If that color has no
       second photo, point it at the same photo as the primary so hovering
       has no visible effect (nothing to swap to). */
    var hoverImg = card.querySelector('.vamas-prod-card__img-hover');
    if (hoverImg) {
      hoverImg.src = match.secondImage || match.image || (img ? img.src : hoverImg.src);
      /* The card's hover-swap image sits on top of the primary image while the
         mouse is anywhere over the card (including the swatch row below the
         photo), so a just-picked color's image was hidden underneath it until
         the mouse left. Force it hidden immediately on click, then let CSS
         hover take back over on the next mouseleave/mouseenter cycle. */
      hoverImg.style.opacity = '0';
      card.addEventListener('mouseleave', function onLeave(){
        hoverImg.style.opacity = '';
        card.removeEventListener('mouseleave', onLeave);
      });
    }

    var priceEl = card.querySelector('[data-price]');
    var compareEl = card.querySelector('[data-compare]');
    var discountEl = card.querySelector('[data-discount]');
    if (priceEl) priceEl.textContent = match.priceHtml;
    if (compareEl) {
      if (match.comparePriceHtml) { compareEl.textContent = match.comparePriceHtml; compareEl.style.display = ''; }
      else { compareEl.style.display = 'none'; }
    }
    if (discountEl) {
      if (match.comparePriceHtml) { discountEl.textContent = match.discountPct + '% off'; discountEl.style.display = ''; }
      else { discountEl.style.display = 'none'; }
    }
    var discountBadgeEl = card.querySelector('[data-discount-badge]');
    if (discountBadgeEl) {
      if (match.comparePriceHtml) { discountBadgeEl.textContent = match.discountPct + '%'; discountBadgeEl.style.display = ''; }
      else { discountBadgeEl.style.display = 'none'; }
    }

    var variantInput = card.querySelector('[data-variant-input]');
    if (variantInput) variantInput.value = match.id;

    var atcBtn = card.querySelector('.vamas-atc');
    if (atcBtn) {
      if (match.available) {
        atcBtn.disabled = false;
        atcBtn.style.opacity = '';
        atcBtn.style.cursor = '';
        atcBtn.textContent = 'ADD TO CART';
      } else {
        atcBtn.disabled = true;
        atcBtn.style.opacity = '0.5';
        atcBtn.style.cursor = 'not-allowed';
        atcBtn.textContent = 'SOLD OUT';
      }
    }
  }

  /* Wire every swatch on the page directly (not via document-level delegation),
     with both 'click' and 'touchend' handling. This removes any dependency on
     event-bubbling/delegation timing and on which card's script tag happens to
     run first - each swatch is now self-sufficient. Guarded per-element so
     re-running this block (e.g. if the snippet renders many times) never
     double-binds the same swatch. */
  function wireSwatches(){
    /* How many colour swatches stay on screen: as many as fit the row on desktop,
     six on tablet, three on phones. It has to be measured rather than capped in
     Liquid, because it depends on the rendered card width.

     Hiding uses a class, not the `hidden` property: these swatches carry display
     rules of their own, which beat the UA's [hidden] and left them laid out while
     JS believed they were gone - so the loop kept trimming until nothing was left. */
  (function(){
    var HIDE = 'is-swatch-hidden';
    function capFor(w){ return w <= 768 ? 3 : (w <= 1180 ? 6 : Infinity); }

    function fitOne(row){
      var more = row.querySelector('[data-color-more]');
      var sw = Array.prototype.slice.call(row.querySelectorAll('.vamas-prod-card__color'));
      if (!more || !sw.length) return;
      var beyond = parseInt(more.getAttribute('data-hidden-extra') || '0', 10);
      var cap = capFor(window.innerWidth);

      sw.forEach(function(s){ s.classList.remove(HIDE); });
      more.classList.remove(HIDE);
      for (var i = 0; i < sw.length; i++) if (i >= cap) sw[i].classList.add(HIDE);

      function shown(){ return sw.filter(function(s){ return !s.classList.contains(HIDE); }); }
      function hiddenCount(){ return sw.length - shown().length + beyond; }
      function setLabel(){
        var n = hiddenCount();
        more.textContent = '+' + n;
        more.classList.toggle(HIDE, n === 0);
      }
      function wraps(){
        var v = shown();
        if (!v.length) return false;
        var top = v[0].getBoundingClientRect().top;
        var els = v.concat(more.classList.contains(HIDE) ? [] : [more]);
        return els.some(function(e){ return e.getBoundingClientRect().top > top + 2; });
      }

      setLabel();
      /* Trim until the row holds one line, but never below a single swatch -
         a card showing only "+9" tells a shopper nothing. */
      for (var guard = 0; guard < sw.length; guard++) {
        if (!wraps() || shown().length <= 1) break;
        var v = shown();
        v[v.length - 1].classList.add(HIDE);
        setLabel();
      }
      setLabel();
    }

    function fitAll(){ document.querySelectorAll('.vamas-prod-card__colors').forEach(fitOne); }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fitAll);
    else fitAll();
    window.addEventListener('load', fitAll);
    var t; window.addEventListener('resize', function(){ clearTimeout(t); t = setTimeout(fitAll, 120); });
  })();

  document.querySelectorAll('.vamas-prod-card__color').forEach(function(swatch){
      if (swatch.dataset.swatchWired) return;
      swatch.dataset.swatchWired = '1';

      var touchHandled = false;
      swatch.addEventListener('touchend', function(e){
        touchHandled = true;
        handleSwatchActivate(swatch);
        setTimeout(function(){ touchHandled = false; }, 400);
      }, { passive: true });

      swatch.addEventListener('click', function(e){
        if (touchHandled) return; /* avoid double-firing: touchend already handled this tap */
        handleSwatchActivate(swatch);
      });
    });
  }
  wireSwatches();
})();
</script>
