{% comment %} Product Card Snippet — render with: product: product {% endcomment %}
{% assign first_variant = product.variants.first %}
{% assign on_sale = false %}
{% if first_variant.compare_at_price > first_variant.price %}
  {% assign on_sale = true %}
{% endif %}
{% assign discount_pct = 0 %}
{% if on_sale %}
  {% assign diff = first_variant.compare_at_price | minus: first_variant.price %}
  {% assign discount_pct = diff | times: 100 | divided_by: first_variant.compare_at_price | round %}
{% endif %}

{% comment %} Second/third image for the hover swap {% endcomment %}
{% assign hover_image = product.images[1] %}
{% if hover_image == blank %}{% assign hover_image = product.images[2] %}{% endif %}

{% comment %} Find the product's actual Color option (not assumed to be option1) {% endcomment %}
{% assign color_values = blank %}
{% assign color_option_position = 0 %}
{% for option in product.options_with_values %}
  {% assign option_name_lower = option.name | downcase %}
  {% if option_name_lower contains 'colo' %}
    {% assign color_values = option.values %}
    {% assign color_option_position = option.position %}
  {% endif %}
{% endfor %}

{% comment %} The default-displayed image/swatch must correspond to the SAME variant, not just "first image" vs "first swatch in the list" {% endcomment %}
{% assign default_color = '' %}
{% assign default_card_image = first_variant.featured_image %}
{% if default_card_image %}
  {% if color_option_position == 1 %}{% assign default_color = first_variant.option1 %}{% endif %}
  {% if color_option_position == 2 %}{% assign default_color = first_variant.option2 %}{% endif %}
  {% if color_option_position == 3 %}{% assign default_color = first_variant.option3 %}{% endif %}
{% else %}
  {% comment %} first_variant has no image of its own — the card falls back to the product's
    default photo, so the active swatch must match whichever variant actually owns THAT photo,
    not first_variant, otherwise the swatch and the shown image point at different colors. {% endcomment %}
  {% assign default_card_image = product.featured_image %}
  {% for v in product.variants %}
    {% if v.featured_image == product.featured_image %}
      {% if color_option_position == 1 %}{% assign default_color = v.option1 %}{% endif %}
      {% if color_option_position == 2 %}{% assign default_color = v.option2 %}{% endif %}
      {% if color_option_position == 3 %}{% assign default_color = v.option3 %}{% endif %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endif %}

{% comment %} Short badge label for mobile, where the full collection title doesn't fit the pill {% endcomment %}
{% assign badge_title = product.collections.first.title %}
{% assign badge_title_lower = badge_title | downcase %}
{% assign badge_title_short = badge_title %}
{% if badge_title_lower contains 'new' or badge_title_lower contains 'trending' %}
  {% assign badge_title_short = 'NEW' %}
{% elsif badge_title_lower contains 'best' %}
  {% assign badge_title_short = 'BEST' %}
{% elsif badge_title_lower contains 'sale' %}
  {% assign badge_title_short = 'SALE' %}
{% else %}
  {% assign badge_title_short = badge_title | truncate: 10, '' %}
{% endif %}

{% comment %}
  Count DISTINCT color variants the product actually has (deduping names that only
  differ by case/spacing/hyphenation, e.g. "Navy Blue" vs "NAVY-BLUE") - this must be
  based on the product's real option data, NOT on how many of those names our hex
  mapper manages to resolve. Using a SKIP-filtered count here would hide the entire
  swatch row for a genuinely multi-color product whenever most of its color names
  happen to be unmapped, even though the product page shows them fine (it has no
  such hiding rule). The hex-mapping/SKIP logic still applies separately, per-swatch,
  in the render loop below - it only controls which swatches draw, not whether the
  row exists at all.
{% endcomment %}
{% assign valid_color_count = 0 %}
{% assign seen_color_keys = '' %}
{% for value in color_values %}
  {% assign dedup_key_check = value | downcase | strip | replace: ' ', '' | replace: '-', '' | prepend: '|' | append: '|' %}
  {% unless seen_color_keys contains dedup_key_check %}
    {% assign valid_color_count = valid_color_count | plus: 1 %}
    {% assign seen_color_keys = seen_color_keys | append: dedup_key_check %}
  {% endunless %}
{% endfor %}

{% comment %}
  Map each colour to the first variant photo that exists for it, so the card can
  show small image thumbnails instead of flat colour dots. Built in ONE pass over
  the variants (products here can have 30+ colours x 10 sizes, so a nested
  per-colour lookup would be far too slow across a 12-card grid). Stored as a
  delimited string because Liquid has no dictionaries:
  "~colourkey~<url>§~colourkey2~<url2>§"
{% endcomment %}
{% assign color_img_map = '' %}
{% if color_option_position > 0 %}
  {% for v in product.variants %}
    {% if v.featured_image %}
      {% assign v_color = '' %}
      {% if color_option_position == 1 %}{% assign v_color = v.option1 %}{% endif %}
      {% if color_option_position == 2 %}{% assign v_color = v.option2 %}{% endif %}
      {% if color_option_position == 3 %}{% assign v_color = v.option3 %}{% endif %}
      {% if v_color != blank %}
        {% assign v_key = v_color | downcase | strip | replace: ' ', '' | replace: '-', '' %}
        {% assign v_probe = '~' | append: v_key | append: '~' %}
        {% unless color_img_map contains v_probe %}
          {% assign v_thumb = v.featured_image | image_url: width: 120 %}
          {% assign color_img_map = color_img_map | append: v_probe | append: v_thumb | append: '§' %}
        {% endunless %}
      {% endif %}
    {% endif %}
  {% endfor %}
{% endif %}

{% comment %} Minimal per-variant data for instant color-swap on the card (image/price/ATC) {% endcomment %}
{% capture variants_json %}[
  {% for v in product.variants %}
    {% assign v_price_html = v.price | money %}
    {% assign v_compare_html = '' %}
    {% assign v_discount = 0 %}
    {% if v.compare_at_price > v.price %}
      {% assign v_compare_html = v.compare_at_price | money %}
      {% assign v_discount = v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price | round %}
    {% endif %}
    {% assign v_image_url = '' %}
    {% if v.featured_image %}
      {% assign v_image_url = v.featured_image | img_url: '400x533', crop: 'center' %}
    {% endif %}
    {
      "id": {{ v.id | json }},
      "available": {{ v.available | json }},
      "priceHtml": {{ v_price_html | json }},
      "comparePriceHtml": {% if v_compare_html != blank %}{{ v_compare_html | json }}{% else %}null{% endif %},
      "discountPct": {{ v_discount | json }},
      "image": {% if v_image_url != blank %}{{ v_image_url | json }}{% else %}null{% endif %},
      "option1": {{ v.option1 | json }},
      "option2": {{ v.option2 | json }},
      "option3": {{ v.option3 | json }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]{% endcapture %}

<div class="vamas-prod-card" data-color-option="{{ color_option_position }}"{% if default_card_image %} data-default-img="{{ default_card_image | img_url: '400x533', crop: 'center' }}"{% endif %}>
  <div class="vamas-prod-card__img">
    <a href="{{ product.url }}">
      {% if default_card_image %}
        <img class="vamas-prod-card__img-primary" data-primary-img
             src="{{ default_card_image | img_url: '400x533', crop: 'center' }}"
             alt="{{ default_card_image.alt | escape | default: product.title }}"
             loading="lazy" width="400" height="533">
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg vamas-prod-card__img-primary' }}
      {% endif %}
      {% if hover_image != blank %}
        <img class="vamas-prod-card__img-hover"
             src="{{ hover_image | img_url: '400x533', crop: 'center' }}"
             alt="" loading="lazy" aria-hidden="true">
      {% endif %}
    </a>

    {% if badge_title != blank %}
      <span class="vamas-prod-card__badge vamas-prod-card__badge--maroon">{{ badge_title_short | upcase }}</span>
    {% endif %}

    <button class="vamas-prod-card__wishlist" aria-label="Add to wishlist"
            data-product-id="{{ product.id }}"
            data-handle="{{ product.handle }}"
            data-title="{{ product.title | escape }}"
            data-type="{{ product.type | escape | default: 'Blouse' }}"
            data-price="{{ first_variant.price | money }}"
            {% if on_sale %}data-compare="{{ first_variant.compare_at_price | money }}" data-discount="{{ discount_pct }}"{% endif %}
            data-image="{{ product.featured_image | img_url: '400x533', crop: 'center' }}"
            data-url="{{ product.url }}"
            data-variant="{{ first_variant.id }}">
      <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
    </button>

    <a href="{{ product.url }}" class="vamas-prod-card__quickshop">QUICK SHOP</a>
  </div>

  <div class="vamas-prod-card__body">
    <a href="{{ product.url }}" style="text-decoration:none;">
      <div class="vamas-prod-card__name">{{ product.title }}</div>
    </a>
    <div class="vamas-prod-card__type">{{ product.type | default: 'Blouse' }}</div>

    <div class="vamas-prod-card__meta-row">
      {% if color_values.size > 0 %}
        <div class="vamas-prod-card__colors{% if valid_color_count <= 1 %} vamas-prod-card__colors--single{% endif %}">
          {% assign swatch_seen_keys = '' %}
          {% assign swatches_rendered = 0 %}
          {% assign card_swatch_limit = 5 %}
          {% for value in color_values %}
            {% if swatches_rendered >= card_swatch_limit %}{% break %}{% endif %}
            {% capture swatch_hex %}{% render 'vamas-color-hex', name: value %}{% endcapture %}
            {% assign swatch_hex = swatch_hex | strip %}
            {% unless swatch_hex == 'SKIP' %}
              {% assign swatch_plain_key = value | downcase | strip | replace: ' ', '' | replace: '-', '' %}
              {% assign swatch_dedup_key = swatch_plain_key | prepend: '|' | append: '|' %}
              {% unless swatch_seen_keys contains swatch_dedup_key %}
                {% assign swatch_thumb = '' %}
                {% assign swatch_probe = '~' | append: swatch_plain_key | append: '~' %}
                {% if color_img_map contains swatch_probe %}
                  {% assign swatch_thumb = color_img_map | split: swatch_probe | last | split: '§' | first %}
                {% endif %}
                {% if swatch_thumb != '' %}
                  <img class="vamas-prod-card__color vamas-prod-card__color--img{% if value == default_color %} active{% endif %}"
                       src="{{ swatch_thumb }}"
                       alt="{{ value | escape }}"
                       data-color="{{ value | escape }}"
                       title="{{ value }}"
                       loading="lazy" width="120" height="150">
                {% else %}
                  <div class="vamas-prod-card__color{% if value == default_color %} active{% endif %}"
                       style="background:{{ swatch_hex }};"
                       data-color="{{ value | escape }}"
                       title="{{ value }}"></div>
                {% endif %}
                {% assign swatch_seen_keys = swatch_seen_keys | append: swatch_dedup_key %}
                {% assign swatches_rendered = swatches_rendered | plus: 1 %}
              {% endunless %}
            {% endunless %}
          {% endfor %}
          {% if valid_color_count > card_swatch_limit %}
            <a href="{{ product.url }}" class="vamas-prod-card__color-more" title="{{ valid_color_count | minus: card_swatch_limit }} more colors">+{{ valid_color_count | minus: card_swatch_limit }}</a>
          {% endif %}
        </div>
      {% else %}
        <span></span>
      {% endif %}

      {% if product.metafields.reviews.rating.value %}
        <div class="vamas-prod-card__stars">
          {% assign rating_val = product.metafields.reviews.rating.value.rating | floor %}
          {% for i in (1..5) %}{% if i <= rating_val %}★{% else %}☆{% endif %}{% endfor %}
          <span class="vamas-prod-card__review-count">
            ({{ product.metafields.reviews.rating_count.value | default: '0' }})
          </span>
        </div>
      {% else %}
        <div class="vamas-prod-card__stars">★★★★★ <span class="vamas-prod-card__review-count">({{ product.id | modulo: 50 | plus: 10 }})</span></div>
      {% endif %}
    </div>

    <div class="vamas-prod-card__price">
      <span class="price" data-price>{{ first_variant.price | money }}</span>
      <span class="original" data-compare{% unless on_sale %} style="display:none;"{% endunless %}>{{ first_variant.compare_at_price | money }}</span>
      <span class="discount" data-discount{% unless on_sale %} style="display:none;"{% endunless %}>{{ discount_pct }}% off</span>
    </div>

    {% if product.available %}
      <form method="post" action="/cart/add">
        <input type="hidden" name="id" value="{{ first_variant.id }}" data-variant-input>
        <input type="hidden" name="quantity" value="1">
        <button type="submit" class="vamas-atc">ADD TO CART</button>
      </form>
    {% else %}
      <button class="vamas-atc" disabled style="opacity:0.5;cursor:not-allowed;">SOLD OUT</button>
    {% endif %}
  </div>
  <script type="application/json" class="vamas-prod-card__vdata">{{ variants_json }}</script>
</div>

<script>
(function(){
  if (window.__vamasCardSwatchInit) return;
  window.__vamasCardSwatchInit = true;
  document.addEventListener('click', function(e){
    var swatch = e.target.closest('.vamas-prod-card__color');
    if (!swatch) return;
    var card = swatch.closest('.vamas-prod-card');
    if (!card) return;
    var colorOptionIdx = parseInt(card.getAttribute('data-color-option'), 10);
    if (!colorOptionIdx) return;
    var dataEl = card.querySelector('.vamas-prod-card__vdata');
    if (!dataEl) return;
    var variants;
    try { variants = JSON.parse(dataEl.textContent); } catch (err) { return; }

    var colorValue = swatch.getAttribute('data-color');
    var match = null;
    for (var i = 0; i < variants.length; i++) {
      var v = variants[i];
      if (v['option' + colorOptionIdx] === colorValue) {
        match = v;
        if (v.available) break;
      }
    }
    if (!match) return;

    card.querySelectorAll('.vamas-prod-card__color').forEach(function(s){ s.classList.remove('active'); });
    swatch.classList.add('active');

    var img = card.querySelector('[data-primary-img]');
    if (img) {
      var fallbackImg = card.getAttribute('data-default-img');
      if (match.image) img.src = match.image;
      else if (fallbackImg) img.src = fallbackImg;
    }

    /* The card's hover-swap image sits on top of the primary image while the
       mouse is anywhere over the card (including the swatch row below the
       photo), so a just-picked color's image was hidden underneath it until
       the mouse left. Force it hidden immediately on click, then let CSS
       hover take back over on the next mouseleave/mouseenter cycle. */
    var hoverImg = card.querySelector('.vamas-prod-card__img-hover');
    if (hoverImg) {
      hoverImg.style.opacity = '0';
      card.addEventListener('mouseleave', function onLeave(){
        hoverImg.style.opacity = '';
        card.removeEventListener('mouseleave', onLeave);
      });
    }

    var priceEl = card.querySelector('[data-price]');
    var compareEl = card.querySelector('[data-compare]');
    var discountEl = card.querySelector('[data-discount]');
    if (priceEl) priceEl.textContent = match.priceHtml;
    if (compareEl) {
      if (match.comparePriceHtml) { compareEl.textContent = match.comparePriceHtml; compareEl.style.display = ''; }
      else { compareEl.style.display = 'none'; }
    }
    if (discountEl) {
      if (match.comparePriceHtml) { discountEl.textContent = match.discountPct + '% off'; discountEl.style.display = ''; }
      else { discountEl.style.display = 'none'; }
    }

    var variantInput = card.querySelector('[data-variant-input]');
    if (variantInput) variantInput.value = match.id;

    var atcBtn = card.querySelector('.vamas-atc');
    if (atcBtn) {
      if (match.available) {
        atcBtn.disabled = false;
        atcBtn.style.opacity = '';
        atcBtn.style.cursor = '';
        atcBtn.textContent = 'ADD TO CART';
      } else {
        atcBtn.disabled = true;
        atcBtn.style.opacity = '0.5';
        atcBtn.style.cursor = 'not-allowed';
        atcBtn.textContent = 'SOLD OUT';
      }
    }
  });
})();
</script>
