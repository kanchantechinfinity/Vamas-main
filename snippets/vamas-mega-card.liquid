{% comment %}
  Renders one mega-menu card link, with a hover flyout for its nested sub-links if any.
  Usage: {% render 'vamas-mega-card', item: some_link, img: 'filename.jpg' | asset_url %}
{% endcomment %}
<div class="vamas-nav__card-item-wrap{% if item.links != blank %} vamas-nav__card-item-wrap--has-kids{% endif %}">
  <a href="{{ item.url }}" class="vamas-nav__card-item">
    <span class="vamas-nav__card-thumb"><img src="{{ img }}" width="44" height="44" alt="" loading="lazy"></span>
    <span class="vamas-nav__card-label">{{ item.title }}</span>
    {% if item.links != blank %}<span class="vamas-nav__card-arrow">›</span>{% endif %}
  </a>
  {% if item.links != blank %}
    <div class="vamas-nav__card-flyout">
      {% for sub in item.links %}
        <a href="{{ sub.url }}">{{ sub.title }}</a>
      {% endfor %}
    </div>
  {% endif %}
</div>
