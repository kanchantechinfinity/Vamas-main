{{ 'vamas-theme.css' | asset_url | stylesheet_tag }}

{% comment %} ── Hero Slider ──────────────────────── {% endcomment %}
<div class="vamas-slider" id="vamas-slider">
  <div class="vamas-slider__track" id="vamas-track">

    {% for block in section.blocks %}
      {% if block.type == 'slide' %}
        {% assign has_mobile_bg = false %}
        {% if block.settings.mobile_slide_image != blank or block.settings.mobile_image_asset != blank %}{% assign has_mobile_bg = true %}{% endif %}
        {%- comment -%} Per-slide crop focus. A single global object-position can't
          suit two different photos - one needs the model's face kept in frame, the
          other needs her lower body cropped away - so each slide carries its own,
          separately for desktop and mobile since the crop shape differs. {%- endcomment -%}
        {%- assign focus_y = block.settings.image_focus_y | default: 8 -%}
        {%- assign m_focus_y = block.settings.mobile_image_focus_y | default: 8 -%}
        <div class="vamas-slide vamas-slide--{{ block.settings.text_align | default: 'left' }}{% if has_mobile_bg %} vamas-slide--has-mobile-bg{% endif %}" style="background: {{ block.settings.slide_bg | default: '#420001' }};">
          {% if block.settings.video != blank %}
            <video class="vamas-slide__bg vamas-slide__bg--desktop" autoplay muted loop playsinline preload="metadata"{% if block.settings.slide_image != blank %} poster="{{ block.settings.slide_image | img_url: '1800x760', crop: 'center' }}"{% endif %}>
              {% for source in block.settings.video.sources %}<source src="{{ source.url }}" type="{{ source.mime_type }}">{% endfor %}
            </video>
          {% elsif block.settings.video_url != blank %}
            <div class="vamas-slide__bg vamas-slide__bg--desktop vamas-video-embed">
              {% if block.settings.video_url.type == 'youtube' %}
                <iframe src="https://www.youtube.com/embed/{{ block.settings.video_url.id }}?autoplay=1&mute=1&loop=1&playlist={{ block.settings.video_url.id }}&controls=0&showinfo=0&modestbranding=1&rel=0&playsinline=1" title="{{ block.settings.line1 | escape }}" allow="autoplay; encrypted-media" frameborder="0"></iframe>
              {% elsif block.settings.video_url.type == 'vimeo' %}
                <iframe src="https://player.vimeo.com/video/{{ block.settings.video_url.id }}?autoplay=1&muted=1&loop=1&background=1" title="{{ block.settings.line1 | escape }}" allow="autoplay" frameborder="0"></iframe>
              {% endif %}
            </div>
          {% elsif block.settings.slide_image != blank %}
            <img class="vamas-slide__bg vamas-slide__bg--desktop" src="{{ block.settings.slide_image | img_url: '1800x760', crop: 'center' }}"
                 style="object-position: center {{ focus_y }}%;"
                 alt="{{ block.settings.slide_image.alt | escape | default: block.settings.line1 }}"
                 loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
          {% elsif block.settings.image_asset != blank %}
            <img class="vamas-slide__bg vamas-slide__bg--desktop" src="{{ block.settings.image_asset | asset_url }}"
                 style="object-position: center {{ focus_y }}%;"
                 alt="{{ block.settings.line1 | escape }}"
                 loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
          {% endif %}
          {% if block.settings.mobile_slide_image != blank %}
            <img class="vamas-slide__bg vamas-slide__bg--mobile" src="{{ block.settings.mobile_slide_image | img_url: '900x1200', crop: 'center' }}"
                 style="object-position: center {{ m_focus_y }}%;"
                 alt="{{ block.settings.mobile_slide_image.alt | escape | default: block.settings.line1 }}"
                 loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
          {% elsif block.settings.mobile_image_asset != blank %}
            <img class="vamas-slide__bg vamas-slide__bg--mobile" src="{{ block.settings.mobile_image_asset | asset_url }}"
                 style="object-position: center {{ m_focus_y }}%;"
                 alt="{{ block.settings.line1 | escape }}"
                 loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
          {% endif %}
          <div class="vamas-slide__scrim"></div>
          <div class="vamas-slide__inner">
            <div class="vamas-slide__text">
              {% if block.settings.eyebrow != blank %}<p class="vamas-slide__eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}
              <h1 class="vamas-slide__heading">
                {{ block.settings.line1 }}{% if block.settings.line2_accent != blank %} <em>{{ block.settings.line2_accent }}</em>{% endif %}<br class="vamas-slide__heading-break">{% if block.settings.line3 != blank %} {{ block.settings.line3 }}{% endif %}
              </h1>
              {% if block.settings.offer != blank %}<div class="vamas-slide__offer">{{ block.settings.offer }}</div>{% endif %}
              {% if block.settings.coupon != blank %}<div class="vamas-slide__coupon">WITH COUPON <span>{{ block.settings.coupon }}</span></div>{% endif %}
              {% if block.settings.subtext != blank %}<p class="vamas-slide__sub">{{ block.settings.subtext }}</p>{% endif %}
              <div class="vamas-slide__btns">
                {% if block.settings.btn1_text != blank %}<a href="{{ block.settings.btn1_url | default: '/collections/all' }}" class="btn-primary">{{ block.settings.btn1_text }}</a>{% endif %}
                {% if block.settings.btn2_text != blank %}<a href="{{ block.settings.btn2_url | default: '/collections/all' }}" class="btn-outline">{{ block.settings.btn2_text }}</a>{% endif %}
              </div>
            </div>
          </div>
        </div>
      {% endif %}
    {% endfor %}

  </div>

  {% assign slide_count = 0 %}
  {% for block in section.blocks %}{% if block.type == 'slide' %}{% assign slide_count = slide_count | plus: 1 %}{% endif %}{% endfor %}

  {% if slide_count > 1 %}
    <button class="vamas-slider__arrow vamas-slider__arrow--prev" id="vamas-prev" aria-label="Previous slide">&#8592;</button>
    <button class="vamas-slider__arrow vamas-slider__arrow--next" id="vamas-next" aria-label="Next slide">&#8594;</button>
    <div class="vamas-slider__dots" id="vamas-dots">
      {% assign idx = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'slide' %}
          <button class="vamas-slider__dot {% if idx == 0 %}active{% endif %}"
                  data-idx="{{ idx }}" aria-label="Slide {{ idx | plus: 1 }}"></button>
          {% assign idx = idx | plus: 1 %}
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
</div>

{% comment %}
  Mobile-only: make the hero slider fill the screen down to the bottom nav bar.
  Scoped entirely to <=768px via matchMedia; does nothing on desktop, and the
  underlying CSS min-height (520px) is untouched so desktop is unaffected.
{% endcomment %}
<script>
(function(){
  var slider = document.getElementById('vamas-slider');
  if (!slider) return;
  var mq = window.matchMedia('(max-width: 768px)');

  function fitMobileHero(){
    if (!mq.matches) {
      slider.style.removeProperty('--vamas-hero-mobile-h');
      return;
    }
    var headerEl = document.getElementById('vamas-nav-wrapper');
    var announceEl = document.querySelector('.vamas-announce');
    var botnavEl = document.querySelector('.vamas-botnav');
    var headerH = (headerEl ? headerEl.offsetHeight : 0) + (announceEl ? announceEl.offsetHeight : 0);
    var botnavH = botnavEl ? botnavEl.offsetHeight : 0;
    var vh = window.innerHeight;
    var target = Math.max(320, vh - headerH - botnavH);
    slider.style.setProperty('--vamas-hero-mobile-h', target + 'px');
  }

  fitMobileHero();
  window.addEventListener('resize', fitMobileHero);
  window.addEventListener('orientationchange', fitMobileHero);
  if (mq.addEventListener) { mq.addEventListener('change', fitMobileHero); }

  /* Desktop-only: fill the hero to the bottom of the screen (viewport height
     minus the actual header height). Independent of the mobile logic above -
     uses its own CSS variable, so mobile is completely unaffected. */
  var dmq = window.matchMedia('(min-width: 769px)');
  function fitDesktopHero(){
    if (!dmq.matches) {
      slider.style.removeProperty('--vamas-hero-desktop-h');
      return;
    }
    var headerEl = document.getElementById('vamas-nav-wrapper');
    var announceEl = document.querySelector('.vamas-announce');
    var headerH = (headerEl ? headerEl.offsetHeight : 0) + (announceEl ? announceEl.offsetHeight : 0);
    var target = Math.max(520, window.innerHeight - headerH);
    slider.style.setProperty('--vamas-hero-desktop-h', target + 'px');
  }
  fitDesktopHero();
  window.addEventListener('resize', fitDesktopHero);
  if (dmq.addEventListener) { dmq.addEventListener('change', fitDesktopHero); }
})();
</script>

<script>
(function(){
  var track = document.getElementById('vamas-track');
  var dots  = document.querySelectorAll('#vamas-dots .vamas-slider__dot');
  var cur   = 0;
  var total = dots.length;
  var timer;
  if(!track || total < 2) return;

  function goTo(i){
    cur = (i + total) % total;
    track.style.transform = 'translateX(-' + (cur * 100) + '%)';
    dots.forEach(function(d,j){ d.classList.toggle('active', j === cur); });
  }

  function reset(){ clearInterval(timer); timer = setInterval(function(){ goTo(cur+1); }, 5000); }

  var prev = document.getElementById('vamas-prev');
  var next = document.getElementById('vamas-next');
  if(prev) prev.addEventListener('click', function(){ goTo(cur-1); reset(); });
  if(next) next.addEventListener('click', function(){ goTo(cur+1); reset(); });
  dots.forEach(function(d){ d.addEventListener('click', function(){ goTo(+this.dataset.idx); reset(); }); });

  var startX = 0, startY = 0, dragging = false, swiped = false;
  track.addEventListener('touchstart', function(e){
    startX = e.touches[0].clientX; startY = e.touches[0].clientY;
    dragging = true; swiped = false;
  }, { passive: true });
  track.addEventListener('touchmove', function(e){
    if(!dragging) return;
    var dx = e.touches[0].clientX - startX;
    var dy = e.touches[0].clientY - startY;
    if(Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 40 && !swiped){
      swiped = true;
      if(dx < 0) goTo(cur+1); else goTo(cur-1);
      reset();
    }
  }, { passive: true });
  track.addEventListener('touchend', function(){ dragging = false; });

  reset();
})();
</script>

{% comment %} ── Categories ───────────────────────── {% endcomment %}
{% assign cat_blocks = section.blocks | where: 'type', 'category' %}
{% if cat_blocks.size > 0 and section.settings.show_categories %}
<section class="vamas-section vamas-section--cats">
  <div class="vamas-section__header">
    <div>
      <h2 class="vamas-section__title">Choice <span>For You</span></h2>
      <p class="vamas-section__subtitle">Pick your fit, your style</p>
    </div>
    <a href="{{ section.settings.cat_view_all | default: '/collections/all' }}" class="vamas-view-all vamas-view-all--top">VIEW ALL</a>
  </div>
  <div class="vamas-cat-carousel" data-cat-carousel data-count="{{ cat_blocks.size }}" data-speed="0.6">
    <div class="vamas-cat-circle-row" data-cat-track>
      {% for dup in (1..2) %}
        {% for block in section.blocks %}
          {% if block.type == 'category' %}
            <a href="{{ block.settings.cat_url | default: '/collections/all' }}" class="vamas-cat-circle" draggable="false">
              <div class="vamas-cat-circle__ring">
                {% if block.settings.cat_image != blank %}
                  <img src="{{ block.settings.cat_image | img_url: '300x300', crop: 'top' }}"
                       alt="{{ block.settings.cat_name }}" loading="lazy" width="150" height="150" draggable="false">
                {% elsif block.settings.image_asset != blank %}
                  <img src="{{ block.settings.image_asset | asset_url }}"
                       alt="{{ block.settings.cat_name | escape }}" loading="lazy" width="150" height="150" draggable="false">
                {% else %}
                  {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {% endif %}
              </div>
              <div class="vamas-cat-circle__label">{{ block.settings.cat_name }}</div>
            </a>
          {% endif %}
        {% endfor %}
      {% endfor %}
    </div>
  </div>
  <div class="vamas-cat-dots" data-cat-dots></div>
  <a href="{{ section.settings.cat_view_all | default: '/collections/all' }}" class="vamas-view-all vamas-view-all--bottom">VIEW ALL</a>
</section>
{% endif %}

<script>
(function(){
  window.vamasInitDragCarousel = window.vamasInitDragCarousel || function(root, opts){
    var track = root.querySelector(opts.trackSelector);
    var dotsWrap = root.parentElement.querySelector(opts.dotsSelector) || root.querySelector(opts.dotsSelector);
    if (!track) return;
    var items = Array.prototype.slice.call(track.children);
    var count = parseInt(root.getAttribute('data-count'), 10) || (items.length / 2);
    if (!count || items.length < count * 2) return;

    track.style.willChange = 'transform';

    var gap = parseFloat(getComputedStyle(track).gap) || 0;
    var cachedItemWidth = items[0].getBoundingClientRect().width + gap;
    function refreshItemWidth(){ cachedItemWidth = items[0].getBoundingClientRect().width + gap; }
    function itemWidth(){ return cachedItemWidth; }
    function setWidth(){ return count * itemWidth(); }

    // offset = how far the track has moved left, in px. Purely transform-driven
    // (no scrollLeft mutation) so the browser can composite it on the GPU
    // instead of doing main-thread layout work every frame.
    var offset = 0;
    function applyTransform(){ track.style.transform = 'translate3d(-' + offset + 'px,0,0)'; }
    function normalizeOffset(){
      var w = setWidth();
      offset = ((offset % w) + w) % w;
    }

    var isDown = false, startX = 0, startOffset = 0, dragged = false;
    var autoRAF = null, paused = false, lastTs = null;

    function startAuto(){
      stopAuto();
      var pxPerMs = (opts.speed || 0.6) / 16;
      function step(ts){
        if (!paused && !isDown) {
          if (lastTs !== null) {
            offset += pxPerMs * (ts - lastTs);
            normalizeOffset();
            applyTransform();
            updateDots();
          }
          lastTs = ts;
        } else {
          lastTs = null;
        }
        autoRAF = requestAnimationFrame(step);
      }
      autoRAF = requestAnimationFrame(step);
    }
    function stopAuto(){ if (autoRAF) cancelAnimationFrame(autoRAF); autoRAF = null; }

    track.addEventListener('mouseenter', function(){ paused = true; });
    track.addEventListener('mouseleave', function(){ paused = false; if (isDown) endDrag(); });

    function pointerX(e){ return (e.touches ? e.touches[0].pageX : e.pageX); }
    function startDrag(e){
      isDown = true; dragged = false;
      startX = pointerX(e); startOffset = offset;
      track.classList.add('is-dragging');
    }
    function duringDrag(e){
      if (!isDown) return;
      var dx = pointerX(e) - startX;
      if (Math.abs(dx) > 4) dragged = true;
      offset = startOffset - dx;
      normalizeOffset();
      applyTransform();
      updateDots();
    }
    function endDrag(){
      if (!isDown) return;
      isDown = false;
      track.classList.remove('is-dragging');
    }
    track.addEventListener('mousedown', startDrag);
    window.addEventListener('mousemove', duringDrag);
    window.addEventListener('mouseup', endDrag);
    track.addEventListener('touchstart', function(e){ paused = true; startDrag(e); }, { passive: true });
    track.addEventListener('touchmove', duringDrag, { passive: true });
    track.addEventListener('touchend', function(){ endDrag(); paused = false; });
    track.addEventListener('click', function(e){ if (dragged) { e.preventDefault(); e.stopPropagation(); } }, true);

    var perView = 1;
    function computePerView(){
      perView = Math.max(1, Math.round(root.clientWidth / itemWidth()));
      return perView;
    }
    function pageCount(){ return Math.max(1, Math.ceil(count / computePerView())); }

    function goToPage(idx){
      offset = idx * perView * itemWidth();
      normalizeOffset();
      track.style.transition = 'transform 0.4s ease';
      applyTransform();
      setTimeout(function(){ track.style.transition = ''; }, 420);
    }

    function buildDots(){
      if (!dotsWrap) return;
      dotsWrap.innerHTML = '';
      var pages = pageCount();
      for (var i = 0; i < pages; i++) {
        var dot = document.createElement('button');
        dot.className = 'vamas-cat-dot' + (i === 0 ? ' active' : '');
        dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
        (function(idx){
          dot.addEventListener('click', function(){ goToPage(idx); });
        })(i);
        dotsWrap.appendChild(dot);
      }
    }
    var lastActivePage = -1;
    function updateDots(){
      if (!dotsWrap) return;
      var pages = pageCount();
      var pos = offset % setWidth();
      var page = Math.round(pos / (perView * itemWidth())) % pages;
      if (page === lastActivePage) return;
      lastActivePage = page;
      var dots = dotsWrap.querySelectorAll('.vamas-cat-dot');
      for (var i = 0; i < dots.length; i++) { dots[i].classList.toggle('active', i === page); }
    }

    applyTransform();
    buildDots();
    startAuto();
    window.addEventListener('resize', function(){ refreshItemWidth(); buildDots(); });
  };

  document.querySelectorAll('[data-cat-carousel]').forEach(function(root){
    window.vamasInitDragCarousel(root, {
      trackSelector: '[data-cat-track]',
      dotsSelector: '[data-cat-dots]',
      speed: parseFloat(root.getAttribute('data-speed')) || 0.6
    });
  });
})();
</script>

{% comment %} ── New Arrivals / Best Sellers, as tabs sharing one grid (vamas.in style) ── {% endcomment %}
{% if section.settings.show_new_arrivals or section.settings.show_bestsellers %}
<section class="vamas-section vamas-section--alt vamas-tabbed-collections">
  <div class="vamas-section__header vamas-section__header--center">
    <div>
      <h2 class="vamas-section__title">Shop <span>Our Picks</span></h2>
      <p class="vamas-section__subtitle">Fresh styles, fan favorites</p>
    </div>
  </div>

  <div class="vamas-tabs" role="tablist">
    {% if section.settings.show_new_arrivals %}
      <button type="button" class="vamas-tabs__tab is-active" data-tab-target="new-arrivals" role="tab" aria-selected="true">New Arrivals</button>
    {% endif %}
    {% if section.settings.show_bestsellers %}
      <button type="button" class="vamas-tabs__tab{% unless section.settings.show_new_arrivals %} is-active{% endunless %}" data-tab-target="best-sellers" role="tab" aria-selected="{% if section.settings.show_new_arrivals %}false{% else %}true{% endif %}">Best Sellers</button>
    {% endif %}
  </div>

  {% if section.settings.show_new_arrivals %}
    <div class="vamas-tabs__panel is-active" data-tab-panel="new-arrivals">
      <div class="vamas-prod-grid vamas-prod-grid--scroll">
        {% assign na_col = collections[section.settings.new_arrivals_collection] %}
        {% if na_col == blank or na_col.products.size == 0 %}{% assign na_col = collections.all %}{% endif %}
        {% for product in na_col.products limit: 12 %}
          {% render 'vamas-product-card', product: product %}
        {% else %}
          {% for i in (1..6) %}{% render 'vamas-product-card-placeholder', index: i %}{% endfor %}
        {% endfor %}
      </div>
      <a href="{{ collections[section.settings.new_arrivals_collection].url | default: '/collections/all' }}" class="vamas-view-all vamas-view-all--panel">VIEW ALL</a>
    </div>
  {% endif %}

  {% if section.settings.show_bestsellers %}
    <div class="vamas-tabs__panel{% unless section.settings.show_new_arrivals %} is-active{% endunless %}" data-tab-panel="best-sellers">
      <div class="vamas-prod-grid vamas-prod-grid--scroll">
        {% assign bs_col = collections[section.settings.bestsellers_collection] %}
        {% if bs_col == blank or bs_col.products.size == 0 %}{% assign bs_col = collections.all %}{% endif %}
        {% for product in bs_col.products reversed limit: 12 %}
          {% render 'vamas-product-card', product: product %}
        {% else %}
          {% for i in (1..6) %}{% render 'vamas-product-card-placeholder', index: i %}{% endfor %}
        {% endfor %}
      </div>
      <a href="{{ collections[section.settings.bestsellers_collection].url | default: '/collections/all' }}" class="vamas-view-all vamas-view-all--panel">VIEW ALL</a>
    </div>
  {% endif %}
</section>

<script>
(function(){
  function wireTabs(){
    document.querySelectorAll('.vamas-tabbed-collections').forEach(function(wrap){
      if (wrap.dataset.tabsWired) return;
      wrap.dataset.tabsWired = '1';
      var tabs = wrap.querySelectorAll('.vamas-tabs__tab');
      tabs.forEach(function(tab){
        tab.addEventListener('click', function(){
          tabs.forEach(function(t){ t.classList.remove('is-active'); t.setAttribute('aria-selected', 'false'); });
          tab.classList.add('is-active');
          tab.setAttribute('aria-selected', 'true');
          var target = tab.getAttribute('data-tab-target');
          wrap.querySelectorAll('.vamas-tabs__panel').forEach(function(panel){
            panel.classList.toggle('is-active', panel.getAttribute('data-tab-panel') === target);
          });
        });
      });
    });
  }
  /* This script tag sits right after the FIRST .vamas-tabbed-collections section
     in the document, so at parse time a second one further down the page (Extra
     Collections) doesn't exist in the DOM yet - wait for the full page to parse
     before wiring, so every tabbed section on the page gets picked up. */
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', wireTabs);
  else wireTabs();
})();
</script>
{% endif %}

