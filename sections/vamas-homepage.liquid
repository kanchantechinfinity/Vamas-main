        {% assign ec1_col = collections[section.settings.extra_collection_1] %}
        {% if ec1_col == blank or ec1_col.products.size == 0 %}{% assign ec1_col = collections.all %}{% endif %}
        {% for product in ec1_col.products limit: 12 %}
          {% render 'vamas-product-card', product: product %}
        {% else %}
          {% for i in (1..6) %}{% render 'vamas-product-card-placeholder', index: i %}{% endfor %}
        {% endfor %}
      </div>
      <a href="{{ collections[section.settings.extra_collection_1].url | default: '/collections/all' }}" class="vamas-view-all vamas-view-all--panel">VIEW ALL</a>
    </div>
  {% endif %}

  {% if section.settings.show_extra_collection_2 %}
    <div class="vamas-tabs__panel{% unless section.settings.show_extra_collection_1 %} is-active{% endunless %}" data-tab-panel="extra-2">
      <div class="vamas-prod-grid vamas-prod-grid--scroll">
        {% assign ec2_col = collections[section.settings.extra_collection_2] %}
        {% if ec2_col == blank or ec2_col.products.size == 0 %}{% assign ec2_col = collections.all %}{% endif %}
        {% for product in ec2_col.products limit: 12 %}
          {% render 'vamas-product-card', product: product %}
        {% else %}
          {% for i in (1..6) %}{% render 'vamas-product-card-placeholder', index: i %}{% endfor %}
        {% endfor %}
      </div>
      <a href="{{ collections[section.settings.extra_collection_2].url | default: '/collections/all' }}" class="vamas-view-all vamas-view-all--panel">VIEW ALL</a>
    </div>
  {% endif %}
</section>
{% endif %}

{% comment %} ── Brand Story ──────────────────────── {% endcomment %}
{% if section.settings.show_brand %}
<section class="vamas-brand">
  <div class="vamas-brand__text">
    <p class="vamas-brand__eyebrow">{{ section.settings.brand_eyebrow | default: 'OUR STORY' }}</p>
    <h2 class="vamas-brand__heading">{{ section.settings.brand_heading }}</h2>
    <p class="vamas-brand__text-body">{{ section.settings.brand_text }}</p>
    <div class="vamas-brand__stats" data-stats-counter>
      {% for block in section.blocks %}
        {% if block.type == 'stat' %}
          <div>
            <div class="vamas-brand__stat-num" data-count-target="{{ block.settings.stat_num }}">0</div>
            <div class="vamas-brand__stat-lbl">{{ block.settings.stat_lbl }}</div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
    <a href="{{ section.settings.brand_btn_url | default: '/pages/about' }}" class="btn-outline">
      {{ section.settings.brand_btn_text | default: 'EXPLORE OUR STORY' }}
    </a>
  </div>
  <div class="vamas-brand__image">
    {% if section.settings.brand_image != blank %}
      <img src="{{ section.settings.brand_image | img_url: '500x640', crop: 'center' }}"
           alt="Vamas brand story" loading="lazy" width="500" height="640">
    {% elsif section.settings.brand_image_asset != blank %}
      <img src="{{ section.settings.brand_image_asset | asset_url }}"
           alt="Vamas brand story" loading="lazy" width="500" height="640">
    {% else %}
      <img src="https://images.unsplash.com/photo-1732949946085-cb7274e55bf1?w=900&q=80&auto=format&fit=crop"
           alt="Vamas brand story" loading="lazy" width="500" height="640">
    {% endif %}
  </div>
</section>
{% endif %}
<script>
(function(){
  var wrap = document.querySelector('[data-stats-counter]');
  if (!wrap) return;
  var nums = wrap.querySelectorAll('[data-count-target]');
  var duration = 1500;

  function animateOne(el){
    var raw = el.getAttribute('data-count-target') || '';
    var match = raw.match(/^([\d,]*\.?\d+)/);
    if (!match) { el.textContent = raw; return; }
    var numStr = match[1];
    var suffix = raw.slice(numStr.length);
    var target = parseFloat(numStr.replace(/,/g, ''));
    if (isNaN(target)) { el.textContent = raw; return; }
    var decimals = (numStr.split('.')[1] || '').length;
    var hasCommas = numStr.indexOf(',') > -1;
    var start = null;
    function frame(ts){
      if (!start) start = ts;
      var progress = Math.min((ts - start) / duration, 1);
      var eased = 1 - Math.pow(1 - progress, 3);
      var current = target * eased;
      var text = decimals > 0 ? current.toFixed(decimals) : Math.round(current).toString();
      if (hasCommas) {
        var parts = text.split('.');
        parts[0] = parseInt(parts[0], 10).toLocaleString('en-IN');
        text = parts.join('.');
      }
      el.textContent = text + suffix;
      if (progress < 1) requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  }

  var done = false;
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(entry){
      if (entry.isIntersecting && !done) {
        done = true;
        nums.forEach(animateOne);
        io.disconnect();
      }
    });
  }, { threshold: 0.3 });
  io.observe(wrap);
})();
</script>

{% comment %} ── Instagram Reels ─────────────────── {% endcomment %}
{% assign reel_blocks = section.blocks | where: 'type', 'reel' %}
{% if reel_blocks.size > 0 and section.settings.show_reels %}
<section class="vamas-reels">
  <div class="vamas-section__header">
    <div>
      <h2 class="vamas-section__title">As Seen on <span>Instagram</span></h2>
      <p class="vamas-section__subtitle">{{ section.settings.reels_sub | default: 'Follow @vamas.official for daily style inspiration' }}</p>
    </div>
    <a href="{{ section.settings.reels_follow_url | default: '#' }}" class="vamas-view-all" style="display:flex;align-items:center;gap:6px;">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>FOLLOW US
    </a>
  </div>
  <div class="vamas-cat-carousel" data-cat-carousel data-count="{{ reel_blocks.size }}" data-speed="0.4">
    <div class="vamas-reels__grid" data-cat-track>
      {% for dup in (1..2) %}
        {% for block in section.blocks %}
          {% if block.type == 'reel' %}
            <div class="vamas-reel-card">
              <a class="vamas-reel" href="{{ block.settings.reel_url | default: '#' }}" {{ block.shopify_attributes }}>
                {% if block.settings.reel_video != blank %}
                  <video class="vamas-reel__img" autoplay muted loop playsinline preload="metadata"{% if block.settings.reel_image != blank %} poster="{{ block.settings.reel_image | img_url: '400x711', crop: 'center' }}"{% endif %}>
                    {% for source in block.settings.reel_video.sources %}<source src="{{ source.url }}" type="{{ source.mime_type }}">{% endfor %}
                  </video>
                {% elsif block.settings.reel_image != blank %}
                  <img class="vamas-reel__img" src="{{ block.settings.reel_image | img_url: '400x711', crop: 'center' }}" alt="{{ block.settings.reel_handle | escape }}" loading="lazy" draggable="false">
                {% elsif block.settings.image_asset != blank %}
                  <img class="vamas-reel__img" src="{{ block.settings.image_asset | asset_url }}" alt="{{ block.settings.reel_handle | escape }}" loading="lazy" draggable="false">
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg vamas-reel__img' }}
                {% endif %}
                <div class="vamas-reel__overlay"></div>
                <div class="vamas-reel__badge"><svg viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="white" stroke="none"/></svg></div>
                {% if block.settings.reel_video == blank %}
                  <div class="vamas-reel__play"><svg viewBox="0 0 24 24"><polygon points="5,3 19,12 5,21"/></svg></div>
                {% endif %}
                <div class="vamas-reel__info">
                  <div class="vamas-reel__handle">{{ block.settings.reel_handle | default: '@vamas.official' }}</div>
                  <div class="vamas-reel__stats">
                    <div class="vamas-reel__stat"><svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>{{ block.settings.reel_likes | default: '1.2k' }}</div>
                    <div class="vamas-reel__stat"><svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>{{ block.settings.reel_views | default: '1,215' }}</div>
                  </div>
                </div>
              </a>
              {% if block.settings.reel_product != blank %}
                {% assign rp = block.settings.reel_product %}
                <a href="{{ rp.url }}" class="vamas-reel-product">
                  <span class="vamas-reel-product__img">
                    <img src="{{ rp.featured_image | img_url: '120x120', crop: 'center' }}" alt="{{ rp.title | escape }}" loading="lazy" draggable="false">
                  </span>
                  <span class="vamas-reel-product__body">
                    <span class="vamas-reel-product__name">{{ rp.title }}</span>
                    <span class="vamas-reel-product__price">{{ rp.price | money }}</span>
                  </span>
                  <span class="vamas-reel-product__cta">View</span>
                </a>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% comment %} ── Testimonials ─────────────────────── {% endcomment %}
{% assign test_blocks = section.blocks | where: 'type', 'testimonial' %}
{% if test_blocks.size > 0 and section.settings.show_testimonials %}
<section class="vamas-section vamas-section--alt vamas-test-section">
  <div class="vamas-section__header">
    <div>
      <h2 class="vamas-section__title">Customer <span>Reviews</span></h2>
      <p class="vamas-section__subtitle">Over 10,000 happy customers</p>
    </div>
  </div>

  <div class="vamas-test-marquee-row">
    <div class="vamas-test-marquee-track">
      {% for dup in (1..2) %}
        {% for block in test_blocks %}
          <div class="vamas-test-card">
            <div class="vamas-test-card__avatar">
              {% if block.settings.reviewer_photo != blank %}
                <img src="{{ block.settings.reviewer_photo | img_url: '160x160', crop: 'center' }}" alt="{{ block.settings.reviewer_name | escape }}" loading="lazy">
              {% else %}
                {% capture av_img %}{% cycle 'test-av-1': 'prod-blue.jpg', 'prod-brinjal.jpg', 'prod-cobalt.jpg', 'prod-darkmaroon.jpg', 'prod-green2.jpg', 'prod-indigo.jpg', 'prod-maroon2.jpg' %}{% endcapture %}
                <img src="{{ av_img | asset_url }}" alt="{{ block.settings.reviewer_name | escape }}" loading="lazy">
              {% endif %}
            </div>
            <div class="vamas-test-card__body">
              <div class="vamas-test-card__stars">{% for s in (1..block.settings.rating) %}★{% endfor %}</div>
              <p class="vamas-test-card__text">{{ block.settings.review_text }}</p>
              <div class="vamas-test-card__name">{{ block.settings.reviewer_name }}</div>
              <div class="vamas-test-card__verified">&#10003; Verified buyer</div>
            </div>
          </div>
        {% endfor %}
      {% endfor %}
    </div>
  </div>

  {% if test_blocks.size > 1 %}
  <div class="vamas-test-marquee-row vamas-test-marquee-row--reverse">
    <div class="vamas-test-marquee-track">
      {% for dup in (1..2) %}
        {% for block in test_blocks %}
          <div class="vamas-test-card">
            <div class="vamas-test-card__avatar">
              {% if block.settings.reviewer_photo != blank %}
                <img src="{{ block.settings.reviewer_photo | img_url: '160x160', crop: 'center' }}" alt="{{ block.settings.reviewer_name | escape }}" loading="lazy">
              {% else %}
                {% capture av_img2 %}{% cycle 'test-av-2': 'prod-maroon2.jpg', 'prod-indigo.jpg', 'prod-green2.jpg', 'prod-darkmaroon.jpg', 'prod-cobalt.jpg', 'prod-brinjal.jpg', 'prod-blue.jpg' %}{% endcapture %}
                <img src="{{ av_img2 | asset_url }}" alt="{{ block.settings.reviewer_name | escape }}" loading="lazy">
              {% endif %}
            </div>
            <div class="vamas-test-card__body">
              <div class="vamas-test-card__stars">{% for s in (1..block.settings.rating) %}★{% endfor %}</div>
              <p class="vamas-test-card__text">{{ block.settings.review_text }}</p>
              <div class="vamas-test-card__name">{{ block.settings.reviewer_name }}</div>
              <div class="vamas-test-card__verified">&#10003; Verified buyer</div>
            </div>
          </div>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
  {% endif %}
</section>
{% endif %}

