{{ 'vamas-collection.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Category grid page — image tiles with a label, 3-up on mobile and wider on
  desktop. Uses the section's own picked collections when the merchant has
  chosen any, otherwise falls back to every collection in the store.
{%- endcomment -%}
{%- assign picked = section.blocks | where: 'type', 'category' -%}

<section class="vcats">
  <div class="vcats__head">
    {% if section.settings.eyebrow != blank %}
      <p class="vcats__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h1 class="vcats__title">{{ section.settings.heading | default: 'Shop by Category' }}</h1>
    {% if section.settings.subheading != blank %}
      <p class="vcats__sub">{{ section.settings.subheading }}</p>
    {% endif %}
  </div>

  <div class="vcats__grid">
    {% if picked.size > 0 %}
      {% for block in picked %}
        {%- assign c = collections[block.settings.collection] -%}
        {%- assign tile_label = block.settings.label | default: c.title -%}
        {%- assign tile_url = c.url | default: '/collections/all' -%}
        <a class="vcat" href="{{ tile_url }}" {{ block.shopify_attributes }}>
          <span class="vcat__frame">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 500 }}" alt="{{ tile_label | escape }}" loading="lazy" width="500" height="500">
            {% elsif c.featured_image != blank %}
              <img src="{{ c.featured_image | image_url: width: 500 }}" alt="{{ tile_label | escape }}" loading="lazy" width="500" height="500">
            {% elsif c.products.first.featured_image != blank %}
              <img src="{{ c.products.first.featured_image | image_url: width: 500 }}" alt="{{ tile_label | escape }}" loading="lazy" width="500" height="500">
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag: 'vcat__ph' }}
            {% endif %}
            <span class="vcat__label">{{ tile_label }}</span>
          </span>
        </a>
      {% endfor %}
    {% else %}
      {% for c in collections %}
        {% if c.handle != 'frontpage' %}
          <a class="vcat" href="{{ c.url }}">
            <span class="vcat__frame">
              {% if c.featured_image != blank %}
                <img src="{{ c.featured_image | image_url: width: 500 }}" alt="{{ c.title | escape }}" loading="lazy" width="500" height="500">
              {% elsif c.products.first.featured_image != blank %}
                <img src="{{ c.products.first.featured_image | image_url: width: 500 }}" alt="{{ c.title | escape }}" loading="lazy" width="500" height="500">
              {% else %}
                {{ 'collection-1' | placeholder_svg_tag: 'vcat__ph' }}
              {% endif %}
              <span class="vcat__label">{{ c.title }}</span>
            </span>
          </a>
        {% endif %}
      {% endfor %}
    {% endif %}
  </div>
</section>

<style>
  .vcats { padding: 40px var(--page-gutter) 72px; background: var(--color-bg, #FEF9F2); }
  .vcats__head { text-align: center; margin-bottom: 30px; }
  .vcats__eyebrow { font-size: 10px; font-weight: 700; letter-spacing: 4px; text-transform: uppercase; color: var(--color-gold-dark, #c9a96e); margin: 0 0 10px; }
  .vcats__title { font-family: var(--font-heading); font-size: 34px; font-weight: 700; color: var(--color-maroon, #924444); margin: 0 0 8px; line-height: 1.2; text-wrap: balance; }
  .vcats__sub { font-size: 13.5px; color: rgba(146,68,68,.55); margin: 0 auto; max-width: 60ch; line-height: 1.6; }

  .vcats__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; }
  .vcat { text-decoration: none; display: block; }
  .vcat__frame {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    border-radius: 10px;
    overflow: hidden;
    border: 3px solid var(--color-gold, #EBD3AD);
    outline: 1px solid rgba(201,169,110,.45);
    outline-offset: 3px;
    background: #f6efe6;
    transition: transform .25s, box-shadow .25s;
  }
  .vcat:hover .vcat__frame { transform: translateY(-4px); box-shadow: 0 12px 26px rgba(146,68,68,.16); }
  .vcat__frame img,
  .vcat__frame .vcat__ph { width: 100%; height: 100%; object-fit: cover; object-position: center 18%; display: block; }
  .vcat__label {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    padding: 26px 10px 12px;
    background: linear-gradient(to top, rgba(146,68,68,.82) 0%, rgba(146,68,68,.34) 55%, transparent 100%);
    color: #fff;
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-align: center;
    line-height: 1.3;
  }

  @media (max-width: 1180px) {
    .vcats__grid { grid-template-columns: repeat(3, 1fr); gap: 18px; }
  }
  @media (max-width: 768px) {
    .vcats { padding: 24px 16px 40px; }
    .vcats__title { font-size: 24px; }
    .vcats__sub { font-size: 12.5px; }
    .vcats__grid { grid-template-columns: repeat(3, 1fr); gap: 10px; }
    .vcat__frame { border-width: 2px; outline-offset: 2px; border-radius: 8px; }
    .vcat__label { font-size: 10px; letter-spacing: .5px; padding: 18px 5px 8px; }
  }
</style>

{% schema %}
{
  "name": "Vamas Categories",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "BROWSE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Category" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Label", "info": "Defaults to the collection title." },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Defaults to the collection image, then its first product photo." }
      ]
    }
  ],
  "presets": [{ "name": "Vamas Categories" }]
}
{% endschema %}
