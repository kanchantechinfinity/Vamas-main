{{ 'vamas-collection.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Category grid page - circles matching the homepage "Explore by Category" row,
  so /collections (this page) reads as the full, non-scrolling version of that
  carousel. Uses the section's own picked collections when the merchant has
  chosen any; otherwise falls back to the current 11-tile structure - 7 tiles
  are real collections (linked directly), 4 are group headings with no
  collection of their own (linked to the /collections/all/group-<slug> hub
  handled in vamas-collection.liquid). Handles carry -copy because that is
  what actually exists right now (duplicated collections whose slug was never
  cleaned up) - update this list, and vamas-collection.liquid's group_map
  setting, once the real handles are renamed.
{%- endcomment -%}
{%- assign picked = section.blocks | where: 'type', 'category' -%}
{%- assign fallback_direct = 'occasion-wear-copy|Dual Neck Blouses,dual-neck-blouses-copy|Side Stretch Blouses,side-stretch-blouses-copy|Re-Verse By Vamas,re-verse-by-vamas-copy|Brocade Bohemia,brocade-bohemia-copy|The Kanjivaram Companion,the-kanjivaram-companion-copy|Brigerton Inspired Series,brigerton-inspired-series-copy|Party Wear,brizy-prints|Brizy Prints' | split: ',' -%}
{%- assign fallback_groups = 'plain-edit|THE PLAIN EDIT|royal-collar-necks-copy,summer-essentials|SUMMER ESSENTIALS|brezzy-prints-copy,festive-wear|FESTIVE WEAR|wedding-wear-copy,more-categories|MORE CATEGORIES|one-of-a-kind-blouses-copy' | split: ',' -%}
{%- comment -%} Each group's real children (from vamas-collection.liquid's own
  group_map default) - checked below so a group with NONE of these collections
  on this store links straight to /collections/all instead of an empty hub page. {%- endcomment -%}
{%- assign group_children_map = 'plain-edit~signature-sleeveless+timeless-elbow-length+side-stretch-blouses+classic-cottons+royal-collar-necks+corsets|summer-essentials~corsets-copy+everyday-cottons-copy+the-shirt-blouse-copy+brezzy-prints-copy|festive-wear~croche-line-copy+haldi-and-mehendi-copy+wedding-wear-copy|more-categories~party-wear-copy+prayer-meet-blouses-copy+one-of-a-kind-blouses-copy' -%}

<section class="vcats">
  <div class="vcats__head">
    {% if section.settings.eyebrow != blank %}
      <p class="vcats__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h1 class="vcats__title">{{ section.settings.heading | default: 'Shop by Category' }}</h1>
    {% if section.settings.subheading != blank %}
      <p class="vcats__sub">{{ section.settings.subheading }}</p>
    {% endif %}
  </div>

  <div class="vcats__grid">
    {% if picked.size > 0 %}
      {% for block in picked %}
        {%- assign c = collections[block.settings.collection] -%}
        {%- assign tile_label = block.settings.label | default: c.title -%}
        {%- assign tile_url = c.url | default: '/collections/all' -%}
        {%- assign circle_img = block.settings.image -%}
        {%- if circle_img == blank -%}{%- assign circle_img = c.image -%}{%- endif -%}
        {%- if circle_img == blank -%}{%- assign circle_img = c.products.first.featured_image -%}{%- endif -%}
        <a class="vcat" href="{{ tile_url }}" {{ block.shopify_attributes }}>
          <span class="vcat__ring">
            {% if circle_img != blank %}
              <img src="{{ circle_img | image_url: width: 360 }}" alt="{{ tile_label | escape }}" loading="lazy" width="180" height="180">
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag: 'vcat__ph' }}
            {% endif %}
          </span>
          <span class="vcat__label">{{ tile_label }}</span>
        </a>
      {% endfor %}
    {% else %}
      {% for entry in fallback_direct %}
        {%- assign parts = entry | split: '|' -%}
        {%- assign entry_handle = parts[0] | strip -%}
        {%- assign c = collections[entry_handle] -%}
        {%- assign tile_label = parts[1] | strip -%}
        {%- comment -%}
          The hardcoded handle is a legacy quirk from one store's collection
          restructuring - on any OTHER store, a collection is far more likely
          to exist at its own natural handle (derived from the label). Try
          that as a fallback so a freshly created, sensibly-named collection
          connects on its own, with no code edit needed per store.
        {%- endcomment -%}
        {%- if c == blank or c.products.size == 0 -%}
          {%- assign guessed_entry_handle = tile_label | handle -%}
          {%- if collections[guessed_entry_handle] and collections[guessed_entry_handle].products.size > 0 -%}
            {%- assign c = collections[guessed_entry_handle] -%}
            {%- assign entry_handle = guessed_entry_handle -%}
          {%- endif -%}
        {%- endif -%}
        {%- comment -%}
          Always render the tile, same as the homepage carousel - if its
          collection was deleted/renamed, fall through to /collections/all
          instead of silently vanishing from this page. Whoever is missing
          still shows up (with a placeholder image if needed) as a visible
          signal that its link needs pointing at the new handle, rather than
          quietly dropping a tile with no trace.
        {%- endcomment -%}
        {%- assign tile_url = c.url | default: '/collections/all' -%}
        {%- comment -%}
          Cover photo override, from the client's product-code sheet -
          takes priority over the collection's own image/first product,
          for the tiles the client picked a specific product/colour for.
        {%- endcomment -%}
        {%- capture cover_asset -%}{%- render 'vamas-cat-cover', handle: entry_handle -%}{%- endcapture -%}
        {%- assign cover_asset = cover_asset | strip -%}
        {%- assign circle_img = c.image -%}
        {%- if circle_img == blank -%}{%- assign circle_img = c.products.first.featured_image -%}{%- endif -%}
        <a class="vcat" href="{{ tile_url }}">
          <span class="vcat__ring">
            {% if cover_asset != blank %}
              <img src="{{ cover_asset | asset_url }}" alt="{{ tile_label | escape }}" loading="lazy" width="180" height="180">
            {% elsif circle_img != blank %}
              <img src="{{ circle_img | image_url: width: 360 }}" alt="{{ tile_label | escape }}" loading="lazy" width="180" height="180">
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag: 'vcat__ph' }}
            {% endif %}
          </span>
          <span class="vcat__label">{{ tile_label }}</span>
        </a>
      {% endfor %}
      {% for entry in fallback_groups %}
        {%- assign parts = entry | split: '|' -%}
        {%- assign group_slug = parts[0] | strip -%}
        {%- assign group_label = parts[1] | strip -%}
        {%- assign img_source_handle = parts[2] | strip -%}
        {%- assign img_source = collections[img_source_handle] -%}
        {%- assign cover_asset = blank -%}
        {%- if group_label == 'SUMMER ESSENTIALS' -%}{%- assign cover_asset = 'cat-summer-essentials.jpg' -%}{%- endif -%}
        {%- if group_label == 'THE PLAIN EDIT' -%}{%- assign cover_asset = 'prod-darkmaroon.jpg' -%}{%- endif -%}
        {%- if group_label == 'FESTIVE WEAR' -%}{%- assign cover_asset = 'prod-brinjal.jpg' -%}{%- endif -%}
        {%- if group_label == 'MORE CATEGORIES' -%}{%- assign cover_asset = 'bridal.jpg' -%}{%- endif -%}
        {%- assign circle_img = img_source.image -%}
        {%- if circle_img == blank -%}{%- assign circle_img = img_source.products.first.featured_image -%}{%- endif -%}
        {%- comment -%} If none of this group's children exist as real collections
          here, /collections/all?group=... shows an empty hub - send the tile
          straight to /collections/all instead of a dead end. {%- endcomment -%}
        {%- assign group_has_child = false -%}
        {%- assign group_children_after = group_children_map | split: group_slug | last | remove_first: '~' -%}
        {%- assign group_children_entry = group_children_after | split: '|' | first -%}
        {%- for gc in group_children_entry | split: '+' -%}
          {%- if collections[gc] != blank and collections[gc].handle -%}{%- assign group_has_child = true -%}{%- endif -%}
        {%- endfor -%}
        {%- assign group_href = '/collections/all?group=' | append: group_slug -%}
        {%- unless group_has_child -%}{%- assign group_href = '/collections/all' -%}{%- endunless -%}
        <a class="vcat" href="{{ group_href }}">
          <span class="vcat__ring">
            {% if cover_asset != blank %}
              <img src="{{ cover_asset | asset_url }}" alt="{{ group_label | escape }}" loading="lazy" width="180" height="180">
            {% elsif circle_img != blank %}
              <img src="{{ circle_img | image_url: width: 360 }}" alt="{{ group_label | escape }}" loading="lazy" width="180" height="180">
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag: 'vcat__ph' }}
            {% endif %}
          </span>
          <span class="vcat__label">{{ group_label }}</span>
        </a>
      {% endfor %}
    {% endif %}
  </div>
</section>

<style>
  .vcats { padding: 40px var(--page-gutter) 72px; background: var(--color-bg, #FEF9F2); }
  .vcats__head { text-align: center; margin-bottom: 30px; }
  .vcats__eyebrow { font-size: 10px; font-weight: 700; letter-spacing: 4px; text-transform: uppercase; color: var(--color-gold-dark, #c9a96e); margin: 0 0 10px; }
  .vcats__title { font-family: var(--font-heading); font-size: 34px; font-weight: 700; color: var(--color-maroon, #924444); margin: 0 0 8px; line-height: 1.2; text-wrap: balance; }
  .vcats__sub { font-size: 13.5px; color: rgba(146,68,68,.55); margin: 0 auto; max-width: 60ch; line-height: 1.6; }

/* Circles, matching the homepage "Explore by Category" row - this page is the
     full version of that carousel, so it should look like the same design, not
     a second one. */
  .vcats__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 34px 24px; max-width: 1100px; margin: 0 auto; }
  .vcat { text-decoration: none; display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .vcat__ring {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    background: rgba(235,211,173,.18);
    border: 1px solid rgba(146,68,68,.14);
    transition: transform .2s ease, box-shadow .2s ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .vcat:hover .vcat__ring { transform: translateY(-4px); box-shadow: 0 10px 24px rgba(146,68,68,.18); }
  }
  .vcat__ring img,
  .vcat__ring .vcat__ph { width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block; }
  .vcat__label {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 600;
    color: var(--color-maroon, #924444);
    text-align: center;
    line-height: 1.35;
  }

  @media (max-width: 1180px) {
    .vcats__grid { grid-template-columns: repeat(3, 1fr); gap: 28px 20px; }
  }
  @media (max-width: 768px) {
    .vcats { padding: 24px 16px 40px; }
    .vcats__title { font-size: 24px; }
    .vcats__sub { font-size: 12.5px; }
    .vcats__grid { grid-template-columns: repeat(2, 1fr); gap: 22px 14px; }
    .vcat__label { font-size: 12.5px; }
  }
</style>

{% schema %}
{
  "name": "Vamas Categories",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "BROWSE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Category" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Label", "info": "Defaults to the collection title." },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Defaults to the collection image, then its first product photo." }
      ]
    }
  ],
  "presets": [{ "name": "Vamas Categories" }]
}
{% endschema %}
