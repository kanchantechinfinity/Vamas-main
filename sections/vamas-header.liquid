{% comment %} ── Announcement Bar ─────────────────── {% endcomment %}
{% if section.settings.show_announce %}
  {% comment %} Build the message list from the 3 editable slots, skipping blanks {% endcomment %}
  {% assign announce_msgs = '' %}
  {% if section.settings.announce_text_1 != blank %}{% assign announce_msgs = announce_msgs | append: section.settings.announce_text_1 | append: '§' %}{% endif %}
  {% if section.settings.announce_text_2 != blank %}{% assign announce_msgs = announce_msgs | append: section.settings.announce_text_2 | append: '§' %}{% endif %}
  {% if section.settings.announce_text_3 != blank %}{% assign announce_msgs = announce_msgs | append: section.settings.announce_text_3 | append: '§' %}{% endif %}
  {% comment %} Fall back to the old single-text setting so nothing disappears if the new slots are empty {% endcomment %}
  {% if announce_msgs == '' and section.settings.announce_text != blank %}
    {% assign announce_msgs = section.settings.announce_text | append: '§' %}
  {% endif %}
  {% assign announce_list = announce_msgs | split: '§' %}

  {% comment %} Every message is framed by a heart on each side, so the merchant
    types plain text and never has to paste the symbol themselves.

    Deliberately an SVG, not the ❤ character: U+2764 defaults to EMOJI
    presentation on iOS/Android, which renders as a fixed red glyph that CSS
    `color` cannot touch. An inline SVG on currentColor takes the theme colour
    on every device. {% endcomment %}
  {% capture announce_heart %}<svg class="vamas-announce__heart" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21s-7.5-4.7-9.6-9A5.4 5.4 0 0 1 12 6a5.4 5.4 0 0 1 9.6 6c-2.1 4.3-9.6 9-9.6 9z"/></svg>{% endcapture %}

  {% if announce_list.size > 0 %}
    {% if section.settings.announce_marquee %}
      <div class="vamas-announce vamas-announce--marquee">
        <div class="vamas-announce__track" style="animation-duration: {{ section.settings.announce_speed | default: 22 }}s;">
          {% for i in (1..2) %}
            <span{% if i == 2 %} aria-hidden="true"{% endif %}>
              {% for msg in announce_list %}{{ announce_heart }} {{ msg }} {{ announce_heart }}{% unless forloop.last %} &nbsp;&nbsp; {% endunless %}{% endfor %}
            </span>
          {% endfor %}
        </div>
      </div>
    {% else %}
      <div class="vamas-announce vamas-announce--switch"
           data-announce-switch
           data-interval="{{ section.settings.announce_switch_seconds | default: 2 }}">
        {% for msg in announce_list %}
          <span class="vamas-announce__msg{% if forloop.first %} is-active{% endif %}">{{ announce_heart }} {{ msg }} {{ announce_heart }}</span>
        {% endfor %}
      </div>
    {% endif %}
  {% endif %}
{% endif %}

<div class="vamas-nav-wrapper" id="vamas-nav-wrapper">
  <nav class="vamas-nav-outer">
    <div class="vamas-nav">
      {% comment %} Mobile-only left zone (hidden on desktop): keeps the centred logo centred once the desktop menu is replaced by the hamburger {% endcomment %}
      <div class="vamas-nav__bar-left">
        <button class="vamas-nav__hamburger" id="vamas-nav-hamburger" aria-label="Menu"><span></span><span></span><span></span></button>
      </div>

      <a href="{{ routes.root_url }}" class="vamas-nav__logo">
        {% if section.settings.logo != blank %}
          <img src="{{ section.settings.logo | img_url: '200x' }}" alt="{{ shop.name }}" class="vamas-nav__logo-img" width="120" height="42">
        {% elsif section.settings.logo_asset != blank %}
          <img src="{{ section.settings.logo_asset | asset_url }}" alt="{{ shop.name }}" class="vamas-nav__logo-img" width="120" height="42">
        {% else %}
          <span class="vamas-nav__brand">{{ shop.name }}</span>
        {% endif %}
      </a>

      {% comment %} Fallback "All Blouses" product for mega-menu promo cards whose own
        link has no collection of its own - just any product from the full catalogue. {% endcomment %}
      {% assign mega_bestseller_collection = collections.all %}
      {% assign mega_bestseller_product = mega_bestseller_collection.products.first %}

      {% comment %} Promo card image: pick a discounted product so "Big Discounts" shows a real sale item {% endcomment %}
      {% assign mega_promo_product = nil %}
      {% for p in collections.all.products %}
        {% if p.compare_at_price > p.price and p.featured_image %}
          {% assign mega_promo_product = p %}
          {% break %}
        {% endif %}
      {% endfor %}
      {% if mega_promo_product == nil %}
        {% assign mega_promo_product = collections.all.products.first %}
      {% endif %}

      <div class="vamas-nav__links">
        {% for link in section.settings.main_menu.links %}
          {% if link.links != blank %}
            {% assign group_icons_1 = nil %}
            {% assign group_icons_2 = nil %}
            {% assign group_looks = nil %}
            {% assign group_colours = nil %}
            {% assign has_leaf = false %}
            {% for childlink in link.links %}
              {% case childlink.title %}
                {% when 'Categories' or 'Featured Collections' %}
                  {% assign group_icons_1 = childlink %}
                {% when 'Shop Blouse' %}
                  {% assign group_icons_2 = childlink %}
                {% when 'Shop by Look' %}
                  {% assign group_looks = childlink %}
                {% when 'Shop by Colour' or 'Shop by Color' %}
                  {% assign group_colours = childlink %}
                {% else %}
                  {% if childlink.links == blank %}
                    {% assign has_leaf = true %}
                  {% endif %}
              {% endcase %}
            {% endfor %}
            {% assign feature_product = nil %}
            {% assign linked_collection = nil %}
            {% if link.type == 'collection_link' and link.object %}
              {% assign linked_collection = link.object %}
            {% elsif link.url contains '/collections/' %}
              {% assign url_parts = link.url | split: '/collections/' %}
              {% assign collection_handle = url_parts[1] | split: '/' | first | split: '?' | first %}
              {% assign linked_collection = collections[collection_handle] %}
            {% endif %}
            {% if linked_collection == nil or linked_collection.products.size == 0 %}
              {% assign guessed_handle = link.title | handle %}
              {% if collections[guessed_handle] and collections[guessed_handle].products.size > 0 %}
                {% assign linked_collection = collections[guessed_handle] %}
              {% endif %}
            {% endif %}
            <!-- vamas-mega-debug [{{ link.title }}]: link.type={{ link.type }} link.url={{ link.url }} linked_collection={{ linked_collection.handle }} product_count={{ linked_collection.products.size }} -->
            {% if group_looks == nil and linked_collection and linked_collection.products.size > 0 %}
              {% assign feature_product = linked_collection.products.first %}
            {% endif %}
            <div class="vamas-nav__item vamas-nav__item--has-dropdown">
              <a href="{{ link.url }}"{% if link.active %} class="active"{% endif %}>{{ link.title | upcase }}</a>
              <div class="vamas-nav__dropdown vamas-nav__dropdown--rich" data-mega>
                {% if feature_product %}
                  <div class="vamas-nav__mega-feature">
                    <span class="vamas-nav__mega-looks-title">Best Seller</span>
                    <a href="{{ feature_product.url }}" class="vamas-nav__feature-card">
                      <span class="vamas-nav__feature-thumb">
                        {% if feature_product.featured_image %}
                          <img src="{{ feature_product.featured_image | img_url: '300x' }}" width="150" height="150" alt="{{ feature_product.title | escape }}" loading="lazy">
                        {% endif %}
                      </span>
                      <span class="vamas-nav__feature-title">{{ feature_product.title }}</span>
                      <span class="vamas-nav__feature-price">{{ feature_product.price | money | replace: 'Rs. ', '₹' }}</span>
                    </a>
                  </div>
                {% elsif group_looks %}
                  <div class="vamas-nav__mega-looks">
                    <span class="vamas-nav__mega-looks-title">Shop by Look</span>
                    <div class="vamas-nav__mega-looks-grid">
                      {% for look in group_looks.links %}
                        {% capture look_img %}{% cycle 'nav-looks': 'prod-indigo.jpg', 'prod-maroon2.jpg', 'prod-green2.jpg', 'prod-cobalt.jpg', 'prod-brinjal.jpg' %}{% endcapture %}
                        {% capture look_img_src %}{% render 'vamas-nav-icon-src', title: look.title, default_asset: look_img %}{% endcapture %}
                        <a href="{{ look.url }}" class="vamas-nav__look-item">
                          <span class="vamas-nav__look-thumb"><img src="{{ look_img_src | strip }}" width="72" height="72" alt="" loading="lazy"></span>
                          <span class="vamas-nav__look-label">{{ look.title }}</span>
                        </a>
                      {% endfor %}
                    </div>
                  </div>
                {% elsif has_leaf or group_icons_1 or group_icons_2 %}
                  <div class="vamas-nav__mega-promo-group">
                    <div class="vamas-nav__mega-promo">
                      <span class="vamas-nav__mega-looks-title">Big Discounts</span>
                      <a href="{% if mega_promo_product %}{{ mega_promo_product.url }}{% else %}{{ link.url }}{% endif %}" class="vamas-nav__promo-card">
                        {% if mega_promo_product.featured_image %}
                          <img src="{{ mega_promo_product.featured_image | img_url: '400x' }}" alt="{{ mega_promo_product.title | escape }}" loading="lazy">
                        {% else %}
                          {{ 'lifestyle-1' | placeholder_svg_tag: 'vamas-nav__promo-placeholder' }}
                        {% endif %}
                        <span class="vamas-nav__promo-overlay">
                          <span class="vamas-nav__promo-cta">Shop Now</span>
                        </span>
                      </a>
                    </div>
                    {% if mega_bestseller_product %}
                      <div class="vamas-nav__mega-feature">
                        <span class="vamas-nav__mega-looks-title">All Blouses</span>
                        <a href="{{ mega_bestseller_product.url }}" class="vamas-nav__feature-card">
                          <span class="vamas-nav__feature-thumb">
                            {% if mega_bestseller_product.featured_image %}
                              <img src="{{ mega_bestseller_product.featured_image | img_url: '300x' }}" width="150" height="150" alt="{{ mega_bestseller_product.title | escape }}" loading="lazy">
                            {% endif %}
                          </span>
                          <span class="vamas-nav__feature-title">{{ mega_bestseller_product.title }}</span>
                          <span class="vamas-nav__feature-price">{{ mega_bestseller_product.price | money | replace: 'Rs. ', '₹' }}</span>
                        </a>
                      </div>
                    {% endif %}
                  </div>
                {% endif %}
                <div class="vamas-nav__mega-main">
                  {%- comment -%} Featured Collections always mirrors the homepage's
                    "Explore by Category" carousel - same handles/labels as
                    vamas-categories.liquid's own fallback list, plus Corsets - so a
                    shopper sees the identical 12 categories in both places, instead
                    of whatever unrelated subset happens to be configured in the
                    Admin navigation menu's "Featured Collections" submenu. {%- endcomment -%}
                  <div class="vamas-nav__mega-section">
                    <span class="vamas-nav__mega-section-title">{{ group_icons_1.title | default: 'Featured Collections' }}</span>
                    <div class="vamas-nav__mega-icons vamas-nav__mega-icons--wide">
                      {%- assign mega_cats_direct = 'occasion-wear-copy|Dual Neck Blouses,dual-neck-blouses-copy|Side Stretch Blouses,side-stretch-blouses-copy|Re-Verse By Vamas,re-verse-by-vamas-copy|Brocade Bohemia,brocade-bohemia-copy|The Kanjivaram Companion,the-kanjivaram-companion-copy|Brigerton Inspired Series,brigerton-inspired-series-copy|Party Wear,corsets|Corsets' | split: ',' -%}
                      {%- for entry in mega_cats_direct -%}
                        {%- assign eparts = entry | split: '|' -%}
                        {%- assign e_handle = eparts[0] | strip -%}
                        {%- assign e_label = eparts[1] | strip -%}
                        {%- assign e_coll = collections[e_handle] -%}
                        {%- capture e_cover -%}{%- render 'vamas-cat-cover', handle: e_handle -%}{%- endcapture -%}
                        {%- assign e_cover = e_cover | strip -%}
                        {%- capture e_fallback_cycle -%}{% cycle 'nav-icons': 'prod-blue.jpg', 'prod-brinjal.jpg', 'prod-cobalt.jpg', 'prod-darkmaroon.jpg', 'prod-green2.jpg', 'prod-indigo.jpg', 'prod-maroon2.jpg' %}{%- endcapture -%}
                        {%- assign e_default_asset = e_cover | default: e_fallback_cycle -%}
                        {%- capture e_icon_src -%}{%- render 'vamas-nav-icon-src', title: e_label, default_asset: e_default_asset -%}{%- endcapture -%}
                        <a href="{{ e_coll.url | default: '/collections/all' }}" class="vamas-nav__icon-item">
                          <span class="vamas-nav__icon-thumb"><img src="{{ e_icon_src | strip }}" width="56" height="56" alt="" loading="lazy"></span>
                          <span class="vamas-nav__icon-label">{{ e_label }}</span>
                        </a>
                      {%- endfor -%}
                      {%- assign mega_cats_groups = 'plain-edit|THE PLAIN EDIT|prod-darkmaroon.jpg,summer-essentials|SUMMER ESSENTIALS|cat-summer-essentials.jpg,festive-wear|FESTIVE WEAR|prod-brinjal.jpg,more-categories|MORE CATEGORIES|bridal.jpg' | split: ',' -%}
                      {%- for entry in mega_cats_groups -%}
                        {%- assign gparts = entry | split: '|' -%}
                        {%- assign g_slug = gparts[0] | strip -%}
                        {%- assign g_label = gparts[1] | strip -%}
                        {%- assign g_asset = gparts[2] | strip -%}
                        {%- capture g_icon_src -%}{%- render 'vamas-nav-icon-src', title: g_label, default_asset: g_asset -%}{%- endcapture -%}
                        <a href="/collections/all?group={{ g_slug }}" class="vamas-nav__icon-item">
                          <span class="vamas-nav__icon-thumb"><img src="{{ g_icon_src | strip }}" width="56" height="56" alt="" loading="lazy"></span>
                          <span class="vamas-nav__icon-label">{{ g_label }}</span>
                        </a>
                      {%- endfor -%}
                    </div>
                  </div>
                  {% comment %} Sale Blouse's own "Shop Blouse" submenu is just discount-percent
                    tiles (Up to 65% Off / 50% Off / 80% Off / Clearance Products / Sale
                    Collection) - dropped here, redundant with the Big Discounts promo card
                    this dropdown already shows on the left. {% endcomment %}
                  {% assign link_title_lc = link.title | downcase %}
                  {% if group_icons_2 and link_title_lc != 'sale blouse' %}
                    <div class="vamas-nav__mega-section">
                      <span class="vamas-nav__mega-section-title">{{ group_icons_2.title }}</span>
                      <div class="vamas-nav__mega-icons">
                        {% for cat in group_icons_2.links %}
                          {% capture icon_img2 %}{% cycle 'nav-icons-2': 'prod-indigo.jpg', 'prod-maroon2.jpg', 'prod-green2.jpg', 'prod-cobalt.jpg', 'prod-blue.jpg', 'prod-brinjal.jpg', 'prod-darkmaroon.jpg' %}{% endcapture %}
                          {% capture icon_img2_src %}{% render 'vamas-nav-icon-src', title: cat.title, default_asset: icon_img2 %}{% endcapture %}
                          <a href="{{ cat.url }}" class="vamas-nav__icon-item">
                            <span class="vamas-nav__icon-thumb"><img src="{{ icon_img2_src | strip }}" width="56" height="56" alt="" loading="lazy"></span>
                            <span class="vamas-nav__icon-label">{{ cat.title }}</span>
                          </a>
                        {% endfor %}
                      </div>
                    </div>
                  {% endif %}
                  {% for childlink in link.links %}
                    {% unless childlink.title == 'Categories' or childlink.title == 'Featured Collections' or childlink.title == 'Shop Blouse' or childlink.title == 'Shop by Look' or childlink.title == 'Shop by Colour' or childlink.title == 'Shop by Color' or childlink.title == 'Curated Collections' %}
                      {% if childlink.links != blank %}
                        <div class="vamas-nav__mega-section">
                          <span class="vamas-nav__mega-section-title">{{ childlink.title }}</span>
                          <div class="vamas-nav__mega-textlist">
                            {% for l in childlink.links %}
                              <a href="{{ l.url }}" class="vamas-nav__textlist-link">{{ l.title }}</a>
                              {% if l.links != blank %}
                                <div class="vamas-nav__card-sublist vamas-nav__card-sublist--flat">
                                  {% for sub in l.links %}
                                    <a href="{{ sub.url }}" class="vamas-nav__card-subitem">{{ sub.title }}</a>
                                  {% endfor %}
                                </div>
                              {% endif %}
                            {% endfor %}
                          </div>
                        </div>
                      {% endif %}
                    {% endunless %}
                  {% endfor %}
                  {% if group_colours %}
                    <div class="vamas-nav__mega-section">
                      <span class="vamas-nav__mega-section-title">Shop by Colour</span>
                      <div class="vamas-nav__mega-swatches-grid">
                        {% for colour in group_colours.links %}
                          {% capture swatch_img %}{% cycle 'nav-swatches': 'prod-cobalt.jpg', 'prod-maroon2.jpg', 'prod-green2.jpg', 'prod-indigo.jpg', 'prod-blue.jpg' %}{% endcapture %}
                          {% capture swatch_img_src %}{% render 'vamas-nav-icon-src', title: colour.title, default_asset: swatch_img %}{% endcapture %}
                          <a href="{{ colour.url }}" class="vamas-nav__swatch-item">
                            <span class="vamas-nav__swatch-thumb"><img src="{{ swatch_img_src | strip }}" width="64" height="64" alt="" loading="lazy"></span>
                            <span class="vamas-nav__swatch-label">{{ colour.title }}</span>
                          </a>
                        {% endfor %}
                      </div>
                    </div>
                  {% endif %}
                  {% if has_leaf %}
                    <div class="vamas-nav__mega-section">
                      <div class="vamas-nav__mega-icons vamas-nav__mega-icons--compact">
                        {% for childlink in link.links %}
                          {% if childlink.links == blank and childlink.title != 'Categories' and childlink.title != 'Shop by Look' and childlink.title != 'Shop by Colour' and childlink.title != 'Shop by Color' %}
                            {% capture leaf_img %}{% cycle 'nav-leaf': 'prod-blue.jpg', 'prod-brinjal.jpg', 'prod-cobalt.jpg', 'prod-darkmaroon.jpg', 'prod-green2.jpg', 'prod-indigo.jpg', 'prod-maroon2.jpg' %}{% endcapture %}
                            {% capture leaf_img_src %}{% render 'vamas-nav-icon-src', title: childlink.title, default_asset: leaf_img %}{% endcapture %}
                            <a href="{{ childlink.url }}" class="vamas-nav__icon-item">
                              <span class="vamas-nav__icon-thumb"><img src="{{ leaf_img_src | strip }}" width="56" height="56" alt="" loading="lazy"></span>
                              <span class="vamas-nav__icon-label">{{ childlink.title }}</span>
                            </a>
                          {% endif %}
                        {% endfor %}
                      </div>
                    </div>
                  {% endif %}
                </div>
              </div>
            </div>
          {% else %}
            <a href="{{ link.url }}"{% if link.active %} class="active"{% endif %}>{{ link.title | upcase }}</a>
          {% endif %}
        {% endfor %}
      </div>

      <div class="vamas-nav__icons">
        <a href="{{ routes.search_url }}" id="vamas-search-toggle" title="Search" aria-label="Search">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </a>
        <a href="{{ section.settings.wishlist_url | default: '/pages/wishlist' }}" data-wishlist-drawer-trigger title="Wishlist" aria-label="Wishlist" style="position:relative;">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          <span class="vamas-cart-badge" id="vamas-nav-wish-badge" style="display:none;">0</span>
        </a>
        <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" title="Account" aria-label="Account">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </a>
        <a href="{{ routes.cart_url }}" id="vamas-nav-cart-link" data-cart-drawer-trigger title="Cart" aria-label="Cart" style="position:relative;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
          <span class="vamas-cart-badge" id="vamas-nav-cart-badge" {% if cart.item_count == 0 %}style="display:none;"{% endif %}>{{ cart.item_count }}</span>
        </a>
        <a href="{{ section.settings.contact_url | default: '/pages/contact' }}" class="vamas-nav__contact-btn">{{ section.settings.contact_label | default: 'Contact Us' }}</a>
      </div>
    </div>
  </nav>

  <div class="vamas-nav__mobile-menu" id="vamas-nav-mobile-menu">
    {% for link in section.settings.main_menu.links %}
      <div class="vamas-mobile-item">
        {% if link.links != blank %}
          <button class="vamas-mobile-toggle" type="button">
            <span>{{ link.title | upcase }}</span>
            <span class="vamas-mobile-caret">+</span>
          </button>
          <div class="vamas-mobile-submenu">
            {% for childlink in link.links %}
              <div class="vamas-mobile-item vamas-mobile-item--sub">
                {% if childlink.links != blank %}
                  <button class="vamas-mobile-toggle vamas-mobile-toggle--sub" type="button">
                    <span>{{ childlink.title }}</span>
                    <span class="vamas-mobile-caret">+</span>
                  </button>
                  <div class="vamas-mobile-submenu vamas-mobile-submenu--grand">
                    {% for grandchildlink in childlink.links %}
                      <a href="{{ grandchildlink.url }}">{{ grandchildlink.title }}</a>
                    {% endfor %}
                  </div>
                {% else %}
                  <a href="{{ childlink.url }}" class="vamas-mobile-link--sub">{{ childlink.title }}</a>
                {% endif %}
              </div>
            {% endfor %}
          </div>
        {% else %}
          <a href="{{ link.url }}" class="vamas-mobile-link">{{ link.title | upcase }}</a>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

<div class="vamas-search-overlay" id="vamas-search-overlay">
  <form class="vamas-search-box" action="{{ routes.search_url }}" method="get" role="search">
    <svg class="vamas-search-box__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    <input type="search" name="q" id="vamas-search-input" placeholder="Search for blouses, fabrics, occasions…" autocomplete="off" aria-label="Search"
           {% if section.settings.show_search_suggestions and section.settings.search_suggestion_keywords != blank %}
             data-search-suggestions="{{ section.settings.search_suggestion_keywords | escape }}"
             data-search-suggestion-interval="{{ section.settings.search_suggestion_seconds | default: 2 }}"
           {% endif %}>
    <button type="submit" class="vamas-search-box__submit">SEARCH</button>
    <button type="button" class="vamas-search-box__close" id="vamas-search-close" aria-label="Close search">&times;</button>
  </form>
</div>

<script>
(function(){
  /* Rotating announcement messages */
  var switcher = document.querySelector('[data-announce-switch]');
  if (switcher) {
    var msgs = switcher.querySelectorAll('.vamas-announce__msg');
    if (msgs.length > 1) {
      var idx = 0;
      var delay = (parseFloat(switcher.dataset.interval) || 2) * 1000;
      setInterval(function(){
        msgs[idx].classList.remove('is-active');
        idx = (idx + 1) % msgs.length;
        msgs[idx].classList.add('is-active');
      }, delay);
    }
  }

  var wrap = document.getElementById('vamas-nav-wrapper');
  var btn = document.getElementById('vamas-nav-hamburger');
  if (btn) {
    btn.addEventListener('click', function(){
      wrap.classList.toggle('vamas-nav-mobile-open');
    });
  }
  var toggle = document.getElementById('vamas-search-toggle');
  var overlay = document.getElementById('vamas-search-overlay');
  var close = document.getElementById('vamas-search-close');
  function openSearch(e){ if(e) e.preventDefault(); overlay.classList.add('open'); var i = overlay.querySelector('input'); if(i){ setTimeout(function(){ i.focus(); }, 50); } }
  function closeSearch(){ overlay.classList.remove('open'); }
  if (toggle && overlay) { toggle.addEventListener('click', openSearch); }
  if (close) { close.addEventListener('click', closeSearch); }
  if (overlay) { overlay.addEventListener('click', function(e){ if(e.target === overlay) closeSearch(); }); }
  document.addEventListener('keydown', function(e){ if(e.key === 'Escape' && overlay) closeSearch(); });

  /* Rotate suggested search keywords through the placeholder, so users get
     an idea of what to search (e.g. "Saree", "Blouse", ...) - only while
     the field is empty; stops interfering the moment the user types. */
  var searchInput = document.getElementById('vamas-search-input');
  if (searchInput && searchInput.dataset.searchSuggestions) {
    var keywords = searchInput.dataset.searchSuggestions.split(',').map(function(k){ return k.trim(); }).filter(Boolean);
    if (keywords.length > 1) {
      var basePlaceholder = searchInput.getAttribute('placeholder') || 'Search';
      var kwIdx = 0;
      var kwDelay = (parseFloat(searchInput.dataset.searchSuggestionInterval) || 2) * 1000;
      setInterval(function(){
        if (document.activeElement === searchInput && searchInput.value) return; /* don't fight an in-progress search */
        kwIdx = (kwIdx + 1) % keywords.length;
        searchInput.setAttribute('placeholder', 'Search for "' + keywords[kwIdx] + '"...');
      }, kwDelay);
    }
  }

  document.querySelectorAll('.vamas-mobile-toggle').forEach(function(toggle){
    toggle.addEventListener('click', function(){
      toggle.closest('.vamas-mobile-item').classList.toggle('is-open');
    });
  });

  var navLogo = document.querySelector('.vamas-nav__logo');
  var navBar = document.querySelector('.vamas-nav');

  function positionDropdown(item, dd){
    dd.style.left = '';
    dd.style.right = '';
    dd.style.width = '';
    if (navLogo && navBar) {
      var itemRect = item.getBoundingClientRect();
      var logoRect = navLogo.getBoundingClientRect();
      var navRect = navBar.getBoundingClientRect();
      var offset = logoRect.left - itemRect.left;
      dd.style.left = offset + 'px';
      dd.style.width = (navRect.right - logoRect.left) + 'px';
    }
    var rect = dd.getBoundingClientRect();
    if (rect.right > window.innerWidth - 16) {
      dd.style.left = (parseFloat(dd.style.left || 0) - (rect.right - (window.innerWidth - 16))) + 'px';
    }
  }

  var ddPairs = [];
  document.querySelectorAll('.vamas-nav__item--has-dropdown').forEach(function(item){
    var dd = item.querySelector('.vamas-nav__dropdown');
    if (!dd) return;
    ddPairs.push([item, dd]);
    item.addEventListener('mouseenter', function(){ positionDropdown(item, dd); });
  });

  /* Dropdowns are position:absolute, so even while hidden they still count
     toward the document's scrollable width. Previously they were only
     positioned/clamped on mouseenter, which meant that before any hover the
     right-most menus sat at their unclamped default offset and pushed the
     whole page wider than the viewport (horizontal scroll on every desktop
     page). Position them up front, and again on resize. */
  function positionAll(){ ddPairs.forEach(function(p){ positionDropdown(p[0], p[1]); }); }
  positionAll();
  window.addEventListener('resize', positionAll);
  window.addEventListener('load', positionAll);
})();
</script>

