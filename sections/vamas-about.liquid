{{ 'vamas-theme.css' | asset_url | stylesheet_tag }}

<style>
  .about-hero { background: var(--color-maroon) center/cover; padding: 56px var(--page-gutter) 48px; text-align: center; position: relative; overflow: hidden; }
  {% if section.settings.hero_bg_image != blank %}
    #about-hero-{{ section.id }} { background-image: url('{{ section.settings.hero_bg_image | image_url: width: 1600 }}'); }
  {% endif %}
  {% if section.settings.hero_bg_mobile != blank %}
    @media (max-width: 768px) {
      #about-hero-{{ section.id }} { background-image: url('{{ section.settings.hero_bg_mobile | image_url: width: 900 }}'); }
    }
  {% endif %}
  .about-hero::before { content: ''; position: absolute; inset: 0; background: linear-gradient(rgba(146,68,68,0.45), rgba(146,68,68,0.45)), radial-gradient(ellipse at 50% 0%, rgba(235,211,173,0.08) 0%, transparent 70%); }
  .about-hero__eye { font-size: 10px; font-weight: 700; letter-spacing: 4px; color: rgba(235,211,173,0.45); margin-bottom: 22px; position: relative; z-index: 1; }
  .about-hero__h1 { font-family: var(--font-heading); font-size: 52px; font-weight: 700; color: var(--color-gold); line-height: 1.1; margin-bottom: 16px; position: relative; z-index: 1; }
  .about-hero__sub { font-size: 15px; font-weight: 300; color: rgba(235,211,173,0.75); max-width: 520px; margin: 0 auto 22px; line-height: 1.7; position: relative; z-index: 1; }
  .about-hero__line { width: 80px; height: 2px; background: linear-gradient(90deg, transparent, var(--color-gold), transparent); margin: 0 auto; position: relative; z-index: 1; }

  .about-story { padding: 96px 48px; background: var(--color-bg); }
  .about-story__inner { max-width: none; }
  .about-story__inner::after { content: ''; display: table; clear: both; }
  .about-story__text h3 { font-family: var(--font-heading); font-size: 24px; font-weight: 700; color: var(--color-maroon); margin: 8px 0 14px; clear: both; }
  .about-story__eyebrow { font-size: 10px; font-weight: 700; letter-spacing: 3.5px; color: var(--color-gold-dark); margin-bottom: 18px; text-align: center; }
  .about-story__h2 { font-family: var(--font-heading); font-size: 42px; font-weight: 700; color: var(--color-maroon); line-height: 1.25; margin-bottom: 28px; text-align: center; }
  .about-story__h2 em { font-style: italic; color: var(--color-maroon-light); }
  .about-story__p { font-size: 14px; font-weight: 500; color: rgba(146,68,68,0.65); line-height: 1.9; margin-bottom: 18px; }
  .about-story__p em { font-style: italic; }
  {% comment %} Image floats beside the heading/opening paragraphs only - once the
    text runs past the image's height it naturally continues at the container's
    full width, instead of the whole (very long) story being squeezed into a
    permanent half-width column. {% endcomment %}
  .about-story__img-wrap { float: right; width: 420px; max-width: 42%; margin: 4px 0 32px 56px; position: relative; }
  .about-story__img-blob { position: absolute; inset: 6%; border-radius: 50%; background: radial-gradient(circle, rgba(235,211,173,0.55) 0%, rgba(235,211,173,0.18) 60%, rgba(235,211,173,0) 78%); z-index: 0; }
  .about-story__img { position: relative; z-index: 1; width: 86%; height: auto; max-height: 560px; object-fit: contain; object-position: center; display: block; margin: 0 auto; border-radius: 20px; filter: drop-shadow(0 20px 40px rgba(146,68,68,0.22)); }
  .about-story__img-badge { position: absolute; z-index: 2; bottom: 8%; left: 4%; background: #fff; border-radius: 14px; padding: 10px 18px; box-shadow: 0 10px 28px rgba(146,68,68,0.16); display: flex; flex-direction: column; gap: 2px; }
  .about-story__img-badge-title { font-size: 12px; font-weight: 700; color: var(--color-maroon); }
  .about-story__img-badge-sub { font-size: 10px; color: rgba(146,68,68,0.5); }

  .about-stats { background: var(--color-maroon); display: flex; align-items: center; justify-content: center; gap: 0; }
  .about-stats__item { flex: 1; text-align: center; padding: 52px 40px; border-right: 1px solid rgba(235,211,173,0.12); }
  .about-stats__item:last-child { border-right: none; }
  .about-stats__num { font-family: var(--font-heading); font-size: 44px; font-weight: 700; color: var(--color-gold); line-height: 1; margin-bottom: 10px; }
  .about-stats__label { font-size: 11px; font-weight: 600; letter-spacing: 2px; color: rgba(235,211,173,0.45); text-transform: uppercase; }

  .about-values { padding: 96px var(--page-gutter); background: #fff; text-align: center; }
  .about-eyebrow { font-size: 10px; font-weight: 700; letter-spacing: 3.5px; color: var(--color-gold-dark); margin-bottom: 14px; }
  .about-h2 { font-family: var(--font-heading); font-size: 42px; font-weight: 700; color: var(--color-maroon); line-height: 1.25; margin-bottom: 16px; }
  .about-sub { font-size: 14px; font-weight: 300; color: rgba(146,68,68,0.55); max-width: 520px; margin: 0 auto 60px; line-height: 1.8; }
  .about-values__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; max-width: 1040px; margin: 0 auto; }
  .about-val { background: var(--color-bg); border-radius: 16px; padding: 48px 36px; border: 1px solid rgba(235,211,173,0.35); transition: transform 0.25s, box-shadow 0.25s; }
  .about-val:hover { transform: translateY(-6px); box-shadow: 0 20px 48px rgba(146,68,68,0.10); }
  .about-val__icon { width: 64px; height: 64px; border-radius: 50%; background: var(--color-maroon); display: flex; align-items: center; justify-content: center; margin: 0 auto 24px; }
  .about-val__icon svg { width: 28px; height: 28px; }
  .about-val__title { font-family: var(--font-heading); font-size: 22px; font-weight: 700; color: var(--color-maroon); margin-bottom: 14px; }
  .about-val__desc { font-size: 13px; font-weight: 300; color: rgba(146,68,68,0.6); line-height: 1.8; }

  .about-team { padding: 96px var(--page-gutter); background: var(--color-bg); text-align: center; }
  .about-team__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; max-width: 960px; margin: 0 auto; }
  .about-team__card { background: #fff; border-radius: 16px; padding: 52px 32px; border: 1px solid rgba(235,211,173,0.3); transition: transform 0.25s, box-shadow 0.25s; }
  .about-team__card:hover { transform: translateY(-6px); box-shadow: 0 20px 48px rgba(146,68,68,0.10); }
  .about-team__avatar { width: 128px; height: 128px; border-radius: 50%; background: var(--color-maroon); display: flex; align-items: center; justify-content: center; margin: 0 auto 24px; font-family: var(--font-heading); font-size: 40px; font-weight: 700; color: var(--color-gold); letter-spacing: 1px; overflow: hidden; }
  .about-team__avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .about-team__name { font-family: var(--font-heading); font-size: 20px; font-weight: 700; color: var(--color-maroon); margin-bottom: 6px; }
  .about-team__role { font-size: 10px; font-weight: 700; letter-spacing: 2.5px; color: var(--color-gold-dark); margin-bottom: 14px; text-transform: uppercase; }
  .about-team__bio { font-size: 12px; font-weight: 300; color: rgba(146,68,68,0.6); line-height: 1.8; }

  .about-timeline { padding: 96px var(--page-gutter); background: var(--color-maroon); position: relative; overflow: hidden; }
  .about-timeline::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse at 50% 50%, rgba(235,211,173,0.05) 0%, transparent 70%); }
  .about-timeline .about-eyebrow { color: rgba(235,211,173,0.45); }
  .about-timeline .about-h2 { color: var(--color-gold); }
  .about-timeline .about-sub { color: rgba(235,211,173,0.45); margin-bottom: 72px; }
  .about-tl { position: relative; max-width: 800px; margin: 0 auto; }
  .about-tl::before,
  .about-tl::after { content: ''; position: absolute; left: 50%; top: 0; bottom: 0; width: 2px; transform: translateX(-50%); }
  .about-tl::before { background: rgba(235,211,173,0.15); }
  .about-tl::after {
    background: linear-gradient(var(--color-gold-dark), var(--color-gold));
    transform-origin: top center;
    transform: translateX(-50%) scaleY(var(--progress, 0));
    box-shadow: 0 0 16px rgba(235,211,173,0.5);
    transition: transform 0.1s linear;
  }
  .about-tl__item { display: flex; align-items: flex-start; gap: 140px; margin-bottom: 52px; position: relative; }
  .about-tl__item:last-child { margin-bottom: 0; }
  .about-tl__content { flex: 1; background: rgba(255,255,255,0.05); border: 1px solid rgba(235,211,173,0.12); border-radius: 12px; padding: 24px 28px; }
  .about-tl__item:not(.right) .about-tl__content { text-align: right; }
  .about-tl__item.right .about-tl__content { text-align: left; }
  .about-tl__year { font-family: var(--font-heading); font-size: 32px; font-weight: 700; color: var(--color-gold); margin-bottom: 8px; }
  .about-tl__desc { font-size: 13px; font-weight: 300; color: rgba(235,211,173,0.55); line-height: 1.7; }
  .about-tl__dot { position: absolute; left: 50%; transform: translateX(-50%) scale(0.4); top: 40px; width: 14px; height: 14px; border-radius: 50%; background: var(--color-gold); border: 3px solid var(--color-maroon); box-shadow: 0 0 0 4px rgba(235,211,173,0.15); z-index: 2; transition: transform 0.5s cubic-bezier(.2,.8,.2,1), box-shadow 0.5s; }
  .about-tl__item.revealed .about-tl__dot { transform: translateX(-50%) scale(1); box-shadow: 0 0 0 6px rgba(235,211,173,0.22), 0 0 16px rgba(235,211,173,0.6); }
  .about-tl__spacer { flex: 1; }

  @media (max-width: 1180px) {
    .about-hero { padding: 48px 48px 40px; }
    .about-hero__h1 { font-size: 42px; }
    .about-story { padding: 72px 48px; }
    .about-story__img-wrap { width: 320px; margin-left: 40px; }
    .about-story__h2 { font-size: 34px; }
    .about-values, .about-team, .about-timeline { padding: 72px 48px; }
    .about-values__grid, .about-team__grid { gap: 20px; }
  }
  @media (max-width: 768px) {
    .about-hero { padding: 40px 24px 34px; }
    .about-hero__h1 { font-size: 32px; }
    .about-hero__sub { font-size: 13px; }
    .about-story { padding: 52px 20px; }
    .about-story__img-wrap { float: none; width: 100%; max-width: 100%; margin: 0 0 28px; }
    .about-story__img { height: 320px; }
    .about-story__h2 { font-size: 28px; }
    .about-stats { flex-direction: column; gap: 0; }
    .about-stats__item { border-right: none; border-bottom: 1px solid rgba(235,211,173,0.12); padding: 36px 20px; }
    .about-stats__item:last-child { border-bottom: none; }
    .about-stats__num { font-size: 36px; }
    .about-values, .about-team, .about-timeline { padding: 52px 20px; }
    .about-h2 { font-size: 30px; }
    .about-values__grid { grid-template-columns: 1fr; }
    .about-team__grid { grid-template-columns: 1fr; }
    .about-tl::before { left: 20px; transform: none; }
    .about-tl::after { left: 20px; transform: scaleY(var(--progress, 0)); }
    .about-tl__item, .about-tl__item.right { flex-direction: row; gap: 20px; }
    .about-tl__item:not(.right) .about-tl__content,
    .about-tl__item.right .about-tl__content { text-align: left; }
    .about-tl__dot { left: 20px; top: 34px; }
    .about-tl__item.revealed .about-tl__dot { transform: translateX(-50%) scale(1); }
    .about-tl__spacer { display: none; }
    .about-tl__content { margin-left: 40px; }
    .about-tl__year { font-size: 24px; }
  }

  /* Timeline scroll reveal (enabled by JS; items stay visible if JS is off) */
  .about-tl.reveal-on .about-tl__item { opacity: 0; transition: opacity 0.6s ease, transform 0.6s ease; will-change: opacity, transform; }
  .about-tl.reveal-on .about-tl__item:not(.right) { transform: translate(-48px, 24px); }
  .about-tl.reveal-on .about-tl__item.right { transform: translate(48px, 24px); }
  .about-tl.reveal-on .about-tl__item.revealed { opacity: 1; transform: none; }
  @media (max-width: 768px) {
    .about-tl.reveal-on .about-tl__item:not(.right),
    .about-tl.reveal-on .about-tl__item.right { transform: translate(0, 24px); }
  }
</style>

{% comment %} ── 1. Hero ─────────────────────────── {% endcomment %}
<section class="about-hero" id="about-hero-{{ section.id }}">
  <div class="about-hero__eye">{{ section.settings.hero_eyebrow }}</div>
  <h1 class="about-hero__h1">{{ section.settings.hero_heading }}</h1>
  <p class="about-hero__sub">{{ section.settings.hero_sub }}</p>
  <div class="about-hero__line"></div>
</section>

{% comment %} ── 2. Brand Story ──────────────────── {% endcomment %}
<section class="about-story">
  <div class="about-story__inner">
    <div class="about-story__text">
      <div class="about-story__eyebrow">{{ section.settings.story_eyebrow }}</div>
      <h2 class="about-story__h2">{{ section.settings.story_heading }}</h2>
      <div class="about-story__p">{{ section.settings.story_body }}</div>
    </div>
  </div>
</section>

{% comment %} ── 3. Stats Bar ────────────────────── {% endcomment %}
{% assign stat_blocks = section.blocks | where: 'type', 'stat' %}
{% if stat_blocks.size > 0 %}
<div class="about-stats" data-stats-counter>
  {% for block in section.blocks %}
    {% if block.type == 'stat' %}
      <div class="about-stats__item" {{ block.shopify_attributes }}>
        <div class="about-stats__num" data-count-target="{{ block.settings.stat_num }}">0</div>
        <div class="about-stats__label">{{ block.settings.stat_label }}</div>
      </div>
    {% endif %}
  {% endfor %}
</div>
<script>
(function(){
  var wrap = document.querySelector('.about-stats[data-stats-counter]');
  if (!wrap) return;
  var nums = wrap.querySelectorAll('[data-count-target]');
  var duration = 1500;

  function animateOne(el){
    var raw = el.getAttribute('data-count-target') || '';
    var match = raw.match(/^([\d,]*\.?\d+)/);
    if (!match) { el.textContent = raw; return; }
    var numStr = match[1];
    var suffix = raw.slice(numStr.length);
    var target = parseFloat(numStr.replace(/,/g, ''));
    if (isNaN(target)) { el.textContent = raw; return; }
    var decimals = (numStr.split('.')[1] || '').length;
    var hasCommas = numStr.indexOf(',') > -1;
    var start = null;
    function frame(ts){
      if (!start) start = ts;
      var progress = Math.min((ts - start) / duration, 1);
      var eased = 1 - Math.pow(1 - progress, 3);
      var current = target * eased;
      var text = decimals > 0 ? current.toFixed(decimals) : Math.round(current).toString();
      if (hasCommas) {
        var parts = text.split('.');
        parts[0] = parseInt(parts[0], 10).toLocaleString('en-IN');
        text = parts.join('.');
      }
      el.textContent = text + suffix;
      if (progress < 1) requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  }

  var done = false;
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(entry){
      if (entry.isIntersecting && !done) {
        done = true;
        nums.forEach(animateOne);
        io.disconnect();
      }
    });
  }, { threshold: 0.3 });
  io.observe(wrap);
})();
</script>
{% endif %}

{% comment %} ── 4. Our Values ───────────────────── {% endcomment %}
{% assign value_blocks = section.blocks | where: 'type', 'value' %}
{% if value_blocks.size > 0 %}
<section class="about-values">
  <div class="about-eyebrow">{{ section.settings.values_eyebrow }}</div>
  <h2 class="about-h2">{{ section.settings.values_heading }}</h2>
  <p class="about-sub">{{ section.settings.values_sub }}</p>
  <div class="about-values__grid">
    {% for block in section.blocks %}
      {% if block.type == 'value' %}
        <div class="about-val" {{ block.shopify_attributes }}>
          <div class="about-val__icon">
            {% case block.settings.icon %}
              {% when 'craft' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="{{ settings.color_gold | default: '#EBD3AD' }}" stroke-width="1.8"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              {% when 'sustain' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="{{ settings.color_gold | default: '#EBD3AD' }}" stroke-width="1.8"><path d="M2 22l10-10m0 0l4-4m-4 4L6 6m6 6l4 4m0-14s4 0 4 4-4 4-4 4"/><circle cx="12" cy="7" r="3"/><path d="M20 14s-2 4-8 4-8-4-8-4"/></svg>
              {% else %}
                <svg viewBox="0 0 24 24" fill="none" stroke="{{ settings.color_gold | default: '#EBD3AD' }}" stroke-width="1.8"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            {% endcase %}
          </div>
          <div class="about-val__title">{{ block.settings.title }}</div>
          <div class="about-val__desc">{{ block.settings.desc }}</div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>
{% endif %}

{% comment %} ── 5. Timeline ─────────────────────── {% endcomment %}
{% assign tl_blocks = section.blocks | where: 'type', 'milestone' %}
{% if tl_blocks.size > 0 %}
<section class="about-timeline">
  <div style="text-align:center; position:relative; z-index:1;">
    <div class="about-eyebrow">{{ section.settings.tl_eyebrow }}</div>
    <h2 class="about-h2">{{ section.settings.tl_heading }}</h2>
    <p class="about-sub">{{ section.settings.tl_sub }}</p>
  </div>
  <div class="about-tl" style="position:relative; z-index:1;">
    {% assign ml_index = 0 %}
    {% for block in section.blocks %}
      {% if block.type == 'milestone' %}
        {% assign ml_index = ml_index | plus: 1 %}
        {% assign is_right = ml_index | modulo: 2 %}
        {% if is_right == 0 %}
          <div class="about-tl__item right" {{ block.shopify_attributes }}>
            <div class="about-tl__spacer"></div>
            <div class="about-tl__dot"></div>
            <div class="about-tl__content">
              <div class="about-tl__year">{{ block.settings.year }}</div>
              <div class="about-tl__desc">{{ block.settings.desc }}</div>
            </div>
          </div>
        {% else %}
          <div class="about-tl__item" {{ block.shopify_attributes }}>
            <div class="about-tl__content">
              <div class="about-tl__year">{{ block.settings.year }}</div>
              <div class="about-tl__desc">{{ block.settings.desc }}</div>
            </div>
            <div class="about-tl__dot"></div>
            <div class="about-tl__spacer"></div>
          </div>
        {% endif %}
      {% endif %}
    {% endfor %}
  </div>
</section>
{% endif %}

{% comment %} ── 6. Meet Our Team ────────────────── {% endcomment %}
{% assign team_blocks = section.blocks | where: 'type', 'member' %}
{% if team_blocks.size > 0 %}
<section class="about-team">
  <div class="about-eyebrow">{{ section.settings.team_eyebrow }}</div>
  <h2 class="about-h2">{{ section.settings.team_heading }}</h2>
  <p class="about-sub">{{ section.settings.team_sub }}</p>
  <div class="about-team__grid">
    {% for block in section.blocks %}
      {% if block.type == 'member' %}
        <div class="about-team__card" {{ block.shopify_attributes }}>
          <div class="about-team__avatar">
            {% if block.settings.photo != blank %}
              <img src="{{ block.settings.photo | img_url: '256x256', crop: 'center' }}" alt="{{ block.settings.name | escape }}" loading="lazy" width="128" height="128">
            {% else %}
              {{ block.settings.initials }}
            {% endif %}
          </div>
          <div class="about-team__name">{{ block.settings.name }}</div>
          <div class="about-team__role">{{ block.settings.role }}</div>
          <div class="about-team__bio">{{ block.settings.bio }}</div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>
{% endif %}

<script>
(function(){
  var tl = document.querySelector('.about-tl');
  if (!tl) return;
  var items = Array.prototype.slice.call(tl.querySelectorAll('.about-tl__item'));
  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (reduced || !('IntersectionObserver' in window)) {
    items.forEach(function(item){ item.classList.add('revealed'); });
    tl.style.setProperty('--progress', '1');
    return;
  }

  tl.classList.add('reveal-on');
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if (e.isIntersecting) {
        var i = items.indexOf(e.target);
        e.target.style.transitionDelay = (i % 2 === 0 ? 0 : 90) + 'ms';
        e.target.classList.add('revealed');
        io.unobserve(e.target);
      }
    });
  }, { threshold: 0.15, rootMargin: '0px 0px -10% 0px' });
  items.forEach(function(item){ io.observe(item); });

  var ticking = false;
  function updateProgress(){
    ticking = false;
    var rect = tl.getBoundingClientRect();
    var vh = window.innerHeight;
    var start = vh * 0.5;
    var total = rect.height;
    var filled = Math.min(Math.max(start - rect.top, 0), total);
    tl.style.setProperty('--progress', (total ? filled / total : 0).toFixed(4));
  }
  function onScroll(){
    if (!ticking) { requestAnimationFrame(updateProgress); ticking = true; }
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  updateProgress();
})();
</script>

{% schema %}
{
  "name": "Vamas About",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "hero_eyebrow", "label": "Eyebrow", "default": "WHO WE ARE" },
    { "type": "text", "id": "hero_heading", "label": "Heading", "default": "Our Story" },
    { "type": "textarea", "id": "hero_sub", "label": "Subtext", "default": "Born from a love of Indian craftsmanship, woven with tradition, worn with pride." },
    { "type": "image_picker", "id": "hero_bg_image", "label": "Hero Background Image", "info": "Leave blank to keep the default background." },
    { "type": "image_picker", "id": "hero_bg_mobile", "label": "Hero Background Image (Mobile)", "info": "Shown instead of the image above on phones." },
    { "type": "header", "content": "Brand Story" },
    { "type": "text", "id": "story_eyebrow", "label": "Eyebrow", "default": "OUR STORY" },
    { "type": "richtext", "id": "story_heading", "label": "Heading", "default": "<p>A legacy that began with fabric.<br><em>A journey that found its way to you.</em></p>" },
    { "type": "richtext", "id": "story_body", "label": "Body", "default": "<p>Long before Vamas became a name in readymade blouses, there was a little cloth store, a love for textiles, and a family that believed in doing things with heart.</p><p>Our story began in the early 1960s with <strong>Jalaram Cloth Store</strong>, founded and run by the late Shri Vinodchandra Parekh. What started as a humble textile business slowly became a family legacy\u2014one that would travel across generations.</p><p>In 2009, his son, <strong>Jayesh Parekh</strong>, with the support of his wife <strong>Alka Parekh</strong>, noticed an everyday problem that every saree-loving woman knew too well.</p><p>A saree blouse had to be stitched separately. Find a tailor. Choose a fabric. Explain the design. Wait for it. Try it on. Fix the fitting. And sometimes, even after all that, it still wasn't quite right.</p><p>So we wondered\u2014</p><p><strong>What if finding the perfect blouse could be as easy as finding the perfect saree?</strong></p><p>And that simple thought became <strong>Vamas</strong>.</p><p>We began creating ready-to-wear blouses in a world where almost every blouse was made to order. Different sizes. Beautiful fabrics. Endless colours. Thoughtful designs. All ready to mix, match and make your own.</p><p>From a size 32 to a size 52, we wanted every woman to find a blouse that felt like it was made just for her.</p><p><strong>Because we believe a ready-made blouse should never feel ready-made.</strong></p><p>What began as a wholesale business, supplying ethnic retailers across India and overseas, gradually grew into retail and online. Today, Vamas has five stores across Mumbai and is available through 100+ stores across India and is available on many online platforms too.</p><p>Today, Vamas is looked after by the third generation of the Parekh family\u2014<strong>Chintan Parekh</strong> and <strong>Khushboo Parekh</strong>\u2014carrying forward a legacy that began more than six decades ago.</p><p><strong>Three generations. One love for textiles. And a whole lot of love stitched in between.</strong></p><h3>Our Values</h3><p><strong>Beautiful things begin with the way you make them.</strong></p><p>At Vamas, we believe that what goes into a garment is just as important as what you see.</p><p>We have an undying love for fabrics, textiles and Indian craftsmanship. We obsess over the little things\u2014the fall of a fabric, the softness of a lining, the finishing of a stitch, the comfort of a fit.</p><p>Every Vamas blouse is thoughtfully designed with the woman wearing it in mind.</p><p>Elegant designer fabrics.</p><p>Soft linings.</p><p>Comfortable padding.</p><p>Thoughtful construction.</p><p>Extra margins that allow the blouse to grow with you.</p><p><strong>Because good design shouldn't just look beautiful today. It should stay with you tomorrow.</strong></p><p>And while we love beautiful clothes, we believe fashion should also be kind.</p><p>We consciously use vegan silk because we believe in choosing beauty without compromising kindness.</p><p>We believe in quality without unnecessary extravagance. Our aim has always been to make <strong>designer-wear blouses accessible across sizes, colours, fabrics and patterns\u2014at a reasonable price.</strong></p><p>Most importantly, we believe in people.</p><p>Vamas has been built gradually, stitch by stitch, with the love and hard work of our team and our karigars.</p><p>At Vamas, we deeply value the happiness, dignity and satisfaction of our people. We want the love we have for our team to be visible in the way they welcome you, the way they work, and ultimately, in every blouse that reaches you.</p><p><strong>Take care of your people, and their happiness finds its way into everything they create.</strong></p><p>Customer satisfaction remains at the heart of everything we do.</p><p>Because at the end of the day, the greatest compliment isn't that you bought a Vamas blouse.</p><p><strong>It's that you came back for another.</strong></p><h3>Our Vision</h3><p><strong>To make every woman feel like the blouse was made for her.</strong></p><p>We want Vamas to become the place every woman thinks of when she thinks of a blouse.</p><p>Whatever her size.</p><p>Whatever her style.</p><p>Whatever her saree.</p><p>Whatever her occasion.</p><p>We want her to walk into a Vamas store and think\u2014</p><p><strong>\u201cThere is something here for me.\u201d</strong></p><p>We want to continue bringing the beauty of Indian textiles and contemporary design to women everywhere, while making quality, comfort and thoughtful design accessible to more people.</p><p>And as Vamas grows, we want our impact to grow with us.</p><p>More women empowered.</p><p>More livelihoods supported.</p><p>More opportunities created.</p><p>More Indian textiles celebrated.</p><p>Our dream isn't simply to grow bigger.</p><p><strong>It is to grow better\u2014with every generation</strong>.</p><h3>Our Philosophy</h3><p><strong>A blouse is more than what you wear. It's how you feel when you wear it.</strong></p><p>We don't believe that fashion should ask you to choose between beauty and comfort.</p><p>We believe you deserve both.</p><p>The saree already has its own personality. We don't want the blouse to compete with it. We want it to complete it\u2014sometimes quietly, sometimes boldly, but always with you at the centre.</p><p>We design for every woman who loves to dress her way.</p><p>The woman who loves classics.</p><p>The woman who loves colour.</p><p>The woman who experiments.</p><p>The woman who wants to feel beautiful.</p><p>The woman who simply wants to feel comfortable.</p><p>We believe she shouldn't have to choose between the two.</p><p>Beauty should feel comfortable. Comfort should feel beautiful.</p><p>And perhaps our simplest philosophy is this:</p><p>Don't make women fit the blouse. Make the blouse fit the woman.</p><p><strong>Because at Vamas, our clothes are not meant to define you.</strong></p><p><strong>They are meant to let you shine through.</strong></p><p><strong>Be You. Be Beautiful.</strong></p><h3>And Finally, You.</h3><p>After all these years, generations and thousands of stitches, there is one person at the centre of our story.</p><p><strong>You.</strong></p><p>The woman who walks into our store looking for something for a wedding.</p><p>The woman searching for a blouse for her favourite saree.</p><p>The woman who needs a size 32.</p><p>The woman who needs a size 52.</p><p>The woman who wants something classic.</p><p>The woman who wants something completely different.</p><p>You are the reason we keep designing.</p><p>You are the reason we keep improving.</p><p>You are the reason a little textile legacy from the 1960s became Vamas.</p><p>And as we move into our next generation, we carry with us everything that brought us here\u2014</p><p><strong>the legacy of our family,</strong></p><p><strong>the hands of our karigars,</strong></p><p><strong>the strength of our team,</strong></p><p><strong>our love for textiles,</strong></p><p><strong>and the women who have trusted us over the years.</strong></p><p>Because Vamas was never meant to be just a blouse brand.</p><p><strong>It was built to make beautiful things easier.</strong></p><p><strong>To make women feel good.</strong></p><p><strong>To create with purpose.</strong></p><p><strong>And to carry a little piece of our love for Indian textiles into your wardrobe.</strong></p><p><strong>With love</strong></p><p><strong>VAMAS</strong></p>" },
