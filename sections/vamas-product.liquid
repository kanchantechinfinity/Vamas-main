{{ 'vamas-product.css' | asset_url | stylesheet_tag }}

<div class="breadcrumb">
  <a href="{{ routes.root_url }}">Home</a>
  <span>&#8250;</span>
  <a href="{{ product.collections.first.url | default: routes.all_products_collection_url }}">{{ product.collections.first.title | default: 'Collections' }}</a>
  <span>&#8250;</span>
  <span>{{ product.title }}</span>
</div>

{% assign current_variant = product.selected_or_first_available_variant %}
{% assign product_type_lower = product.type | downcase %}
{% assign is_kids_product = false %}
{% if product_type_lower contains 'kid' %}{% assign is_kids_product = true %}{% endif %}

<section class="product-section">

  <!-- ═══ LEFT: Gallery ═══ -->
  <div class="prod-gallery">
    {% if product.images.size > 1 %}
    <div class="thumb-strip" id="thumb-strip">
      {% for image in product.images %}
        <div class="thumb-item{% if forloop.first %} active{% endif %}" data-idx="{{ forloop.index0 }}" data-src="{{ image | img_url: '1000x' }}">
          <img src="{{ image | img_url: '200x' }}" alt="{{ image.alt | default: product.title | escape }}">
        </div>
      {% endfor %}
    </div>
    {% endif %}
    <div class="gallery-main" id="gallery-main">
      <img id="main-img" src="{{ current_variant.featured_image | default: product.featured_image | img_url: '1000x' }}" alt="{{ product.title | escape }}">
      {% if section.settings.badge_text != blank %}<div class="gallery-badge">{{ section.settings.badge_text }}</div>{% endif %}
      {% if product.images.size > 1 %}
        <button class="gal-arrow gal-arrow-l" id="gal-prev">&#8249;</button>
        <button class="gal-arrow gal-arrow-r" id="gal-next">&#8250;</button>
      {% endif %}
      <div class="zoom-hint">&#128269; Click to zoom</div>
    </div>
  </div>

  <!-- ═══ RIGHT: Product Info ═══ -->
  <div class="prod-info">

    <div class="prod-badge-row">
      {% if section.settings.badge_text != blank %}<span class="prod-badge">{{ section.settings.badge_text }}</span>{% endif %}
      {% if section.settings.badge_hot_text != blank %}<span class="prod-badge-hot">&#128293; {{ section.settings.badge_hot_text }}</span>{% endif %}
      {% comment %} Wishlist sits with the badges rather than far below the buy
        buttons, where it was easy to miss. {% endcomment %}
      <a href="#" class="wishlist-link" id="wishlist-btn"
         data-id="{{ product.id }}"
         data-handle="{{ product.handle }}"
         data-title="{{ product.title | escape }}"
         data-type="{{ product.type | escape | default: 'Blouse' }}"
         data-price="{{ product.selected_or_first_available_variant.price | money | replace: 'Rs. ', '₹' }}"
         data-image="{{ product.featured_image | img_url: '400x533', crop: 'center' }}"
         data-url="{{ product.url }}"
         data-variant="{{ product.selected_or_first_available_variant.id }}">&#9825; Add to Wishlist</a>
    </div>
    <h1 class="prod-name">{{ product.title }}</h1>
    <div class="prod-type">{{ section.settings.subtitle }}</div>

    {% if section.settings.show_rating %}
    <div class="prod-rating">
      {%- comment -%} Real reviews via Judge.me only - no placeholder numbers.
        This is Judge.me's standard preview-badge div (not the
        .metafields.judgeme.badge metafield, which needs metafield sync
        turned on in the app's settings to ever populate). Judge.me's script
        fills this with the real star average + count, or renders nothing
        visible if the product has no reviews yet - either way it's driven
        by real data, not a Liquid guess. {%- endcomment -%}
      <span class="jdgm-widget jdgm-preview-badge" data-id="{{ product.id }}" data-rating="0" data-number-of-reviews="0"></span>
      <a href="#reviews" style="font-size:11px;color:var(--gd);text-decoration:none;margin-left:4px;">Read reviews &#8595;</a>
      {% if section.settings.sold_count != blank %}<span class="rating-sold">| {{ section.settings.sold_count }} sold</span>{% endif %}
    </div>
    {% endif %}

    <div class="prod-price" id="prod-price-block">
      <span class="price-now" id="price-now">{{ current_variant.price | money | replace: 'Rs. ', '₹' }}</span>
      {% if current_variant.compare_at_price > current_variant.price %}
        <span class="price-old" id="price-old">{{ current_variant.compare_at_price | money | replace: 'Rs. ', '₹' }}</span>
        <span class="price-off" id="price-off">{{ current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round }}% off</span>
      {% endif %}
    </div>

    {% if section.settings.offer_code != blank %}
    <div class="offer-strip">
      <span class="offer-tag">OFFER</span>
      <span class="offer-text">Use code <span class="offer-code" id="coupon-code" title="Click to copy">{{ section.settings.offer_code }}</span> for <strong>{{ section.settings.offer_detail }}</strong></span>
      <span class="offer-copied" id="offer-copied">Copied!</span>
    </div>
    {% endif %}

    {% if section.settings.show_social_proof %}
    <div class="social-proof">
      <span class="social-dot"></span>
      <span id="viewer-count">{{ section.settings.viewer_count }}</span> people are viewing this right now
    </div>
    {% endif %}

    <div class="prod-divider"></div>

    {% comment %} ── Variant Picker ── {% endcomment %}
    <product-form>
    {% form 'product', product %}
      <input type="hidden" name="id" id="variant-id-input" value="{{ current_variant.id }}">

      {% comment %}
        Per-colour thumbnail, same idea as the product-card swatches: the first
        variant photo found for each colour, so the PDP selector can show a
        compact image swatch instead of a flat colour circle. Single pass over
        this product's own variants (cheap - only one product on this page).
        "~colourkey~<url>§~colourkey2~<url2>§"
      {% endcomment %}
      {% assign pdp_color_img_map = '' %}
      {% for option in product.options_with_values %}
        {% assign pdp_option_down = option.name | downcase %}
        {% if pdp_option_down contains 'colour' or pdp_option_down contains 'color' %}
          {% assign pdp_color_option_idx = forloop.index0 %}
          {% for v in product.variants %}
            {% if v.featured_image %}
              {% assign pdp_v_color = v.options[pdp_color_option_idx] %}
              {% if pdp_v_color != blank %}
                {% assign pdp_v_key = pdp_v_color | downcase | strip | replace: ' ', '' | replace: '-', '' %}
                {% assign pdp_v_probe = '~' | append: pdp_v_key | append: '~' %}
                {% unless pdp_color_img_map contains pdp_v_probe %}
                  {% assign pdp_v_thumb = v.featured_image | image_url: width: 120 %}
                  {% assign pdp_color_img_map = pdp_color_img_map | append: pdp_v_probe | append: pdp_v_thumb | append: '§' %}
                {% endunless %}
              {% endif %}
            {% endif %}
          {% endfor %}
        {% endif %}
      {% endfor %}

      {% for option in product.options_with_values %}
        {%- comment -%} This option's own index, taken before any values loop starts.
          Inside a values loop forloop.index0 counts VALUES, so comparing against
          current_variant.options[forloop.index0] matched the wrong option and
          nothing ever showed as selected. Assigned here so the colour and size
          branches below both read the right one. {%- endcomment -%}
        {%- assign opt_idx = forloop.index0 -%}
        {% assign option_down = option.name | downcase %}
        {% if option_down contains 'colour' or option_down contains 'color' %}
          <div class="color-section">
            <div class="selector-label">SELECT {{ option.name | upcase }}</div>
            <div class="color-swatches" data-option-index="{{ forloop.index0 }}">
              {% assign pdp_swatch_seen_keys = '' %}
              {% for value in option.values %}
                {% assign swatch_hex = '' %}
                {% for sw in section.blocks %}
                  {% if sw.type == 'color_swatch' and sw.settings.name == value %}{% assign swatch_hex = sw.settings.hex %}{% endif %}
                {% endfor %}
                {% if swatch_hex == blank %}
                  {% capture swatch_hex %}{% render 'vamas-color-hex', name: value %}{% endcapture %}
                  {% assign swatch_hex = swatch_hex | strip %}
                {% endif %}
                {% unless swatch_hex == 'SKIP' %}
                  {% assign pdp_dedup_key = value | downcase | strip | replace: ' ', '' | replace: '-', '' | prepend: '|' | append: '|' %}
                  {% unless pdp_swatch_seen_keys contains pdp_dedup_key %}
                    {% assign pdp_swatch_thumb = '' %}
                    {% assign pdp_swatch_key = value | downcase | strip | replace: ' ', '' | replace: '-', '' %}
                    {% assign pdp_swatch_probe = '~' | append: pdp_swatch_key | append: '~' %}
                    {% if pdp_color_img_map contains pdp_swatch_probe %}
                      {% assign pdp_swatch_thumb = pdp_color_img_map | split: pdp_swatch_probe | last | split: '§' | first %}
                    {% endif %}
                    {% if pdp_swatch_thumb != '' %}
                      <img class="swatch swatch--img{% if value == current_variant.options[opt_idx] %} active{% endif %}"
                           src="{{ pdp_swatch_thumb }}"
                           data-value="{{ value | escape }}" alt="{{ value | escape }}" title="{{ value | escape }}"
                           loading="lazy" width="120" height="150">
                    {% else %}
                      <div class="swatch{% if value == current_variant.options[opt_idx] %} active{% endif %}"
                           style="background:{{ swatch_hex }};"
                           data-value="{{ value | escape }}" title="{{ value | escape }}"></div>
                    {% endif %}
                    {% assign pdp_swatch_seen_keys = pdp_swatch_seen_keys | append: pdp_dedup_key %}
                  {% endunless %}
                {% endunless %}
              {% endfor %}
            </div>
            <div class="color-name-label">{{ option.name }}: <strong id="color-name-text">{{ current_variant.options[opt_idx] }}</strong></div>
          </div>
        {% elsif option_down contains 'size' %}
          <div class="size-section">
            <div class="size-label-row">
              <div class="selector-label">SELECT {{ option.name | upcase }}</div>
              {% if section.settings.show_size_chart %}<a href="#" class="size-chart-link" id="size-chart-link">Size Chart &#8594;</a>{% endif %}
            </div>
            <div class="size-buttons" data-option-index="{{ forloop.index0 }}">
              {% for value in option.values %}
                {% capture size_label %}{% render 'vamas-blouse-size-label', size_value: value, is_kids: is_kids_product %}{% endcapture %}
                <button type="button" class="size-btn{% if value == current_variant.options[opt_idx] %} active{% endif %}" data-value="{{ value | escape }}">{{ size_label | strip }}</button>
              {% endfor %}
            </div>
            <div class="stock-row">
              <div class="stock-label" id="stock-label">
                {% if current_variant.inventory_management == 'shopify' and current_variant.inventory_quantity <= 5 and current_variant.available %}
                  &#9889; Only {{ current_variant.inventory_quantity }} left — hurry!
                {% elsif current_variant.available %}
                  &#10003; In stock
                {% else %}
                  Out of stock
                {% endif %}
              </div>
              <div class="stock-track"><div class="stock-fill"></div></div>
            </div>
          </div>
        {% else %}
          <div class="size-section">
            <div class="selector-label">{{ option.name | upcase }}</div>
            <div class="size-buttons" data-option-index="{{ forloop.index0 }}">
              {% for value in option.values %}
                <button type="button" class="size-btn{% if value == current_variant.options[opt_idx] %} active{% endif %}" data-value="{{ value | escape }}">{{ value }}</button>
              {% endfor %}
            </div>
          </div>
        {% endif %}
      {% endfor %}

      <div class="qty-row">
        <span class="qty-label">QUANTITY</span>
        <div class="qty-control">
          <button type="button" class="qty-btn" id="qty-minus">&#8722;</button>
          <span class="qty-num" id="qty-num">1</span>
          <button type="button" class="qty-btn" id="qty-plus">&#43;</button>
          <input type="hidden" name="quantity" id="qty-hidden-input" value="1">
        </div>
      </div>

      <div class="atc-buy-row">
        <button type="submit" class="btn-atc" id="atc-btn"{% unless current_variant.available %} disabled{% endunless %}>
          {% if current_variant.available %}ADD TO CART{% else %}SOLD OUT{% endif %}
        </button>
        {% comment %} BUY NOW and NOTIFY ME occupy the same slot - a sold-out variant
          has nothing to buy, so offering a back-in-stock alert is the only useful
          action left. The swap is repeated in JS for variant changes. {% endcomment %}
        <button type="button" class="btn-buy" id="buy-btn"{% unless current_variant.available %} hidden{% endunless %}>&#9889; BUY NOW</button>
        <button type="button" class="btn-notify" id="notify-btn"{% if current_variant.available %} hidden{% endif %}>&#128276; NOTIFY ME</button>
      </div>


      <div class="delivery-box">
        {% if section.settings.delivery_line_1 != blank %}<div class="delivery-row"><span class="d-icon">&#128666;</span><span>{{ section.settings.delivery_line_1 }}</span></div>{% endif %}
        {% if section.settings.delivery_line_2 != blank %}<div class="delivery-row"><span class="d-icon">&#128197;</span><span>{{ section.settings.delivery_line_2 }}</span></div>{% endif %}
        {% if section.settings.delivery_line_3 != blank %}<div class="delivery-row"><span class="d-icon">&#8635;</span><span>{{ section.settings.delivery_line_3 }}</span></div>{% endif %}
        {% if section.settings.show_pincode %}
        <div class="pincode-form">
          <input class="pincode-input" id="pincode-input" type="text" maxlength="6" placeholder="Enter pincode to check delivery">
          <button type="button" class="pincode-btn" id="pincode-btn">CHECK</button>
        </div>
        <div class="pincode-result" id="pincode-result"></div>
        {% endif %}
      </div>
    {% endform %}

      {% comment %} Back-in-stock request. There is no back-in-stock app on this store,
        so the request goes through Shopify's own contact form - it reaches the shop
        inbox with the product and variant attached, and needs no third party. {% endcomment %}
      <div class="notify-modal" id="notify-modal" aria-hidden="true">
        <div class="notify-modal__overlay" data-notify-close></div>
        <div class="notify-modal__panel" role="dialog" aria-modal="true" aria-labelledby="notify-title">
          <button type="button" class="notify-modal__close" data-notify-close aria-label="Close">&times;</button>
          <h3 class="notify-modal__title" id="notify-title">NOTIFY ME</h3>
          {% form 'contact', id: 'notify-form', class: 'notify-form' %}
            {% if form.posted_successfully? %}
              <p class="notify-modal__ok">&#10003; Thank you — we'll email you the moment this is back in stock.</p>
            {% else %}
              <p class="notify-modal__sub">Leave your email and we'll tell you as soon as <strong>{{ product.title }}</strong> is back.</p>
              {% if form.errors %}
                <p class="notify-modal__err">{{ form.errors | default_errors }}</p>
              {% endif %}
              <input type="hidden" name="contact[Request]" value="Back in stock alert">
              <input type="hidden" name="contact[Product]" value="{{ product.title | escape }}">
              <input type="hidden" name="contact[Product URL]" value="{{ shop.url }}{{ product.url }}">
              <input type="hidden" name="contact[Variant]" id="notify-variant" value="{{ current_variant.title | escape }}">
              <input type="hidden" name="contact[body]" value="Please notify me when this product is back in stock.">
              <label class="notify-modal__label" for="notify-email">Email address</label>
              <input type="email" id="notify-email" name="contact[email]" required autocomplete="email" placeholder="you@example.com">
              <button type="submit" class="btn-atc notify-modal__submit">NOTIFY ME</button>
            {% endif %}
          {% endform %}
        </div>
      </div>
    </product-form>

    {% if section.settings.show_payment_strip %}
    {% comment %} Share sits on the same line as the payment badges - both are
      trailing details, and two half-empty rows read worse than one. {% endcomment %}
    <div class="payment-strip">
      <span class="pay-badge">UPI</span><span class="pay-badge">Visa</span><span class="pay-badge">Mastercard</span>
      <span class="pay-badge">Net Banking</span><span class="pay-badge">COD</span>

      <div class="share-row">
        <span class="share-label">Share:</span>
        <button class="share-btn" id="share-wa" title="Share on WhatsApp">
          <svg width="16" height="16" viewBox="0 0 32 32" fill="#25D366"><path d="M16 3C8.832 3 3 8.832 3 16c0 2.625.77 5.074 2.086 7.129L3.05 28.855 9 26.875C10.973 28.023 13.41 29 16 29c7.168 0 13-5.832 13-13S23.168 3 16 3zm0 2c6.086 0 11 4.914 11 11s-4.914 11-11 11c-2.324 0-4.48-.766-6.25-2.063l-.399-.297-3.586.945.992-2.843-.334-.426A10.945 10.945 0 0 1 5 16C5 9.914 9.914 5 16 5zm-4.695 4.852c-.196 0-.504.07-.766.36-.261.292-1 .977-1 2.437s1.063 2.824 1.211 3.028c.148.203 2.121 3.351 5.199 4.585 2.547 1.032 3.082.844 3.656.793.574-.055 1.856-.719 2.106-1.41.25-.695.25-1.285.176-1.41-.074-.125-.277-.199-.578-.348-.3-.148-1.758-.863-2.035-.961-.277-.101-.477-.152-.676.149-.2.297-.773.961-.949 1.16-.176.2-.351.223-.652.075-.3-.149-1.282-.466-2.437-1.496-.9-.813-1.508-1.813-1.684-2.114-.176-.305-.02-.469.133-.617.136-.133.3-.348.45-.52.148-.175.197-.3.296-.5.098-.199.05-.372-.026-.52-.074-.149-.625-1.617-.875-2.207-.25-.574-.5-.492-.676-.5a12.71 12.71 0 0 0-.574-.008 1.1 1.1 0 0 0-.25 0z"/></svg>
        </button>
        <button class="share-btn" id="share-copy" title="Copy link">&#128279;</button>
      </div>
    </div>
    {% endif %}

    {% if section.settings.show_trust_grid %}
    <div class="trust-grid">
      <div class="trust-item"><span class="trust-icon">&#10003;</span><span>100% Authentic Handcrafted</span></div>
      <div class="trust-item"><span class="trust-icon">&#128666;</span><span>Free Shipping &gt; {{ section.settings.free_shipping_threshold }}</span></div>
      <div class="trust-item"><span class="trust-icon">&#8635;</span><span>7-Day Easy Returns</span></div>
      <div class="trust-item"><span class="trust-icon">&#128274;</span><span>100% Secure Payment</span></div>
      <div class="trust-item"><span class="trust-icon">&#127470;&#127475;</span><span>Made in India</span></div>
    </div>
    {% endif %}

    <div class="accordion">
      {% assign detail_rows = section.blocks | where: 'type', 'detail_row' %}
      {%- comment -%}
        Every label here maps to a product metafield (Settings > Custom data >
        Products, namespace "custom"). No hardcoded fallback text any more - a
        row only renders when the PRODUCT's own metafield is filled in, so a
        product nobody has entered specs for shows no fake data instead of
        someone else's fabric/neckline. Rows with a blank metafield are skipped
        entirely rather than printing an empty cell.
      {%- endcomment -%}
      {%- assign detail_meta_map = "Style Name:style_name|Fabric:fabric|Work:work|Blouse Type:blouse_type|Neck Style:neck_style|Sleeve Length:sleeve_length|Lining:lining|Closure:closure|Care:care_instructions|Origin:origin" | split: '|' -%}
      {%- assign filled_rows = '' -%}
      {%- for block in detail_rows -%}
        {%- assign row_value = '' -%}
        {%- for pair in detail_meta_map -%}
          {%- assign pair_parts = pair | split: ':' -%}
          {%- if pair_parts.first == block.settings.label -%}
            {%- assign row_value = product.metafields.custom[pair_parts.last].value -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if row_value != blank -%}
          {%- assign filled_rows = filled_rows | append: block.settings.label | append: '¤' | append: row_value | append: '§' -%}
        {%- endif -%}
      {%- endfor -%}
      {%- assign filled_rows = filled_rows | split: '§' -%}
      <div class="acc-item open">
        <div class="acc-header">PRODUCT DETAILS <span class="acc-icon">&#8722;</span></div>
        <div class="acc-body">
          <div class="acc-content">
            {% if filled_rows.size > 0 %}
            <table class="detail-table">
              <tbody>
                {% for entry in filled_rows %}
                {%- assign entry_parts = entry | split: '¤' -%}
                <tr class="detail-row">
                  <td class="detail-label">{{ entry_parts.first }}</td>
                  <td class="detail-value">{{ entry_parts.last }}</td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
            {% else %}
              {{ product.description }}
            {% endif %}
          </div>
        </div>
      </div>

      {% assign size_rows = section.blocks | where: 'type', 'size_row' %}
      {% if size_rows.size > 0 %}
      <div class="acc-item" id="acc-size">
        <div class="acc-header">MEASUREMENTS &amp; SIZING <span class="acc-icon">+</span></div>
        <div class="acc-body">
          <div class="acc-content">
            <p style="margin-bottom:10px;font-size:11px;color:#888;">All measurements are in inches. If between sizes, choose the larger size.</p>
            <table class="size-table">
              <thead><tr><th>Size</th><th>Bust</th><th>Waist</th><th>Hip</th><th>Length</th></tr></thead>
              <tbody id="size-table-body">
                {% for block in size_rows %}
                <tr data-size="{{ block.settings.size }}"{% if block.settings.size == current_variant.options[1] %} class="highlight"{% endif %}>
                  <td>{{ block.settings.size }}</td><td>{{ block.settings.bust }}</td><td>{{ block.settings.waist }}</td><td>{{ block.settings.hip }}</td><td>{{ block.settings.length }}</td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </div>
      {% endif %}

      {% assign care_items = section.blocks | where: 'type', 'care_item' %}
      {% if care_items.size > 0 %}
      <div class="acc-item">
        <div class="acc-header">CARE INSTRUCTIONS <span class="acc-icon">+</span></div>
        <div class="acc-body">
          <div class="acc-content">
            <div class="care-grid">
              {% for block in care_items %}
              <div class="care-item"><div class="care-icon-wrap">{{ block.settings.icon }}</div><div class="care-label">{{ block.settings.label }}</div></div>
              {% endfor %}
            </div>
            {% if section.settings.care_note != blank %}<div class="care-note">&#128161; {{ section.settings.care_note }}</div>{% endif %}
          </div>
        </div>
      </div>
      {% endif %}

      {% if section.settings.shipping_returns_text != blank %}
      <div class="acc-item">
        <div class="acc-header">SHIPPING &amp; RETURNS <span class="acc-icon">+</span></div>
        <div class="acc-body"><div class="acc-content">{{ section.settings.shipping_returns_text }}</div></div>
      </div>
      {% endif %}
    </div>
  </div>
</section>

{% comment %} ── Related Products: this product's own collection first (genuinely related), falling back to a random spread of 4 from the full catalog ── {% endcomment %}
{% assign related_blocks = section.blocks | where: 'type', 'related_product' %}
{% assign rel_col = product.collections.first %}
{% if rel_col == blank or rel_col.products.size < 2 %}{% assign rel_col = collections[section.settings.related_collection] %}{% endif %}
{% if rel_col == blank or rel_col.products.size < 2 %}{% assign rel_col = collections.all %}{% endif %}
{% if related_blocks.size > 0 or rel_col.products.size > 0 %}
<section class="related-section">
  <div class="rel-eyebrow">YOU MAY ALSO LIKE</div>
  <h2 class="rel-heading">{{ section.settings.related_heading | default: 'More Handcrafted Beauties' }}</h2>
  <div class="vamas-prod-grid">
    {% if related_blocks.size > 0 %}
      {% for block in related_blocks %}
        {% assign rp = block.settings.product %}
        {% if rp != blank %}
          {% render 'vamas-product-card', product: rp %}
        {% endif %}
      {% endfor %}
    {% else %}
      {% assign rel_total = rel_col.products.size %}
      {% assign rel_offset = 0 %}
      {% if rel_total > 4 %}{% assign rel_offset = product.id | modulo: rel_total %}{% endif %}
      {% assign rel_shown = 0 %}
      {% for i in (0..49) %}
        {% if rel_shown >= 4 %}{% break %}{% endif %}
        {% assign rel_idx = i | plus: rel_offset | modulo: rel_total %}
        {% assign rp = rel_col.products[rel_idx] %}
        {% if rp != blank and rp.id != product.id %}
          {% assign rel_shown = rel_shown | plus: 1 %}
          {% render 'vamas-product-card', product: rp %}
        {% endif %}
        {% if i >= rel_total %}{% break %}{% endif %}
      {% endfor %}
    {% endif %}
  </div>
</section>
{% endif %}

{% comment %} ── Reviews ──
  Real customer reviews via Judge.me only - the hand-typed placeholder
  reviews, star-percentage bars, and non-functional "Write a Review" button
  that used to render here are gone.

  This is Judge.me's standard widget div, not the .metafields.judgeme.widget
  metafield - that metafield only populates once a product already HAS a
  review, so gating on it left no way for a customer to write the FIRST
  review. This div always renders; Judge.me's own script (loaded via its App
  Embed - must be turned on in Theme Editor > App embeds) finds it and fills
  in the summary, existing reviews if any, and a working "write a review"
  form even at zero reviews. {% endcomment %}
<section class="reviews-section" id="reviews">
  <h2 class="rev-heading">Customer Reviews</h2>
  <div id="judgeme_product_reviews" class="jdgm-widget jdgm-review-widget" data-id="{{ product.id }}">{{ product.metafields.judgeme.widget }}</div>
</section>

{% if section.settings.show_size_chart %}
<div class="sc-overlay" id="sc-overlay">
  <div class="sc-modal">
    <div class="sc-head">
      <span class="sc-title">SIZE CHART</span>
      <div class="sc-toggle">
        <button class="sc-toggle-btn active" id="btn-inch">INCHES</button>
        <button class="sc-toggle-btn" id="btn-cm">CM</button>
      </div>
      <button class="sc-close" id="sc-close">&times;</button>
    </div>
    <div class="sc-body">
      {% comment %}
        Vamas's own padded-blouse chart. Measurements run down the side and sizes
        across the top, matching the printed chart the team works from, so the two
        can be checked against each other line by line.

        The numeric sizes sold on site ARE the chest measurement - 32 is XS, 42 is
        XXL - so both labels sit in the header rather than making shoppers guess.
      {% endcomment %}
      {% assign sc_letters = 'XS,S,M,L,XL,XXL' | split: ',' %}
      {% assign sc_numeric = '32,34,36,38,40,42' | split: ',' %}
      {% assign sc_rows = 'CHEST:32,34,36,38,40,42|LENGTH:13,13.5,14,14.5,14.5,15|WAIST:26,28,30,32,34,36|SHORT SLEEVE:5,5,5,5.5,5.5,6.5|ELBOW SLEEVE:10,10.5,11,11,11,11|3/4 SLEEVE:16,16,16,16,17,17|FULL SLEEVE:21,21,21,21,21,22' | split: '|' %}

      {% comment %} Diagram first, then the chart, then the notes - the same running
        order as the printed sheet. {% endcomment %}
      <div class="sc-measure sc-measure--top">
        <h4 class="sc-measure__title">PADDED BLOUSE MEASUREMENT</h4>
        {% comment %} The drawing from the brand's own chart, traced out of the PDF as
          vector paths so it stays sharp at any size and weighs ~7KB. A merchant image
          overrides it if the artwork is ever redrawn. {% endcomment %}
        {% if section.settings.measure_image != blank %}
          <img class="sc-measure__img" src="{{ section.settings.measure_image | image_url: width: 900 }}" alt="How to measure a padded blouse" loading="lazy">
        {% else %}
          <div class="sc-measure__figure">
            <img class="sc-measure__img sc-measure__img--diagram" src="{{ 'vamas-measure-diagram.svg' | asset_url }}" alt="How to measure a padded blouse: chest, waist, length and sleeve length" loading="lazy">
          </div>
        {% endif %}
      </div>

      <p class="sc-hint">Measure your body, not a garment. Between two sizes? Take the larger one.</p>

      <div class="sc-table-wrap">
        <table class="sc-table">
          <thead>
            <tr>
              <th>SIZE</th>
              {% for l in sc_letters %}
                <th>{{ l }}<span class="sc-num">{{ sc_numeric[forloop.index0] }}</span></th>
              {% endfor %}
            </tr>
          </thead>
          <tbody>
            {% for row in sc_rows %}
              {% assign parts = row | split: ':' %}
              {% assign vals = parts[1] | split: ',' %}
              <tr>
                <th scope="row">{{ parts[0] }}</th>
                {% for v in vals %}
                  <td class="sc-val" data-in="{{ v }}" data-cm="{{ v | times: 2.54 | round: 1 }}">{{ v }}</td>
                {% endfor %}
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      <ul class="sc-fineprint">
        <li>All garments come with <strong>1.5 inches seam allowance</strong> on both sides.</li>
        <li>You can easily open up the margin to fit your size.</li>
        <li>Measurements may vary depending on fabric and pattern.</li>
      </ul>

      {% comment %} Written steps sit after the sheet's own content - they are extra
        guidance for shoppers, not part of the printed chart. {% endcomment %}
      <div class="sc-measure">
        <h4 class="sc-measure__title">HOW TO MEASURE</h4>
        <ol class="sc-measure__list">
          <li><strong>Chest</strong> — around the fullest part of the bust, tape level and snug, not tight.</li>
          <li><strong>Waist</strong> — around the narrowest part of the torso, just above the navel.</li>
          <li><strong>Length</strong> — from the shoulder seam straight down to where you want the blouse to end.</li>
          <li><strong>Sleeve length</strong> — from the shoulder seam down the outside of the arm to the sleeve end.</li>
        </ol>
        <p class="sc-measure__tip">Use a soft measuring tape and keep it parallel to the floor. Measure over your innerwear, not over clothing.</p>
      </div>
    </div>
  </div>
</div>
{% endif %}

<div class="lightbox" id="lightbox">
  <button class="lb-arrow lb-prev" id="lb-prev">&#8249;</button>
  <img id="lb-img" src="" alt="Zoomed view">
  <button class="lb-arrow lb-next" id="lb-next">&#8250;</button>
  <button class="lb-close" id="lb-close">&times;</button>
</div>

{% comment %}
  Sticky bottom bar. Two states sharing one bar:
   - default: this product + price + ADD TO CART
   - once the cart has items: a "YOUR CART" summary (thumb, item count, total)
     that goes to the cart instead. Rebuilt from /cart.js so it stays correct
     after adds, quantity changes, or landing on the page with a full cart.
{% endcomment %}
<div class="sticky-atc" id="sticky-atc">
  <div class="sticky-atc__state" id="sticky-atc-product">
    <div class="sticky-thumb"><img src="{{ current_variant.featured_image | default: product.featured_image | img_url: '100x' }}" alt="{{ product.title | escape }}"></div>
    <div class="sticky-info">
      <div class="sticky-name">{{ product.title }}</div>
      <div class="sticky-price" id="sticky-price">{{ current_variant.price | money | replace: 'Rs. ', '₹' }}</div>
    </div>
    <button class="sticky-btn" id="sticky-atc-btn"{% unless current_variant.available %} disabled{% endunless %}>{% if current_variant.available %}ADD TO CART{% else %}SOLD OUT{% endif %}</button>
  </div>

  <a href="{{ routes.cart_url }}" class="sticky-atc__state sticky-atc__cart" id="sticky-atc-cart" style="display:none;">
    <div class="sticky-thumb"><img id="sticky-cart-thumb" src="{{ current_variant.featured_image | default: product.featured_image | img_url: '100x' }}" alt=""></div>
    <div class="sticky-info">
      <div class="sticky-cart-label">YOUR CART</div>
      <div class="sticky-name" id="sticky-cart-name"></div>
      <div class="sticky-price" id="sticky-cart-total"></div>
    </div>
    <span class="sticky-btn sticky-btn--cart">VIEW CART</span>
  </a>
</div>

<script>
(function() {
  var product = {{ product | json }};
  var variants = product.variants;
  var mainImg = document.getElementById('main-img');
  var variantInput = document.getElementById('variant-id-input');
  var atcBtn = document.getElementById('atc-btn');
  var stickyBtn = document.getElementById('sticky-atc-btn');
  var buyBtn = document.getElementById('buy-btn');

  /* Shopify.formatMoney isn't guaranteed to be loaded on every page (requires
     shopify_common.js) — use a local implementation so variant switching never
     silently throws and aborts before updating the image/price/ATC state. */
  function vamasFormatMoney(cents, format) {
    if (typeof cents === 'string') { cents = cents.replace('.', ''); }
    function withDelimiters(number, precision, thousands, decimalSep) {
      precision = (typeof precision === 'undefined') ? 2 : precision;
      thousands = (typeof thousands === 'undefined') ? ',' : thousands;
      decimalSep = (typeof decimalSep === 'undefined') ? '.' : decimalSep;
      if (isNaN(number) || number == null) { return 0; }
      number = (number / 100.0).toFixed(precision);
      var parts = number.split('.');
      var dollars = parts[0].replace(/(\d)(?=(\d{3})+(?!\d))/g, '$1' + thousands);
      var centsPart = parts[1] ? decimalSep + parts[1] : '';
      return dollars + centsPart;
    }
    var formatString = format || '${{amount}}';
    var placeholderRegex = /\{\{\s*(\w+)\s*\}\}/;
    var match = formatString.match(placeholderRegex);
    var key = match ? match[1] : 'amount';
    var value;
    switch (key) {
      case 'amount_no_decimals': value = withDelimiters(cents, 0); break;
      case 'amount_with_comma_separator': value = withDelimiters(cents, 2, '.', ','); break;
      case 'amount_no_decimals_with_comma_separator': value = withDelimiters(cents, 0, '.', ','); break;
      default: value = withDelimiters(cents, 2);
    }
    return match ? formatString.replace(placeholderRegex, value) : formatString + value;
  }

  function getSelectedOptions() {
    var opts = [];
    document.querySelectorAll('[data-option-index]').forEach(function(group) {
      var idx = parseInt(group.dataset.optionIndex, 10);
      var active = group.querySelector('.active');
      opts[idx] = active ? active.dataset.value : null;
    });
    return opts;
  }

  function findVariant(opts) {
    for (var i = 0; i < variants.length; i++) {
      var v = variants[i];
      var match = true;
      for (var j = 0; j < opts.length; j++) {
        if (opts[j] && v.options[j] !== opts[j]) { match = false; break; }
      }
      if (match) return v;
    }
    return null;
  }

  function colorOptionIndex() {
    var idx = null;
    document.querySelectorAll('[data-option-index]').forEach(function(group) {
      if (group.querySelector('.swatch')) idx = parseInt(group.dataset.optionIndex, 10);
    });
    return idx;
  }

  function imageForVariant(v) {
    if (v.featured_image) return v.featured_image;
    var cIdx = colorOptionIndex();
    if (cIdx === null) return null;
    var color = v.options[cIdx];
    for (var i = 0; i < variants.length; i++) {
      if (variants[i].options[cIdx] === color && variants[i].featured_image) {
        return variants[i].featured_image;
      }
    }
    return null;
  }

  function applyVariant(v) {
    if (!v) return;
    variantInput.value = v.id;
    document.getElementById('price-now').textContent = vamasFormatMoney(v.price, {{ shop.money_format | replace: 'Rs. ', '₹' | json }});
    var priceOld = document.getElementById('price-old');
    if (priceOld) {
      if (v.compare_at_price && v.compare_at_price > v.price) {
        priceOld.style.display = '';
        priceOld.textContent = vamasFormatMoney(v.compare_at_price, {{ shop.money_format | replace: 'Rs. ', '₹' | json }});
      } else {
        priceOld.style.display = 'none';
      }
    }
    document.getElementById('sticky-price').textContent = vamasFormatMoney(v.price, {{ shop.money_format | replace: 'Rs. ', '₹' | json }});
    var img = imageForVariant(v);
    if (img) {
      mainImg.src = img.src.replace(/(\.[a-zA-Z0-9]+)$/, '_1000x$1');
      document.querySelector('.sticky-thumb img').src = img.src.replace(/(\.[a-zA-Z0-9]+)$/, '_100x$1');
    }
    var available = v.available;
    [atcBtn, stickyBtn].forEach(function(b){ if(b){ b.disabled = !available; } });
    if (atcBtn) atcBtn.textContent = available ? 'ADD TO CART' : 'SOLD OUT';
    if (stickyBtn) stickyBtn.textContent = available ? 'ADD TO CART' : 'SOLD OUT';

    /* BUY NOW and NOTIFY ME share the slot beside ADD TO CART: whichever one the
       shopper can actually act on is the one shown. */
    var notifyBtn = document.getElementById('notify-btn');
    if (buyBtn) buyBtn.hidden = !available;
    if (notifyBtn) notifyBtn.hidden = available;
    var notifyVariant = document.getElementById('notify-variant');
    if (notifyVariant) notifyVariant.value = v.title || '';
  }

  /* Back-in-stock modal */
  (function(){
    var modal = document.getElementById('notify-modal');
    if (!modal) return;
    var openBtn = document.getElementById('notify-btn');
    function open(){ modal.classList.add('is-open'); modal.setAttribute('aria-hidden','false');
      var f = document.getElementById('notify-email'); if (f) f.focus(); }
    function close(){ modal.classList.remove('is-open'); modal.setAttribute('aria-hidden','true'); }
    if (openBtn) openBtn.addEventListener('click', open);
    modal.querySelectorAll('[data-notify-close]').forEach(function(el){ el.addEventListener('click', close); });
    document.addEventListener('keydown', function(e){ if (e.key === 'Escape') close(); });
    /* Shopify bounces back to ?contact_posted=true after the form is sent, so the
       confirmation is only visible if the modal reopens itself on that return. */
    if (/[?&]contact_posted=true/.test(location.search)) open();
  })();

  document.querySelectorAll('.swatch, .size-btn').forEach(function(el) {
    el.addEventListener('click', function() {
      var group = this.closest('[data-option-index]');
      group.querySelectorAll('.swatch, .size-btn').forEach(function(x){ x.classList.remove('active'); });
      this.classList.add('active');
      if (this.classList.contains('swatch')) {
        var label = document.getElementById('color-name-text');
        if (label) label.textContent = this.dataset.value;
      }
      var v = findVariant(getSelectedOptions());
      if (v) applyVariant(v);
    });
  });

  /* Quantity */
  var qty = 1;
  var qtyNum = document.getElementById('qty-num');
  var qtyHidden = document.getElementById('qty-hidden-input');
  document.getElementById('qty-minus').addEventListener('click', function(){ if(qty>1){ qty--; qtyNum.textContent=qty; qtyHidden.value=qty; } });
  document.getElementById('qty-plus').addEventListener('click', function(){ if(qty<10){ qty++; qtyNum.textContent=qty; qtyHidden.value=qty; } });

  /* Buy now: add then redirect to real Shopify checkout */
  if (buyBtn) {
    buyBtn.addEventListener('click', function() {
      window.VamasCart.add({ id: variantInput.value, quantity: qty }).then(function(){
        window.location.href = '/checkout';
      });
    });
  }

  /* Gallery arrows / thumbs */
  var thumbs = document.querySelectorAll('.thumb-item');
  var curIdx = 0;
  function setGalleryImg(idx) {
    if (!thumbs.length) return;
    curIdx = (idx + thumbs.length) % thumbs.length;
    mainImg.src = thumbs[curIdx].dataset.src;
    thumbs.forEach(function(t,i){ t.classList.toggle('active', i === curIdx); });
  }
  var galPrev = document.getElementById('gal-prev');
  var galNext = document.getElementById('gal-next');
  if (galPrev) galPrev.addEventListener('click', function(e){ e.stopPropagation(); setGalleryImg(curIdx-1); });
  if (galNext) galNext.addEventListener('click', function(e){ e.stopPropagation(); setGalleryImg(curIdx+1); });
  thumbs.forEach(function(t){ t.addEventListener('click', function(){ setGalleryImg(parseInt(this.dataset.idx,10)); }); });

  /* Swipe the main image on a phone.

     This gallery only ever had arrow buttons and thumbnails - no touch handling
     at all - so swiping the big photo did nothing. Worse, a tap here opens the
     lightbox, so a swipe that the browser rounded to a tap opened it instead of
     changing the photo.

     The first few pixels decide the axis: horizontal changes the photo and takes
     the gesture, vertical is left alone so the page still scrolls. A real swipe
     also suppresses the click that follows, so the lightbox stays shut. */
  (function(){
    var gal = document.getElementById('gallery-main');
    if (!gal || thumbs.length < 2) return;
    var t0 = null;
    gal.addEventListener('touchstart', function(e){
      if (e.touches.length !== 1) return;
      t0 = { x: e.touches[0].clientX, y: e.touches[0].clientY, axis: null, dx: 0 };
    }, { passive: true });

    gal.addEventListener('touchmove', function(e){
      if (!t0 || e.touches.length !== 1) return;
      var dx = e.touches[0].clientX - t0.x, dy = e.touches[0].clientY - t0.y;
      if (!t0.axis) {
        if (Math.abs(dx) < 8 && Math.abs(dy) < 8) return;
        t0.axis = Math.abs(dx) > Math.abs(dy) ? 'x' : 'y';
      }
      if (t0.axis !== 'x') return;
      t0.dx = dx;
      if (e.cancelable) e.preventDefault();
    }, { passive: false });

    gal.addEventListener('touchend', function(){
      if (!t0) return;
      var dx = t0.dx, axis = t0.axis;
      t0 = null;
      if (axis !== 'x' || Math.abs(dx) < 40) return;
      setGalleryImg(dx < 0 ? curIdx + 1 : curIdx - 1);
      var kill = function(ev){ ev.preventDefault(); ev.stopPropagation(); };
      document.addEventListener('click', kill, { capture: true, once: true });
    }, { passive: true });
  })();

  /* Lightbox */
  var lightbox = document.getElementById('lightbox');
  var galleryMain = document.getElementById('gallery-main');
  if (lightbox && galleryMain) {
    var lbImg = document.getElementById('lb-img');
    var zoomed = false, panX = 0, panY = 0, dragging = false, startX = 0, startY = 0;
    var ZOOM = 2.4;

    /* The gallery renders a _1000x thumbnail. Opening that same file at full
       screen is not a zoom - strip the size suffix so the lightbox gets the
       original upload and there is real detail to look at. */
    function fullRes(src){ return src.replace(/_(\d+)x(\d+)?(_crop_[a-z]+)?(?=\.[a-zA-Z0-9]+(\?|$))/, ''); }

    function applyTransform(){
      lbImg.style.transform = zoomed
        ? 'translate(' + panX + 'px,' + panY + 'px) scale(' + ZOOM + ')'
        : '';
    }
    function resetZoom(){ zoomed = false; panX = panY = 0; lbImg.classList.remove('is-zoomed','is-panning'); applyTransform(); }
    function show(src){ lbImg.src = fullRes(src); resetZoom(); }
    function openLb(){ show(mainImg.src); lightbox.classList.add('open'); document.body.classList.add('lightbox-open'); }
    function closeLb(){ lightbox.classList.remove('open'); document.body.classList.remove('lightbox-open'); resetZoom(); }

    galleryMain.addEventListener('click', openLb);
    document.getElementById('lb-close').addEventListener('click', closeLb);
    lightbox.addEventListener('click', function(e){ if (e.target === lightbox) closeLb(); });
    document.addEventListener('keydown', function(e){ if (e.key === 'Escape' && lightbox.classList.contains('open')) closeLb(); });
    document.getElementById('lb-prev').addEventListener('click', function(e){ e.stopPropagation(); setGalleryImg(curIdx-1); show(mainImg.src); });
    document.getElementById('lb-next').addEventListener('click', function(e){ e.stopPropagation(); setGalleryImg(curIdx+1); show(mainImg.src); });

    /* Second tap magnifies; drag pans while magnified. */
    lbImg.addEventListener('click', function(e){
      e.stopPropagation();
      if (dragging) return;
      zoomed = !zoomed;
      panX = panY = 0;
      lbImg.classList.toggle('is-zoomed', zoomed);
      applyTransform();
    });
    lbImg.addEventListener('pointerdown', function(e){
      if (!zoomed) return;
      dragging = false; startX = e.clientX - panX; startY = e.clientY - panY;
      lbImg.setPointerCapture(e.pointerId);
      lbImg.classList.add('is-panning');
    });
    lbImg.addEventListener('pointermove', function(e){
      if (!zoomed || !lbImg.hasPointerCapture(e.pointerId)) return;
      var nx = e.clientX - startX, ny = e.clientY - startY;
      if (Math.abs(nx - panX) > 2 || Math.abs(ny - panY) > 2) dragging = true;
      panX = nx; panY = ny;
      applyTransform();
    });
    lbImg.addEventListener('pointerup', function(e){
      lbImg.classList.remove('is-panning');
      if (lbImg.hasPointerCapture(e.pointerId)) lbImg.releasePointerCapture(e.pointerId);
      setTimeout(function(){ dragging = false; }, 0);
    });
  }

  /* Size chart modal */
  var scOverlay = document.getElementById('sc-overlay');
  if (scOverlay) {
    var link = document.getElementById('size-chart-link');
    /* The sticky ATC bar outranked this overlay too, so it covered the bottom of
       the chart on phones - the body class hides it while the popup is up. */
    function scOpen(){ scOverlay.classList.add('open'); document.body.classList.add('sc-open'); document.body.style.overflow='hidden'; }
    function scClose(){ scOverlay.classList.remove('open'); document.body.classList.remove('sc-open'); document.body.style.overflow=''; }
    if (link) link.addEventListener('click', function(e){ e.preventDefault(); scOpen(); });
    document.getElementById('sc-close').addEventListener('click', scClose);
    scOverlay.addEventListener('click', function(e){ if(e.target===scOverlay) scClose(); });
    document.addEventListener('keydown', function(e){ if (e.key === 'Escape' && scOverlay.classList.contains('open')) scClose(); });
    document.getElementById('btn-inch').addEventListener('click', function(){ applyUnit('in'); });
    document.getElementById('btn-cm').addEventListener('click', function(){ applyUnit('cm'); });
    function applyUnit(unit) {
      document.querySelectorAll('.sc-val').forEach(function(td){ td.textContent = unit==='cm' ? td.dataset.cm : td.dataset.in; });
      document.getElementById('btn-inch').classList.toggle('active', unit==='in');
      document.getElementById('btn-cm').classList.toggle('active', unit==='cm');
    }
  }

  /* Pincode (UI-only) */
  var pinBtn = document.getElementById('pincode-btn');
  if (pinBtn) {
    pinBtn.addEventListener('click', function(){
      var val = document.getElementById('pincode-input').value.trim();
      var res = document.getElementById('pincode-result');
      if (/^\d{6}$/.test(val)) {
        res.className = 'pincode-result ok';
        res.textContent = '✓ Delivery available to ' + val + ' in 4–5 business days.';
      } else {
        res.className = 'pincode-result err';
        res.textContent = 'Please enter a valid 6-digit pincode.';
      }
    });
  }

  /* Coupon copy */
  var couponEl = document.getElementById('coupon-code');
  if (couponEl) {
    couponEl.addEventListener('click', function(){
      var code = this.textContent;
      navigator.clipboard && navigator.clipboard.writeText(code);
      var copied = document.getElementById('offer-copied');
      copied.style.display = 'inline';
      setTimeout(function(){ copied.style.display = 'none'; }, 2000);
    });
  }

  /* Wishlist */
  var wishBtn = document.getElementById('wishlist-btn');
  if (wishBtn) {
    var wid = wishBtn.dataset.id;
    function syncWish(){
      if (!window.VamasWishlist) return;
      var saved = window.VamasWishlist.has(wid);
      wishBtn.innerHTML = saved ? '♥ Saved to Wishlist' : '♡ Add to Wishlist';
      wishBtn.classList.toggle('active', saved);
    }
    wishBtn.addEventListener('click', function(e){
      e.preventDefault();
      if (!window.VamasWishlist) return;
      window.VamasWishlist.toggle({
        id: wid, handle: wishBtn.dataset.handle, title: wishBtn.dataset.title,
        type: wishBtn.dataset.type, price: wishBtn.dataset.price,
        image: wishBtn.dataset.image, url: wishBtn.dataset.url, variant: wishBtn.dataset.variant
      });
      syncWish();
    });
    window.addEventListener('load', syncWish);
    syncWish();
  }

  /* Share */
  var shareWa = document.getElementById('share-wa');
  if (shareWa) shareWa.addEventListener('click', function(){
    window.open('https://wa.me/?text=' + encodeURIComponent('Check out ' + product.title + ' — ' + window.location.href), '_blank');
  });
  var shareCopy = document.getElementById('share-copy');
  if (shareCopy) shareCopy.addEventListener('click', function(){
    navigator.clipboard && navigator.clipboard.writeText(window.location.href);
    this.textContent = '✓';
    var self = this;
    setTimeout(function(){ self.textContent = '🔗'; }, 1800);
  });

  /* Accordion */
  document.querySelectorAll('.acc-header').forEach(function(h) {
    h.addEventListener('click', function() {
      var item = this.parentElement;
      var isOpen = item.classList.contains('open');
      document.querySelectorAll('.acc-item').forEach(function(x){ x.classList.remove('open'); var i=x.querySelector('.acc-icon'); if(i) i.textContent='+'; });
      if (!isOpen) { item.classList.add('open'); this.querySelector('.acc-icon').textContent = '−'; }
    });
  });

  /* Sticky ATC visibility */
  var stickyBar = document.getElementById('sticky-atc');
  if (stickyBar && atcBtn) {
    window.addEventListener('scroll', function() {
      var rect = atcBtn.getBoundingClientRect();
      stickyBar.classList.toggle('visible', rect.bottom < 0);
    }, { passive: true });
  }

  /* Park the bar directly above the mobile bottom nav rather than under it.
     The nav is fixed at z-index 9990, so a bar at bottom:0 had its button
     completely covered. Measured at runtime since the nav is mobile-only. */
  if (stickyBar) {
    var setBotnavOffset = function(){
      var nav = document.querySelector('.vamas-botnav');
      var h = (nav && getComputedStyle(nav).display !== 'none') ? nav.offsetHeight : 0;
      stickyBar.style.setProperty('--vamas-botnav-h', h + 'px');
    };
    /* The bottom nav is rendered by theme.liquid AFTER this section, so it does
       not exist yet while this script runs - measuring now would always yield 0.
       Wait for the full document before measuring. */
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', setBotnavOffset);
    else setBotnavOffset();
    window.addEventListener('load', setBotnavOffset);
    window.addEventListener('resize', setBotnavOffset);
    window.addEventListener('orientationchange', setBotnavOffset);
  }

  /* Once the cart has something in it, the sticky bar becomes a cart summary
     ("YOUR CART" + item + total) instead of another ADD TO CART. Driven off
     /cart.js so it's right on first load too, not just after an add. */
  var stickyProductState = document.getElementById('sticky-atc-product');
  var stickyCartState = document.getElementById('sticky-atc-cart');
  function renderStickyCart(cart){
    if (!stickyProductState || !stickyCartState) return;
    if (!cart || !cart.items || !cart.items.length) {
      stickyProductState.style.display = '';
      stickyCartState.style.display = 'none';
      return;
    }
    var first = cart.items[0];
    var thumb = document.getElementById('sticky-cart-thumb');
    if (thumb && first.image) thumb.src = first.image;
    var nameEl = document.getElementById('sticky-cart-name');
    if (nameEl) {
      nameEl.textContent = cart.item_count === 1
        ? first.product_title
        : first.product_title + ' + ' + (cart.item_count - 1) + ' more';
    }
    var totalEl = document.getElementById('sticky-cart-total');
    if (totalEl) totalEl.textContent = vamasFormatMoney(cart.total_price, {{ shop.money_format | replace: 'Rs. ', '₹' | json }});
    stickyProductState.style.display = 'none';
    stickyCartState.style.display = '';
  }
  function refreshStickyCart(){
    fetch('/cart.js').then(function(r){ return r.json(); }).then(renderStickyCart).catch(function(){});
  }
  refreshStickyCart();
  document.addEventListener('vamas:cartAdded', refreshStickyCart);

  /* Real add-to-cart via product form */
  document.querySelectorAll('product-form form').forEach(function(form) {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      var formData = { id: variantInput.value, quantity: parseInt(qtyHidden.value, 10) || 1 };
      window.VamasCart.add(formData).then(function() {
        atcBtn.textContent = '✓ ADDED TO CART!';
        atcBtn.classList.add('added');
        setTimeout(function(){ atcBtn.textContent = 'ADD TO CART'; atcBtn.classList.remove('added'); }, 1800);
      });
    });
  });
  if (stickyBtn) stickyBtn.addEventListener('click', function(){
    window.VamasCart.add({ id: variantInput.value, quantity: parseInt(qtyHidden.value,10)||1 });
  });

  var revBars = document.getElementById('rev-bars');
  if (revBars && 'IntersectionObserver' in window) {
    var barObserver = new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        if (entry.isIntersecting) {
          entry.target.querySelectorAll('.rev-bar-track').forEach(function(track){ track.classList.add('animated'); });
          barObserver.disconnect();
        }
      });
    }, { threshold: 0.3 });
    barObserver.observe(revBars);
  }

})();
</script>

