<div class="vamas-auth">
  <div class="vamas-auth__card">
    <h1 class="vamas-auth__title">Login</h1>
    <p class="vamas-auth__subtitle">Welcome back! Sign in to continue.</p>

    {% form 'customer_login' %}
      {% if form.errors %}
        <div class="vamas-auth__error">{{ form.errors.messages.first }}</div>
      {% endif %}
      <div class="vamas-auth__field">
        <label for="CustomerEmail">Email</label>
        <input type="email" name="customer[email]" id="CustomerEmail" autocomplete="email" required>
      </div>
      <div class="vamas-auth__field">
        <label for="CustomerPassword">Password</label>
        <input type="password" name="customer[password]" id="CustomerPassword" autocomplete="current-password" required>
      </div>
      <button type="submit" class="btn-primary vamas-auth__submit">SIGN IN</button>
    {% endform %}

    <details class="vamas-auth__forgot">
      <summary>Forgot your password?</summary>
      {% form 'recover_customer_password' %}
        {% if form.posted_successfully? %}
          <div class="vamas-auth__success">If that email address exists in our system, you will receive an email with instructions on how to reset your password.</div>
        {% endif %}
        {% if form.errors %}
          <div class="vamas-auth__error">{{ form.errors.messages.first }}</div>
        {% endif %}
        <div class="vamas-auth__field">
          <label for="RecoverEmail">Email</label>
          <input type="email" name="email" id="RecoverEmail" autocomplete="email" required>
        </div>
        <button type="submit" class="btn-outline vamas-auth__submit">RESET PASSWORD</button>
      {% endform %}
    </details>

    <p class="vamas-auth__switch">New customer? <a href="{{ routes.account_register_url }}">Create account</a></p>
  </div>
</div>
{% schema %}{ "name": "Customer Login", "settings": [] }{% endschema %}
