{{ 'vamas-collection.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  On the /collections list page there is no single collection - show all products.
  Test the handle, NOT products_count: on a tag route that matches nothing (say
  /collections/the-plain-edit/size-48) the count is 0, and falling back there
  replaced an honest "no products" with all 100, which reads as a broken filter.
{%- endcomment -%}
{%- unless collection.handle != blank -%}
  {%- assign collection = collections.all -%}
{%- endunless -%}

{%- comment -%}
  Sleeve/Neckline/Size are native Search & Discovery filters (set up by the
  merchant, not hardcoded like Occasion/Fabric below) - detect them by label
  so the tabs below render once they exist, and stay empty/hidden until then.
{%- endcomment -%}
{%- assign sleeve_filter = blank -%}
{%- assign neckline_filter = blank -%}
{%- assign size_filter = blank -%}
{%- assign availability_filter = blank -%}
{%- assign color_filter = blank -%}
{%- for filter in collection.filters -%}
  {%- assign filter_label_down = filter.label | downcase -%}
  {%- if filter_label_down contains 'sleeve' -%}{%- assign sleeve_filter = filter -%}{%- endif -%}
  {%- if filter_label_down contains 'neck' -%}{%- assign neckline_filter = filter -%}{%- endif -%}
  {%- if filter_label_down contains 'size' -%}{%- assign size_filter = filter -%}{%- endif -%}
  {%- if filter_label_down contains 'vail' -%}{%- assign availability_filter = filter -%}{%- endif -%}
  {%- if filter_label_down contains 'colo' -%}{%- assign color_filter = filter -%}{%- endif -%}
{%- endfor -%}

{%- comment -%}
  Size, three ways, in order of preference:

    1. size_filter        - the native Search & Discovery filter. Best option;
                            used verbatim when the merchant enables it.
    2. size-NN tags       - Shopify's built-in tag routes (/collections/x/size-46)
                            filter server-side with no app involved, so this is a
                            real working bypass while (1) is off.
    3. size_list setting  - neither exists yet, so render the known sizes as
                            placeholders pointing at filter.v.option.size. They do
                            nothing until (1) is switched on, but they keep the row
                            from vanishing and upgrade themselves automatically.

  Note filter.v.option.size is SILENTLY IGNORED unless the Size filter is enabled
  in Search & Discovery - the URL is accepted and the product count never changes.
  That is why (2) exists.
{%- endcomment -%}
{%- comment -%}
  Vamas sells numbered sizes only (32-50). Some products still carry M/L/XL/XXL
  on their SIZE option from an old import; those are bad data, so every tier
  below keeps numeric values only rather than showing sizes the brand does not
  sell. `| times: 1` yields 0 for anything non-numeric, which is the test.
{%- endcomment -%}
{%- assign size_tag_list = '' -%}
{%- for t in collection.all_tags -%}
  {%- assign t_head = t | downcase | slice: 0, 5 -%}
  {%- if t_head == 'size-' -%}
    {%- assign t_num = t | remove_first: 'size-' | remove_first: 'SIZE-' | times: 1 -%}
    {%- if t_num > 0 -%}
      {%- assign size_tag_list = size_tag_list | append: t | append: ',' -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- comment -%}
  On /collections/all Shopify returns only a short slice of all_tags, so the
  bigger sizes go missing from the row even though their tag routes work. The
  catalog carries every numeric size, so fall back to the configured list there.
{%- endcomment -%}
{%- if collection.handle == blank or collection.handle == 'all' -%}
  {%- if section.settings.size_list != blank -%}
    {%- assign size_tag_list = '' -%}
    {%- assign size_list_values = section.settings.size_list | split: ',' -%}
    {%- for s in size_list_values -%}
      {%- assign s_clean = s | strip -%}
      {%- assign s_num = s_clean | times: 1 -%}
      {%- if s_num > 0 -%}
        {%- assign size_tag_list = size_tag_list | append: 'size-' | append: s_clean | append: ',' -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endif -%}
{%- assign size_tags = size_tag_list | split: ',' -%}

{%- comment -%} Tags already on screen that aren't sizes, so picking a size adds to
  the sleeve/neckline choice instead of throwing it away. {%- endcomment -%}
{%- assign size_other_tags = '' -%}
{%- assign active_size_tag = '' -%}
{%- for ct in current_tags -%}
  {%- assign ct_head = ct | downcase | slice: 0, 5 -%}
  {%- if ct_head == 'size-' -%}
    {%- assign active_size_tag = ct -%}
  {%- else -%}
    {%- assign size_other_tags = size_other_tags | append: ct | append: '+' -%}
  {%- endif -%}
{%- endfor -%}
{%- assign size_base_url = collection.url -%}
{%- if size_other_tags != '' -%}
  {%- assign size_other_path = size_other_tags | split: '+' | join: '+' -%}
  {%- assign size_base_url = collection.url | append: '/' | append: size_other_path -%}
{%- endif -%}

{% if section.settings.hero_bg_image != blank or section.settings.hero_bg_mobile != blank %}
<style>
  {% if section.settings.hero_bg_image != blank %}
    #col-hero-{{ section.id }} { background-image: url('{{ section.settings.hero_bg_image | image_url: width: 1600 }}'); }
  {% endif %}
  {% if section.settings.hero_bg_mobile != blank %}
    @media (max-width: 768px) {
      #col-hero-{{ section.id }} { background-image: url('{{ section.settings.hero_bg_mobile | image_url: width: 900 }}'); }
    }
  {% endif %}
</style>
{% endif %}
<section class="col-hero" id="col-hero-{{ section.id }}">
  <div class="col-hero-left">
    <div class="col-hero-breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span>&gt;</span>
      <span style="color:rgba(235,211,173,.75);">{{ collection.title }}</span>
    </div>
    <h1 class="col-hero-title">{{ collection.title }}</h1>
    <p class="col-hero-sub">{{ section.settings.hero_subtitle | default: collection.description | strip_html | default: 'Handcrafted designs celebrating Indian artistry' }}</p>
  </div>
  {% if section.settings.show_hero_motif %}
  <div class="col-hero-right">
    <svg width="320" height="200" viewBox="0 0 320 200" fill="none" xmlns="http://www.w3.org/2000/svg">
      <ellipse cx="80" cy="100" rx="40" ry="60" stroke="#EBD3AD" stroke-width="1.5" fill="none" transform="rotate(-20 80 100)"/>
      <ellipse cx="80" cy="100" rx="24" ry="40" stroke="#EBD3AD" stroke-width="1" fill="none" transform="rotate(-20 80 100)"/>
      <circle cx="80" cy="68" r="8" stroke="#EBD3AD" stroke-width="1.2" fill="none"/>
      <circle cx="80" cy="68" r="3" fill="#EBD3AD" opacity=".4"/>
      <ellipse cx="200" cy="80" rx="35" ry="52" stroke="#EBD3AD" stroke-width="1.5" fill="none" transform="rotate(15 200 80)"/>
      <ellipse cx="200" cy="80" rx="20" ry="34" stroke="#EBD3AD" stroke-width="1" fill="none" transform="rotate(15 200 80)"/>
      <circle cx="215" cy="50" r="7" stroke="#EBD3AD" stroke-width="1.2" fill="none"/>
      <circle cx="160" cy="110" r="18" stroke="#EBD3AD" stroke-width="1.2" fill="none" opacity=".5"/>
      <circle cx="160" cy="110" r="8" stroke="#c9a96e" stroke-width="1" fill="none" opacity=".5"/>
      <circle cx="160" cy="110" r="3" fill="#EBD3AD" opacity=".4"/>
    </svg>
  </div>
  {% endif %}
</section>

{%- comment -%} Mobile-only collection header: title, count {%- endcomment -%}
<div class="col-mhead">
  <h1 class="col-mhead__title">{{ collection.title }}</h1>
  <div class="col-mhead__count">
    {{ collection.products_count }} Products
    <div class="col-mhead__views" role="group" aria-label="Grid size">
      <button type="button" class="col-mhead__view" data-cols="1" aria-label="One per row">
        <svg viewBox="0 0 24 24" fill="currentColor"><rect x="4" y="4" width="16" height="16" rx="2"/></svg>
      </button>
      <button type="button" class="col-mhead__view is-active" data-cols="2" aria-label="Two per row">
        <svg viewBox="0 0 24 24" fill="currentColor"><rect x="3" y="3" width="8" height="8" rx="1.5"/><rect x="13" y="3" width="8" height="8" rx="1.5"/><rect x="3" y="13" width="8" height="8" rx="1.5"/><rect x="13" y="13" width="8" height="8" rx="1.5"/></svg>
      </button>
    </div>
  </div>
</div>

{%- comment -%}
  Sub-category tabs for the parent categories (THE PLAIN EDIT, FESTIVE GLAM, ...).

  A sub-category is its own COLLECTION. The tabs appear on the parent and on every
  child, with the one you are looking at marked active, so a shopper can move
  across siblings without going back up.

  The mapping lives in one section setting because every collection shares this
  template: one line per parent, "parent-handle | child-handle, child-handle".
  Labels come from each collection's own title, so renaming a collection in admin
  renames its tab.
{%- endcomment -%}
{%- assign subcat_parent = '' -%}
{%- assign subcat_children = '' -%}
{%- if section.settings.subcat_map != blank -%}
  {%- assign subcat_lines = section.settings.subcat_map | newline_to_br | split: '<br />' -%}
  {%- for line in subcat_lines -%}
    {%- assign parts = line | split: '|' -%}
    {%- if parts.size >= 2 -%}
      {%- assign line_parent = parts[0] | strip | downcase -%}
      {%- assign line_children = parts[1] | split: ',' -%}
      {%- comment -%} match the parent itself... {%- endcomment -%}
      {%- if line_parent == collection.handle -%}
        {%- assign subcat_parent = line_parent -%}
        {%- assign subcat_children = line_children -%}
      {%- endif -%}
      {%- comment -%} ...or any of its children, so the row follows you down {%- endcomment -%}
      {%- for c in line_children -%}
        {%- assign c_handle = c | strip | downcase -%}
        {%- if c_handle == collection.handle -%}
          {%- assign subcat_parent = line_parent -%}
          {%- assign subcat_children = line_children -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- if subcat_children != '' and subcat_children.size > 0 -%}
  {%- assign parent_col = collections[subcat_parent] -%}
  <nav class="col-subcats" aria-label="Sub-categories">
    <a href="/collections/{{ subcat_parent }}" class="col-subcat{% if collection.handle == subcat_parent %} is-active{% endif %}">
      {{ parent_col.title | default: 'ALL' | upcase }}
    </a>
    {% for c in subcat_children %}
      {% assign c_handle = c | strip | downcase %}
      {% if c_handle != '' %}
        {% assign child = collections[c_handle] %}
        {%- comment -%} A handle that has no collection yet would render a dead tab,
          so only list the ones that actually exist. {%- endcomment -%}
        {% if child != blank and child.handle %}
          <a href="{{ child.url }}" class="col-subcat{% if collection.handle == c_handle %} is-active{% endif %}">{{ child.title | upcase }}</a>
        {% endif %}
      {% endif %}
    {% endfor %}
  </nav>
{%- endif -%}

{%- comment -%}
  Sticky mobile/responsive filter+sort toolbar.
  Row 1: ALL SIZES (only renders once a Size filter is set up in Search & Discovery).
  Row 2: FILTERS | FEATURED tabs - mutually exclusive panels, don't interfere.
  Row 3 (inside Filters): SLEEVE | NECKLINE | COLOR | FABRIC | PRICE | AVAILABILITY | OCCASION sub-tabs.
{%- endcomment -%}
<div class="col-toolbar" id="col-toolbar">
  {% comment %} Row 1: the two drawer triggers {% endcomment %}
  <div class="col-toolbar__tabs">
    <button type="button" class="col-toolbar__tab" data-open-filter-drawer="filters">
      <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="6" x2="20" y2="6"/><line x1="7" y1="12" x2="17" y2="12"/><line x1="10" y1="18" x2="14" y2="18"/></svg>
      FILTER
    </button>
    <button type="button" class="col-toolbar__tab" data-open-filter-drawer="featured">
      <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M6 12h12M10 18h4"/></svg>
      FEATURED
    </button>
  </div>

  {% comment %}
    Row 2: sizes. One line on phones with EVERY size present - the row scrolls
    sideways instead of hiding the tail behind a "+N", so no size is a tap
    away from being discovered.
  {% endcomment %}
  {% if size_filter != blank %}
    <div class="col-toolbar__sizes" data-size-row>
      <a href="{{ size_filter.url_to_remove | default: collection.url }}" class="size-pill{% if size_filter.active_values.size == 0 %} is-active{% endif %}">ALL</a>
      {% for value in size_filter.values %}
        {% assign v_num = value.label | times: 1 %}
        {% if v_num > 0 %}
          <a href="{% if value.active %}{{ value.url_to_remove }}{% else %}{{ value.url_to_add }}{% endif %}"
             class="size-pill{% if value.active %} is-active{% endif %}">{{ value.label }}</a>
        {% endif %}
      {% endfor %}
    </div>
  {% elsif size_tags.size > 0 %}
    {% comment %} Tier 2: real filtering via Shopify's built-in tag routes. {% endcomment %}
    <div class="col-toolbar__sizes" data-size-row data-size-tag-mode>
      <a href="{{ size_base_url }}" class="size-pill{% if active_size_tag == '' %} is-active{% endif %}">ALL</a>
      {% for t in size_tags %}
        <a href="{% if t == active_size_tag %}{{ size_base_url }}{% else %}{{ size_base_url }}/{{ t | handleize }}{% endif %}"
           class="size-pill{% if t == active_size_tag %} is-active{% endif %}">{{ t | remove_first: 'size-' | upcase }}</a>
      {% endfor %}
    </div>
  {% elsif section.settings.size_list != blank %}
    {% comment %} Tier 3: placeholders until either of the above exists. {% endcomment %}
    {% assign fallback_sizes = section.settings.size_list | split: ',' %}
    {% assign active_size = '' %}
    {% for f in collection.filters %}
      {% assign f_label_down = f.label | downcase %}
      {% if f_label_down contains 'size' %}{% assign active_size = f.active_values.first.value %}{% endif %}
    {% endfor %}
    <div class="col-toolbar__sizes" data-size-row>
      <a href="{{ collection.url }}" class="size-pill{% if active_size == '' %} is-active{% endif %}">ALL</a>
      {% for s in fallback_sizes %}
        {% assign s_clean = s | strip %}
        {% assign s_num = s_clean | times: 1 %}
        {% if s_num > 0 %}
          <a href="{{ collection.url }}?filter.v.option.size={{ s_clean | url_encode }}" class="size-pill{% if active_size == s_clean %} is-active{% endif %}">{{ s_clean }}</a>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}

  {% comment %} Row 3: shortcuts that open the same Filter drawer, jumped to that group {% endcomment %}
  <div class="col-toolbar__subtabs">
    <button type="button" class="col-toolbar__subtab" data-open-filter-drawer="filters" data-jump-group="sleeve">SLEEVE</button>
    <button type="button" class="col-toolbar__subtab" data-open-filter-drawer="filters" data-jump-group="neckline">NECKLINE</button>
    <button type="button" class="col-toolbar__subtab" data-open-filter-drawer="filters" data-jump-group="color">COLOR</button>
    <button type="button" class="col-toolbar__subtab" data-open-filter-drawer="filters" data-jump-group="fabric">FABRIC</button>
  </div>
</div>

{% comment %}
  Right-side filter drawer, same interaction pattern as the cart/wishlist drawers
  (overlay, close X, click-outside, body.vamas-drawer-open which also hides the
  sticky header / bottom nav / WhatsApp fab so nothing floats over the panel).
{% endcomment %}
<div class="col-filter-drawer" id="col-filter-drawer" aria-hidden="true">
  <div class="col-filter-drawer__overlay" id="col-filter-drawer-overlay"></div>
  <div class="col-filter-drawer__panel" role="dialog" aria-label="Filter and sort">
    <div class="col-filter-drawer__head">
      <span class="col-filter-drawer__title">FILTER &amp; SORT</span>
      <button class="col-filter-drawer__close" id="col-filter-drawer-close" type="button" aria-label="Close">&times;</button>
    </div>

    <div class="col-filter-drawer__tabs">
      <button type="button" class="col-filter-drawer__tab is-active" data-drawer-tab="filters">FILTER</button>
      <button type="button" class="col-filter-drawer__tab" data-drawer-tab="featured">FEATURED</button>
    </div>

    <div class="col-filter-drawer__body">
      <div class="col-filter-drawer__panel-inner is-active" data-drawer-panel="filters">
        <form method="get" id="toolbar-filter-form">
          {% if collection.sort_by != blank %}<input type="hidden" name="sort_by" value="{{ collection.sort_by }}">{% endif %}

          <div class="acc-item" data-filter-group="sleeve">
            <div class="acc-head open" onclick="toggleAcc(this)"><span>SLEEVE</span><span class="acc-arrow">&#9660;</span></div>
            <div class="acc-body open">
              {% render 'vamas-filter-group-options', native_filter: sleeve_filter, tag_list: section.settings.sleeve_tag_list, current_tags: collection.current_tags, empty_note: 'Sleeve filter not set up yet.' %}
            </div>
          </div>

          <div class="acc-item" data-filter-group="neckline">
            <div class="acc-head open" onclick="toggleAcc(this)"><span>NECKLINE</span><span class="acc-arrow">&#9660;</span></div>
            <div class="acc-body open">
              {% render 'vamas-filter-group-options', native_filter: neckline_filter, tag_list: section.settings.neckline_tag_list, current_tags: collection.current_tags, empty_note: 'Neckline filter not set up yet.' %}
            </div>
          </div>

          <div class="acc-item" data-filter-group="color">
            <div class="acc-head open" onclick="toggleAcc(this)"><span>COLOR</span><span class="acc-arrow">&#9660;</span></div>
            <div class="acc-body open">
              {% render 'vamas-color-filter-dots', color_filter: color_filter, current_tags: collection.current_tags %}
            </div>
          </div>

          <div class="acc-item" data-filter-group="fabric">
            <div class="acc-head open" onclick="toggleAcc(this)"><span>FABRIC</span><span class="acc-arrow">&#9660;</span></div>
            <div class="acc-body open">
              {% assign vtag_fabric = "Silk,Cotton,Velvet,Georgette,Banarasi" | split: "," %}
              {% for t in vtag_fabric %}
                <label class="filter-check-row"><input type="checkbox" class="vtag-filter" value="{{ t }}" {% if collection.current_tags contains t %}checked{% endif %}> {{ t }}</label>
              {% endfor %}
            </div>
          </div>

          {% for filter in collection.filters %}
            {% if filter.type != 'price_range' %}{% continue %}{% endif %}
            <div class="acc-item" data-filter-group="price">
              <div class="acc-head open" onclick="toggleAcc(this)"><span>{{ filter.label | upcase }}</span><span class="acc-arrow">&#9660;</span></div>
              <div class="acc-body open">
                <div class="price-range">
                  <div class="price-labels">
                    <span id="priceMinT">{{ filter.min_value.value | default: filter.range_min | money | replace: 'Rs. ', '₹' }}</span>
                    <span id="priceMaxT">{{ filter.max_value.value | default: filter.range_max | money | replace: 'Rs. ', '₹' }}</span>
                  </div>
                  <div class="price-slider" id="priceSliderT">
                    <div class="price-slider__track"></div>
                    <div class="price-slider__fill" id="priceFillT"></div>
                    <input type="range" class="price-slider__input" id="rangeMinT" name="{{ filter.min_value.param_name }}" min="{{ filter.range_min | divided_by: 100 }}" max="{{ filter.range_max | divided_by: 100 }}" value="{{ filter.min_value.value | default: filter.range_min | divided_by: 100 }}">
                    <input type="range" class="price-slider__input" id="rangeMaxT" name="{{ filter.max_value.param_name }}" min="{{ filter.range_min | divided_by: 100 }}" max="{{ filter.range_max | divided_by: 100 }}" value="{{ filter.max_value.value | default: filter.range_max | divided_by: 100 }}">
                  </div>
                </div>
              </div>
            </div>
          {% endfor %}

          <div class="acc-item" data-filter-group="availability">
            <div class="acc-head open" onclick="toggleAcc(this)"><span>AVAILABILITY</span><span class="acc-arrow">&#9660;</span></div>
            <div class="acc-body open">
              {% if availability_filter != blank %}
                {% for value in availability_filter.values %}
                  <label class="filter-check-row"><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}> {{ value.label }} ({{ value.count }})</label>
                {% endfor %}
              {% else %}
                <p class="filter-empty-note">Availability filter not set up yet.</p>
              {% endif %}
            </div>
          </div>

          <div class="acc-item" data-filter-group="occasion">
            <div class="acc-head open" onclick="toggleAcc(this)"><span>OCCASION</span><span class="acc-arrow">&#9660;</span></div>
            <div class="acc-body open">
              {% assign vtag_occasion = "Bridal,Festive,Casual,Party Wear" | split: "," %}
              {% for t in vtag_occasion %}
                <label class="filter-check-row"><input type="checkbox" class="vtag-filter" value="{{ t }}" {% if collection.current_tags contains t %}checked{% endif %}> {{ t }}</label>
              {% endfor %}
            </div>
          </div>
        </form>
      </div>

      <div class="col-filter-drawer__panel-inner" data-drawer-panel="featured">
        <form method="get" id="toolbar-sort-form">
          {% for filter in collection.filters %}
            {% for value in filter.active_values %}<input type="hidden" name="{{ value.param_name }}" value="{{ value.value }}">{% endfor %}
            {% if filter.min_value.value %}<input type="hidden" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value }}">{% endif %}
            {% if filter.max_value.value %}<input type="hidden" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value }}">{% endif %}
          {% endfor %}
          {% for option in collection.sort_options %}
            <label class="filter-check-row">
              <input type="radio" name="sort_by" value="{{ option.value }}" {% if option.value == collection.sort_by %}checked{% endif %}> {{ option.name }}
            </label>
          {% endfor %}
        </form>
      </div>
    </div>

    <div class="col-filter-drawer__footer">
      <a href="/collections/{{ collection.handle | default: 'all' }}" class="btn-outline col-filter-drawer__clear">CLEAR ALL</a>
      <button type="button" class="btn-primary col-filter-drawer__apply" id="vtag-apply-toolbar">APPLY</button>
    </div>
  </div>
</div>

<div class="col-body">

  <aside class="sidebar" id="sidebar">
    <div class="sidebar-head">
      <h3>FILTERS</h3>
      <a href="/collections/{{ collection.handle | default: 'all' }}" class="clear-all">Clear All</a>
    </div>

    {% comment %} Desktop sizes: a single line that fits as many pills as the sidebar
      allows, with a "+N" pill for the rest. How many actually fit depends on the
      rendered width, so the trimming is measured in JS rather than guessed here. {% endcomment %}
    {% if size_filter != blank %}
      <div class="sidebar-sizes" data-size-fit>
        <a href="{{ size_filter.url_to_remove | default: collection.url }}" class="size-pill{% if size_filter.active_values.size == 0 %} is-active{% endif %}">ALL</a>
        {% for value in size_filter.values %}
          {% assign v_num = value.label | times: 1 %}
          {% if v_num > 0 %}
            <a href="{% if value.active %}{{ value.url_to_remove }}{% else %}{{ value.url_to_add }}{% endif %}" class="size-pill{% if value.active %} is-active{% endif %}">{{ value.label }}</a>
          {% endif %}
        {% endfor %}
        <button type="button" class="size-pill size-pill--more" data-size-fit-more hidden>+0</button>
      </div>
    {% elsif size_tags.size > 0 %}
      <div class="sidebar-sizes" data-size-fit data-size-tag-mode>
        <a href="{{ size_base_url }}" class="size-pill{% if active_size_tag == '' %} is-active{% endif %}">ALL</a>
        {% for t in size_tags %}
          <a href="{% if t == active_size_tag %}{{ size_base_url }}{% else %}{{ size_base_url }}/{{ t | handleize }}{% endif %}"
             class="size-pill{% if t == active_size_tag %} is-active{% endif %}">{{ t | remove_first: 'size-' | upcase }}</a>
        {% endfor %}
        <button type="button" class="size-pill size-pill--more" data-size-fit-more hidden>+0</button>
      </div>
    {% elsif section.settings.size_list != blank %}
      {% assign sb_sizes = section.settings.size_list | split: ',' %}
      <div class="sidebar-sizes" data-size-fit>
        <a href="{{ collection.url }}" class="size-pill">ALL</a>
        {% for s in sb_sizes %}
          {% assign s_clean = s | strip %}
          {% assign s_num = s_clean | times: 1 %}
          {% if s_num > 0 %}
            <a href="{{ collection.url }}?filter.v.option.size={{ s_clean | url_encode }}" class="size-pill">{{ s_clean }}</a>
          {% endif %}
        {% endfor %}
        <button type="button" class="size-pill size-pill--more" data-size-fit-more hidden>+0</button>
      </div>
    {% endif %}

    <div class="sidebar-scroll">
    {% comment %} Fixed filter order: Sleeve, Neckline, Color, Fabric, Price, Availability, Occasion {% endcomment %}
    {% assign vtag_occasion = "Bridal,Festive,Casual,Party Wear" | split: "," %}
    {% assign vtag_fabric = "Silk,Cotton,Velvet,Georgette,Banarasi" | split: "," %}

    <div class="acc-item">
      <div class="acc-head open" onclick="toggleAcc(this)"><span>SLEEVE</span><span class="acc-arrow">&#9660;</span></div>
      <div class="acc-body open">
        {% render 'vamas-filter-group-options', native_filter: sleeve_filter, tag_list: section.settings.sleeve_tag_list, current_tags: collection.current_tags, empty_note: 'Sleeve filter not set up yet.' %}
      </div>
    </div>

    <div class="acc-item">
      <div class="acc-head open" onclick="toggleAcc(this)"><span>NECKLINE</span><span class="acc-arrow">&#9660;</span></div>
      <div class="acc-body open">
        {% render 'vamas-filter-group-options', native_filter: neckline_filter, tag_list: section.settings.neckline_tag_list, current_tags: collection.current_tags, empty_note: 'Neckline filter not set up yet.' %}
      </div>
    </div>

    <div class="acc-item">
      <div class="acc-head open" onclick="toggleAcc(this)"><span>COLOR</span><span class="acc-arrow">&#9660;</span></div>
      <div class="acc-body open">
        {% render 'vamas-color-filter-dots', color_filter: color_filter, current_tags: collection.current_tags %}
      </div>
    </div>

    <div class="acc-item">
      <div class="acc-head open" onclick="toggleAcc(this)"><span>FABRIC</span><span class="acc-arrow">&#9660;</span></div>
      <div class="acc-body open">
        {% for t in vtag_fabric %}
          <label class="filter-check-row"><input type="checkbox" class="vtag-filter" value="{{ t }}" {% if collection.current_tags contains t %}checked{% endif %}> {{ t }}</label>
        {% endfor %}
      </div>
    </div>

    <form method="get">
    {% if collection.sort_by != blank %}<input type="hidden" name="sort_by" value="{{ collection.sort_by }}">{% endif %}

    {% for filter in collection.filters %}
      {% if filter.type != 'price_range' %}{% continue %}{% endif %}
      <div class="acc-item">
        <div class="acc-head open" onclick="toggleAcc(this)">
          <span>{{ filter.label | upcase }}</span>
          <span class="acc-arrow">&#9660;</span>
        </div>
        <div class="acc-body open">
          <div class="price-range">
            <div class="price-labels">
              <span id="priceMin">{{ filter.min_value.value | default: filter.range_min | money | replace: 'Rs. ', '₹' }}</span>
              <span id="priceMax">{{ filter.max_value.value | default: filter.range_max | money | replace: 'Rs. ', '₹' }}</span>
            </div>
            <div class="price-slider" id="priceSlider">
              <div class="price-slider__track"></div>
              <div class="price-slider__fill" id="priceFill"></div>
              <input type="range" class="price-slider__input" id="rangeMin" name="{{ filter.min_value.param_name }}" min="{{ filter.range_min | divided_by: 100 }}" max="{{ filter.range_max | divided_by: 100 }}" value="{{ filter.min_value.value | default: filter.range_min | divided_by: 100 }}">
              <input type="range" class="price-slider__input" id="rangeMax" name="{{ filter.max_value.param_name }}" min="{{ filter.range_min | divided_by: 100 }}" max="{{ filter.range_max | divided_by: 100 }}" value="{{ filter.max_value.value | default: filter.range_max | divided_by: 100 }}">
            </div>
          </div>
        </div>
      </div>
    {% endfor %}

    <div class="acc-item">
      <div class="acc-head open" onclick="toggleAcc(this)"><span>AVAILABILITY</span><span class="acc-arrow">&#9660;</span></div>
      <div class="acc-body open">
        {% if availability_filter != blank %}
          {% for value in availability_filter.values %}
            <label class="filter-check-row"><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}> {{ value.label }} ({{ value.count }})</label>
          {% endfor %}
        {% else %}
          <p class="filter-empty-note">Availability filter not set up yet.</p>
        {% endif %}
      </div>
    </div>
    </form>

    <div class="acc-item">
      <div class="acc-head open" onclick="toggleAcc(this)"><span>OCCASION</span><span class="acc-arrow">&#9660;</span></div>
      <div class="acc-body open">
        {% for t in vtag_occasion %}
          <label class="filter-check-row"><input type="checkbox" class="vtag-filter" value="{{ t }}" {% if collection.current_tags contains t %}checked{% endif %}> {{ t }}</label>
        {% endfor %}
      </div>
    </div>
    </div>

    <div class="sidebar-apply">
      <button type="button" class="btn-primary" style="width:100%;" id="vtag-apply">APPLY FILTERS</button>
    </div>
  </aside>

  <div class="prod-area">
    {% paginate collection.products by section.settings.products_per_page %}
    <div class="prod-topbar">
      <div class="prod-count">Showing <strong>{{ paginate.current_offset | plus: 1 }}-{{ paginate.current_offset | plus: collection.products.size }}</strong> of <strong>{{ collection.products_count }}</strong> products</div>
      <div class="sort-wrap">
        <span class="sort-label">SORT BY</span>
        <form method="get">
        {% for filter in collection.filters %}
          {% for value in filter.active_values %}<input type="hidden" name="{{ value.param_name }}" value="{{ value.value }}">{% endfor %}
          {% if filter.min_value.value %}<input type="hidden" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value }}">{% endif %}
          {% if filter.max_value.value %}<input type="hidden" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value }}">{% endif %}
        {% endfor %}
        <select class="sort-sel" name="sort_by" onchange="this.form.submit()">
          {% for option in collection.sort_options %}
            <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>{{ option.name }}</option>
          {% endfor %}
        </select>
        </form>
      </div>
    </div>

    {% if collection.filters.size > 0 %}
    <div class="filter-chips" id="chip-container">
      {% for filter in collection.filters %}
        {% for value in filter.values %}
          {% if value.active %}
            <a href="{{ value.url_to_remove }}" class="f-chip">{{ value.label }}<span class="x"></span></a>
          {% endif %}
        {% endfor %}
      {% endfor %}
    </div>
    {% endif %}

    <div class="prod-grid">
      {% for product in collection.products %}
        {% render 'vamas-product-card', product: product %}
      {% else %}
        <p>No products found in this collection.</p>
      {% endfor %}
    </div>

    {% if paginate.pages > 1 %}
    <div class="pagination">
      {% if paginate.previous %}<a href="{{ paginate.previous.url }}" class="page-btn">&#8592; Previous</a>{% else %}<span class="page-btn disabled">&#8592; Previous</span>{% endif %}
      {% for part in paginate.parts %}
        {% if part.is_link %}<a href="{{ part.url }}" class="page-btn">{{ part.title }}</a>{% else %}<span class="page-btn{% if part.title == paginate.current_page %} active{% endif %}">{{ part.title }}</span>{% endif %}
      {% endfor %}
      {% if paginate.next %}<a href="{{ paginate.next.url }}" class="page-btn">Next &#8594;</a>{% else %}<span class="page-btn disabled">Next &#8594;</span>{% endif %}
    </div>
    {% endif %}
    {% endpaginate %}
  </div>
</div>

<script>
function toggleAcc(head){
  head.classList.toggle('open');
  var body = head.nextElementSibling;
  body.classList.toggle('open');
}

/* Stick the toolbar right below the site's own sticky header (also
   position:sticky/top:0), instead of overlapping it. Only the header
   wrapper's own height matters here - the announcement bar above it isn't
   sticky, so it's already scrolled out of view by the time the toolbar's
   stickiness engages (it sits well below the header in the page). */
(function(){
  var toolbar = document.getElementById('col-toolbar');
  if (!toolbar) return;
  function setOffset(){
    var headerEl = document.getElementById('vamas-nav-wrapper');
    toolbar.style.setProperty('--vamas-header-h', (headerEl ? headerEl.offsetHeight : 0) + 'px');
  }
  setOffset();
  window.addEventListener('resize', setOffset);
  window.addEventListener('orientationchange', setOffset);
})();

/* Filter/Featured drawer — same interaction model as the cart & wishlist drawers */
(function(){
  var drawer = document.getElementById('col-filter-drawer');
  if (!drawer) return;
  var overlay = document.getElementById('col-filter-drawer-overlay');
  var closeBtn = document.getElementById('col-filter-drawer-close');
  var tabs = drawer.querySelectorAll('.col-filter-drawer__tab');
  var panels = drawer.querySelectorAll('.col-filter-drawer__panel-inner');
  var body = drawer.querySelector('.col-filter-drawer__body');

  function showTab(name){
    tabs.forEach(function(t){ t.classList.toggle('is-active', t.getAttribute('data-drawer-tab') === name); });
    panels.forEach(function(p){ p.classList.toggle('is-active', p.getAttribute('data-drawer-panel') === name); });
  }

  function openDrawer(tabName, jumpGroup){
    showTab(tabName || 'filters');
    drawer.classList.add('open');
    drawer.setAttribute('aria-hidden', 'false');
    document.body.classList.add('vamas-drawer-open', 'col-filter-drawer-lock');
    if (jumpGroup) {
      var group = drawer.querySelector('[data-filter-group="' + jumpGroup + '"]');
      if (group) {
        /* make sure the group the shopper asked for is expanded, then bring it into view */
        var head = group.querySelector('.acc-head');
        var accBody = group.querySelector('.acc-body');
        if (head && accBody && !head.classList.contains('open')) {
          head.classList.add('open');
          accBody.classList.add('open');
        }
        setTimeout(function(){
          if (body) body.scrollTop = group.offsetTop - body.offsetTop;
        }, 30);
      }
    }
  }
  function closeDrawer(){
    drawer.classList.remove('open');
    drawer.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('vamas-drawer-open', 'col-filter-drawer-lock');
  }

  tabs.forEach(function(tab){
    tab.addEventListener('click', function(){ showTab(tab.getAttribute('data-drawer-tab')); });
  });
  overlay.addEventListener('click', closeDrawer);
  closeBtn.addEventListener('click', closeDrawer);
  document.addEventListener('keydown', function(e){ if (e.key === 'Escape') closeDrawer(); });

  /* Row 1 (FILTER / FEATURED) and Row 3 (SLEEVE / NECKLINE / COLOR / FABRIC) all
     open this same drawer; row 3 additionally jumps to its own filter group. */
  document.querySelectorAll('[data-open-filter-drawer]').forEach(function(btn){
    btn.addEventListener('click', function(){
      openDrawer(btn.getAttribute('data-open-filter-drawer'), btn.getAttribute('data-jump-group'));
    });
  });

  window.VamasFilterDrawer = { open: openDrawer, close: closeDrawer };
})();

/* 1-up / 2-up grid toggle */
(function(){
  var grid = document.querySelector('.prod-grid');
  if (!grid) return;
  document.querySelectorAll('.col-mhead__view').forEach(function(btn){
    btn.addEventListener('click', function(){
      document.querySelectorAll('.col-mhead__view').forEach(function(b){ b.classList.remove('is-active'); });
      btn.classList.add('is-active');
      grid.classList.toggle('prod-grid--one', btn.getAttribute('data-cols') === '1');
    });
  });
})();

/* Mobile size row is one scrolling line with every size in it, so the active
   pill is brought into view rather than left off-screen behind a swipe. */
(function(){
  var row = document.querySelector('[data-size-row]');
  if (!row) return;
  var active = row.querySelector('.size-pill.is-active');
  if (active && active !== row.firstElementChild) {
    row.scrollLeft = active.offsetLeft - (row.clientWidth - active.offsetWidth) / 2;
  }
})();

/* Tag-mode size pills navigate to a tag PATH (/collections/x/size-46), which on
   its own would drop any filter.* query params the shopper already has active
   (colour, price). Liquid can't read the query string, so re-attach it here. */
(function(){
  var rows = document.querySelectorAll('[data-size-tag-mode]');
  if (!rows.length || !location.search) return;
  var keep = [];
  new URLSearchParams(location.search).forEach(function(v, k){
    if (k.indexOf('filter.') === 0) keep.push(encodeURIComponent(k) + '=' + encodeURIComponent(v));
  });
  if (!keep.length) return;
  var qs = '?' + keep.join('&');
  Array.prototype.forEach.call(rows, function(row){
    Array.prototype.forEach.call(row.querySelectorAll('a.size-pill'), function(a){
      if (a.getAttribute('href').indexOf('?') === -1) a.setAttribute('href', a.getAttribute('href') + qs);
    });
  });
})();

/* Desktop sidebar sizes: keep them on ONE line, showing however many actually
   fit, and roll the rest into a "+N" pill. The count can't be decided in Liquid
   because it depends on rendered pill widths, so measure after layout. */
(function(){
  var row = document.querySelector('[data-size-fit]');
  if (!row) return;
  var more = row.querySelector('[data-size-fit-more]');
  if (!more) return;
  var pills = Array.prototype.slice.call(row.querySelectorAll('.size-pill:not([data-size-fit-more])'));
  var expanded = false;

  function fit(){
    if (expanded) return;
    pills.forEach(function(p){ p.hidden = false; });
    more.hidden = true;
    var rowTop = pills.length ? pills[0].getBoundingClientRect().top : 0;
    /* Anything that wrapped onto a second line sits lower than the first pill. */
    var overflow = pills.filter(function(p){ return p.getBoundingClientRect().top > rowTop + 2; });
    if (!overflow.length) return;
    more.hidden = false;
    /* Showing "+N" itself takes room, so hide one extra pill if it now wraps.
       The label has to be written BEFORE each measurement: "+12" is wider than
       "+0", so measuring against the placeholder fits a pill that the real
       label then pushes onto a second line. */
    for (var guard = 0; guard < pills.length; guard++) {
      more.textContent = '+' + pills.filter(function(p){ return p.hidden; }).length;
      var stillOver = pills.filter(function(p){ return !p.hidden && p.getBoundingClientRect().top > rowTop + 2; });
      var moreWrapped = more.getBoundingClientRect().top > rowTop + 2;
      if (!stillOver.length && !moreWrapped) break;
      for (var i = pills.length - 1; i >= 0; i--) { if (!pills[i].hidden) { pills[i].hidden = true; break; } }
    }
    more.textContent = '+' + pills.filter(function(p){ return p.hidden; }).length;
  }

  more.addEventListener('click', function(){
    expanded = true;
    pills.forEach(function(p){ p.hidden = false; });
    more.hidden = true;
  });

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fit);
  else fit();
  window.addEventListener('load', fit);
  window.addEventListener('resize', fit);
})();
/* Nothing in the filter panels navigates on its own any more - a shopper ticks
   whatever they want across FILTER and FEATURED, then APPLY sends the lot in a
   single request. The button therefore has to rebuild the WHOLE query, not just
   the tag checkboxes it used to read: native filter checkboxes, colour dots,
   the sort radio and the price sliders all live here now. */
function wireVtagApply(id, scopeSelector){
  var apply = document.getElementById(id);
  if(!apply) return;
  var scope = scopeSelector ? document.querySelector(scopeSelector) : document;
  if(!scope) return;

  apply.addEventListener('click', function(){
    var params = [];
    var tags = [];

    /* Ticked boxes and the chosen sort. Hidden inputs are skipped on purpose:
       they only mirror the state these controls already carry, so reading both
       would send every active filter twice. */
    scope.querySelectorAll('input[type="checkbox"]:checked, input[type="radio"]:checked').forEach(function(el){
      if (el.classList.contains('vtag-filter')) {
        tags.push(el.value.trim().toLowerCase().replace(/\s+/g, '-'));
      } else if (el.name) {
        params.push(encodeURIComponent(el.name) + '=' + encodeURIComponent(el.value));
      }
    });

    /* Price only counts as a filter once it has been moved off the full range,
       otherwise every APPLY would pin a price band the shopper never chose. */
    scope.querySelectorAll('input[type="range"][name]').forEach(function(el){
      var isMin = el.id.indexOf('rangeMin') === 0;
      var untouched = isMin ? (el.value === el.min) : (el.value === el.max);
      if (!untouched) params.push(encodeURIComponent(el.name) + '=' + encodeURIComponent(el.value));
    });

    var url = '/collections/{{ collection.handle | default: "all" }}';
    if (tags.length) url += '/' + tags.join('+');
    if (params.length) url += '?' + params.join('&');
    window.location.href = url;
  });
}
wireVtagApply('vtag-apply', '#sidebar');
wireVtagApply('vtag-apply-toolbar', '#col-filter-drawer');

/* The native colour dots hide their checkbox behind a coloured span, so with
   auto-submit gone nothing showed a pick until the page reloaded. Reflect it. */
document.querySelectorAll('.color-dot-input').forEach(function(cb){
  cb.addEventListener('change', function(){
    var dot = cb.parentElement.querySelector('.c-dot');
    if (dot) dot.classList.toggle('active', cb.checked);
  });
});

function wirePriceSlider(minId, maxId, fillId, minLabelId, maxLabelId){
  var minInput = document.getElementById(minId);
  var maxInput = document.getElementById(maxId);
  var fill = document.getElementById(fillId);
  var minLabel = document.getElementById(minLabelId);
  var maxLabel = document.getElementById(maxLabelId);
  if (!minInput || !maxInput || !fill) return;

  function update(){
    var lo = parseFloat(minInput.value);
    var hi = parseFloat(maxInput.value);
    if (lo > hi) { var t = lo; lo = hi; hi = t; }
    var min = parseFloat(minInput.min);
    var max = parseFloat(minInput.max);
    var pctLo = ((lo - min) / (max - min)) * 100;
    var pctHi = ((hi - min) / (max - min)) * 100;
    fill.style.left = pctLo + '%';
    fill.style.width = (pctHi - pctLo) + '%';
    if (minLabel) minLabel.textContent = '\u20B9' + parseFloat(minInput.value).toFixed(2);
    if (maxLabel) maxLabel.textContent = '\u20B9' + parseFloat(maxInput.value).toFixed(2);
  }
  minInput.addEventListener('input', update);
  maxInput.addEventListener('input', update);
  update();
}
wirePriceSlider('rangeMin', 'rangeMax', 'priceFill', 'priceMin', 'priceMax');
wirePriceSlider('rangeMinT', 'rangeMaxT', 'priceFillT', 'priceMinT', 'priceMaxT');
</script>

{% schema %}
{
  "name": "Vamas Collection",
  "settings": [
    { "type": "range", "id": "products_per_page", "min": 4, "max": 48, "step": 4, "label": "Products Per Page", "default": 12 },
    { "type": "header", "content": "Sub-category tabs" },
    { "type": "textarea", "id": "subcat_map", "label": "Sub-collections per category", "info": "One line per category: parent-handle | child-handle, child-handle. Use collection HANDLES. A child with no collection behind it is skipped, so the list can be written before they exist.", "default": "the-plain-edit | signature-round-neck-sleeveless, silk-elbow-length, side-stretch-plains, cotton-plains, collar-necks, tissue-plains, corsets-plain\nsummer-essentials | summer-essentials-signature-round-neck-sleeveless, summer-essentials-silk-elbow-length, summer-essentials-side-stretch-plains\nbrocade-bohemia | brocade-bohemia-signature-round-neck-sleeveless, brocade-bohemia-silk-elbow-length, brocade-bohemia-side-stretch-plains\nfestive-glam | festive-glam-signature-round-neck-sleeveless, festive-glam-silk-elbow-length, festive-glam-side-stretch-plains\nre-verse-by-vamas | re-verse-by-vamas-signature-round-neck-sleeveless, re-verse-by-vamas-silk-elbow-length, re-verse-by-vamas-side-stretch-plains\nside-stretch-blouses | side-stretch-blouses-signature-round-neck-sleeveless, side-stretch-blouses-silk-elbow-length, side-stretch-blouses-side-stretch-plains\nbridgerton-inspired | bridgerton-inspired-signature-round-neck-sleeveless, bridgerton-inspired-silk-elbow-length, bridgerton-inspired-side-stretch-plains\ncorsets | corsets-signature-round-neck-sleeveless, corsets-silk-elbow-length, corsets-side-stretch-plains" },
    { "type": "text", "id": "size_list", "label": "Size Row (comma-separated)", "info": "Shown in the sticky filter bar. Used only as a last resort — a native Size filter (Search & Discovery) wins, then size-NN product tags. Neither needs this list.", "default": "32,34,36,38,40,42,44,46,48,50" },
    { "type": "header", "content": "Sleeve & Neckline" },
    { "type": "paragraph", "content": "These use a Search & Discovery filter if one exists (matched by label containing 'sleeve' / 'neck'). If not, the tag lists below are used instead — tags must match the product tags exactly." },
    { "type": "text", "id": "sleeve_tag_list", "label": "Sleeve Tags (comma-separated)", "default": "Sleeveless, Cap Sleeves, Short Sleeves, Elbow Sleeves, Three-Quarter Sleeves, Full Sleeves" },
    { "type": "text", "id": "neckline_tag_list", "label": "Neckline Tags (comma-separated)", "default": "Round Neck, V-Neck, Boat Neck, Square Neck, Sweetheart Neck, High Neck, Halter Neck" },
    { "type": "textarea", "id": "hero_subtitle", "label": "Hero Subtitle (overrides collection description)" },
    { "type": "checkbox", "id": "show_hero_motif", "label": "Show Decorative Motif", "default": true },
    { "type": "image_picker", "id": "hero_bg_image", "label": "Hero Background Image", "info": "Leave blank to keep the default background." },
    { "type": "image_picker", "id": "hero_bg_mobile", "label": "Hero Background Image (Mobile)", "info": "Shown instead of the image above on phones." }
  ],
  "presets": [{ "name": "Vamas Collection" }]
}
{% endschema %}
